// ---------------- scenes ----------------
const FL = 1260, GREEN = '#6a9a4a';
function sawWave(x0, y0, x1, y1, t, amp, a = 1, w = 9) { const n = 14, dx = x1 - x0, dy = y1 - y0, L = Math.hypot(dx, dy), nx = -dy / L, ny = dx / L, ph = (t * 3) % 1; X.save(); X.globalAlpha = a; X.lineJoin = 'miter'; for (const [col, lw] of [['#1a1410', w + 8], ['#ffd23f', w]]) { X.strokeStyle = col; X.lineWidth = lw; X.beginPath();
    for (let i = 0; i <= n * 2; i++) { const f = Math.min(1, Math.max(0, (i + ph * 2) / (n * 2))), env = Math.sin(f * Math.PI) * (0.6 + 0.4 * Math.sin(t * 8)), o = (i % 2 ? 1 : -1) * amp * env; const x = x0 + dx * f + nx * o, y = y0 + dy * f + ny * o; i ? X.lineTo(x, y) : X.moveTo(x, y); } X.stroke(); } X.restore(); }
function rrr(x, y, t, size = 84, a = 1) { X.save(); X.translate(x + Math.sin(t * 50) * 5, y + Math.cos(t * 43) * 4); X.rotate(-0.08); txt('RRRRRRRR', 0, 0, size, '#ffd23f', 'center', a); X.restore(); }
function logH(x, y, len, r, col = '#8a5a30') { rr(x, y - r, len, r * 2, r, col); X.fillStyle = '#d9b77a'; X.beginPath(); X.ellipse(x + len - r * 0.3, y, r * 0.55, r, 0, 0, 7); X.fill(); X.strokeStyle = '#b08850'; X.lineWidth = 3; X.beginPath(); X.ellipse(x + len - r * 0.3, y, r * 0.28, r * 0.5, 0, 0, 7); X.stroke(); X.strokeStyle = 'rgba(0,0,0,.2)'; X.lineWidth = 3; X.beginPath(); X.moveTo(x + r, y - r * 0.3); X.lineTo(x + len * 0.6, y - r * 0.3); X.stroke(); }
function logEnd(x, y, r) { X.fillStyle = '#8a5a30'; X.beginPath(); X.arc(x, y, r, 0, 7); X.fill(); X.fillStyle = '#d9b77a'; X.beginPath(); X.arc(x, y, r * 0.78, 0, 7); X.fill(); X.strokeStyle = '#b08850'; X.lineWidth = 3; X.beginPath(); X.arc(x, y, r * 0.45, 0, 7); X.stroke(); X.beginPath(); X.arc(x, y, r * 0.16, 0, 7); X.stroke(); }
function stack(x, y, r, n, pop = 1) { let k = 0; for (let row = 0; row < n; row++) for (let i = 0; i < n - row; i++) { const p = back(pop * (n * (n + 1) / 2) - k); k++; if (p <= 0) continue; const cx = x + (i - (n - row - 1) / 2) * r * 2.05, cy = y - r - row * r * 1.78; X.save(); X.translate(cx, cy); X.scale(p, p); logEnd(0, 0, r); X.restore(); } }
function tree(x, y, s, col = '#2f8a3e') { X.fillStyle = '#6b4a2a'; X.fillRect(x - 6 * s, y - 30 * s, 12 * s, 30 * s); X.fillStyle = col; for (const [w, h, o] of [[44, 50, 22], [34, 44, 52], [24, 36, 80]]) { X.beginPath(); X.moveTo(x - w * s, y - o * s); X.lineTo(x, y - (o + h) * s); X.lineTo(x + w * s, y - o * s); X.fill(); } }
function stump(x, y, s) { rr(x - 12 * s, y - 16 * s, 24 * s, 16 * s, 3 * s, '#6b4a2a'); X.fillStyle = '#d9b77a'; X.beginPath(); X.ellipse(x, y - 16 * s, 12 * s, 4 * s, 0, 0, 7); X.fill(); }
function earth(cx, cy, r, forest, t, sleepy = 0) { const g = X.createRadialGradient(cx - r * 0.3, cy - r * 0.3, r * 0.2, cx, cy, r); g.addColorStop(0, '#3f9ad8'); g.addColorStop(1, '#1f5f9e'); X.fillStyle = g; X.beginPath(); X.arc(cx, cy, r, 0, 7); X.fill();
  const mix = (a, b, f) => `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * f)).join(',')})`; X.fillStyle = mix([150, 120, 80], [62, 160, 76], forest); X.save(); X.beginPath(); X.arc(cx, cy, r, 0, 7); X.clip(); for (const [x, y, w, h, ro] of [[-0.35, -0.3, 0.42, 0.3, 0.4], [0.3, -0.1, 0.36, 0.5, -0.3], [-0.2, 0.45, 0.4, 0.26, 0.2], [0.55, 0.6, 0.3, 0.2, 0.5]]) { X.beginPath(); X.ellipse(cx + x * r, cy + y * r, w * r, h * r, ro, 0, 7); X.fill(); } X.restore();
  const N = 44; for (let i = 0; i < N; i++) { const an = i / N * Math.PI * 2 - Math.PI / 2, gone = ((i * 17) % N) / N >= forest; X.save(); X.translate(cx + Math.cos(an) * r, cy + Math.sin(an) * r); X.rotate(an + Math.PI / 2); if (gone) stump(0, 2, r / 300); else tree(0, 2, r / 300); X.restore(); }
  if (sleepy > 0) for (let i = 0; i < 16; i++) { const an = i / 16 * Math.PI * 2 + 0.2, ph = (t * 0.5 + i * 0.13) % 1; X.save(); X.translate(cx + Math.cos(an) * (r + 40), cy + Math.sin(an) * (r + 40)); X.fillStyle = SKIN; X.globalAlpha = sleepy; X.beginPath(); X.arc(0, 0, 16 * r / 300, 0, 7); X.fill(); X.restore(); txt('z', cx + Math.cos(an) * (r + 70 + ph * 50), cy + Math.sin(an) * (r + 70 + ph * 50), 34, '#dfe6ff', 'center', sleepy * Math.sin(ph * Math.PI)); } }
function tophat(x, y, s) { rr(x - 34 * s, y - 126 * s, 68 * s, 8 * s, 3, '#15171c'); rr(x - 22 * s, y - 176 * s, 44 * s, 52 * s, 4, '#15171c'); rr(x - 22 * s, y - 140 * s, 44 * s, 8 * s, 0, '#d42d2d'); }
function cabin(x, y, s) { X.save(); X.translate(x, y); X.scale(s, s); X.fillStyle = '#5e3528'; X.beginPath(); X.moveTo(-190, -200); X.lineTo(0, -330); X.lineTo(190, -200); X.fill(); for (let q = 0; q < 6; q++) rr(-160, -200 + q * 34, 320, 30, 14, q % 2 ? '#9a6a3a' : '#8a5a30'); rr(-40, -120, 80, 124, 6, '#5a3d27'); windowPane(70, -150, 60, 60, '#ffe9a0'); rr(100, -310, 40, 80, 4, '#7a4636'); X.restore(); }
function bedroom(t, opts = {}) { wall(opts.day ? '#f3d9a8' : '#2b2f55', opts.day ? '#f7e7c6' : '#4a3f6b', FL, opts.day ? '#b98a5a' : '#3a2f3f'); windowPane(430, 520, 220, 260, opts.day ? '#9fd8ff' : '#141a36'); if (!opts.day) { X.fillStyle = '#eef0f4'; X.beginPath(); X.arc(590, 590, 30, 0, 7); X.fill(); }
  bed(40, FL, 0.95, t, opts.you || { awake: true }); bed(600, FL, 0.95, t, Object.assign({ blanket: GREEN, shirt: GREEN, snore: true }, opts.mate || {})); rr(482, FL - 110, 96, 110, 8, '#6b4a30'); clock(530, FL - 110, 0.55, false, t, false, opts.day ? '7:00' : '3:00'); }
const SC = {
  c_hook(t, u) { bedroom(t); sawWave(690, FL - 190, 250, FL - 430, t, 46); sawWave(720, FL - 200, 980, FL - 520, t, 40); rrr(830, 470, t, 80); },
  c_log(t, u) { bedroom(t, { you: { empty: true } }); sawWave(700, FL - 200, 900, FL - 470, t, 30, 0.8, 7); const m = sm(u / 0.5), x = lerp(120, 520, m), sl = sm((u - 0.55) / 0.3);
    if (sl < 1) { person(x, FL - 74 - Math.abs(Math.sin(t * 6)) * 10, 1.15, 'hands', t); logH(x - 110 + sl * 260, FL - 230 + sl * 60, 220, 30); } else person(520, FL - 74, 1.15, 'breath', t);
    if (sl > 0.3) { X.save(); X.beginPath(); X.rect(700, FL - 260, 330, 120); X.clip(); logH(700 + (1 - sl) * -120 + 20, FL - 168, 260, 28); X.restore(); rr(712, FL - 152, 302, 26, 12, GREEN); }
    label('CERTIFIED GENIUS', x, FL - 215, 600, FL - 395, cl((u - 0.15) / 0.1) * (sl < 0.2 ? 1 : 0)); },
  c_morn(t, u) { bedroom(t, { day: true, you: { empty: true } }); const e = t - ev('stack'); stack(820, FL - 160, 34, 4, cl(e / 0.35 + 0.001) * (e >= 0 ? 1 : 0)); if (e >= 0) for (let q = 0; q < 14; q++) { const ph = cl(e * 1.6 - q * 0.02); X.fillStyle = `rgba(217,183,122,${1 - ph})`; X.beginPath(); X.arc(820 + Math.cos(q * 2.4) * ph * 260, FL - 300 + Math.sin(q * 2.4) * ph * 160 + ph * ph * 120, 7, 0, 7); X.fill(); }
    person(300, FL - 74, 1.15, e > 0 ? 'hands' : 'breath', t); const p = wordT('c_morn', 'perfectly'); stamp('PERFECT', 800, FL - 480, -0.1, cl((t - p) / 0.25), '#2a8a3e', 80); },
  c_hold(t, u) { sky('#3a2f55', '#6a4f7b'); const g = X.createRadialGradient(540, 1050, 60, 540, 1050, 700); g.addColorStop(0, 'rgba(255,220,120,.55)'); g.addColorStop(1, 'rgba(255,220,120,0)'); X.fillStyle = g; X.fillRect(0, 0, W, H); for (let q = 0; q < 12; q++) { X.save(); X.translate(540, 1050); X.rotate(q / 12 * Math.PI * 2 + t * 0.4); X.fillStyle = 'rgba(255,230,150,.12)'; X.beginPath(); X.moveTo(0, 0); X.lineTo(-60, -900); X.lineTo(60, -900); X.fill(); X.restore(); }
    const z = 1 + 0.06 * sm(u); X.save(); X.translate(540, 1300); X.scale(z, z); stack(0, 0, 78, 4, 1); X.restore(); for (let q = 0; q < 5; q++) { const an = t * 1.5 + q * 1.3; txt('✦', 540 + Math.cos(an) * 400, 1000 + Math.sin(an) * 330, 64, '#fff3b0'); }
    const p = wordT('c_hold', 'good'), a = back((t - p) / 0.2); if (a > 0) { X.save(); X.translate(820, 760); X.rotate(0.15 + Math.sin(t * 3) * 0.05); X.scale(a, a); rr(-110, -60, 220, 120, 16, '#fff'); X.fillStyle = '#2a8a3e'; X.font = '84px P'; X.textAlign = 'center'; X.fillText('$20', 0, 30); X.restore(); } },
  c_sell(t, u) { sky('#7cc4ec', '#cfeaf7'); X.fillStyle = '#4f9b3f'; X.fillRect(0, 1400, W, 520); rr(250, 1100, 580, 30, 6, '#8a6a44'); rr(270, 1130, 22, 270, 0, '#6b4a30'); rr(788, 1130, 22, 270, 0, '#6b4a30'); rr(250, 800, 580, 150, 14, '#fff'); X.strokeStyle = '#8a6a44'; X.lineWidth = 10; X.strokeRect(250, 800, 580, 150); X.fillStyle = '#5a3d27'; X.font = '74px P'; X.textAlign = 'center'; X.fillText('FIREWOOD $20', 540, 902); rr(270, 950, 14, 150, 0, '#6b4a30'); rr(796, 950, 14, 150, 0, '#6b4a30');
    const e = t - ev('sold'); if (e < 0) stack(540, 1100, 30, 3, 1); person(400, 1326, 1.15, e > 0 ? 'hands' : 'breath', t); const cx = lerp(1200, 760, sm(u / 0.5)); person(e > 0.15 ? cx + (e - 0.15) * 700 : cx, 1326, 1.15, 'stand', t * 2, 1, '#c0563a'); if (e > 0) { for (let q = 0; q < 6; q++) { const ph = cl(e * 1.4 - q * 0.05); txt('$', 540 + (q - 2.5) * 70, 1080 - ph * 300, 80, '#3ad06a', 'center', 1 - ph); } stamp('SOLD', 540, 1060, -0.1, cl(e / 0.25), '#e02424', 110); } },
  c_ten(t, u) { const tt = ev('tree'), e = t - tt; bedroom(t, { you: { empty: true } }); const n = e < 0 ? Math.floor(cl(u / 0.3) * 10 + 0.001) : 10; let k = 0; for (let row = 0; row < 4 && k < n; row++) for (let i = 0; i < 4 - row && k < n; i++, k++) logEnd(760 + (i - (3 - row) / 2) * 62 + 60, FL - 190 - row * 52, 30); if (e < 0 && u > 0.05) txt('x' + n, 560, FL - 330, 90, '#ffd23f');
    if (e >= 0) { const m = cl(e / 0.9), tx = lerp(-900, 500, m * m); X.save(); X.beginPath(); X.rect(0, 0, 780, H); X.clip(); rr(tx, FL - 480, 900, 90, 44, '#8a5a30'); X.fillStyle = '#2f8a3e'; for (const [dx, r] of [[-60, 110], [40, 130], [-10, 90]]) { X.beginPath(); X.arc(tx + dx, FL - 440 + dx * 0.3, r, 0, 7); X.fill(); } X.restore();
      if (m > 0.6) { const q = Math.floor((e - 0.5) * 9); for (let i = 0; i < Math.min(q, 9); i++) rr(790 + (i % 3) * 8, FL - 300 - i * 22 - 200, 250, 18, 4, i % 2 ? '#e0c080' : '#d9b77a'); for (let i = 0; i < 10; i++) { const ph = (t * 2 + i / 10) % 1; X.fillStyle = `rgba(217,183,122,${1 - ph})`; X.beginPath(); X.arc(780 + ph * 220, FL - 430 - Math.sin(ph * 3 + i) * 120 * ph, 8, 0, 7); X.fill(); } } }
    sawWave(700, FL - 200, 940, FL - 560, t, 30, 0.7, 7); },
  c_co(t, u) { sky('#7cc4ec', '#cfeaf7'); X.fillStyle = '#4f9b3f'; X.fillRect(0, 1450, W, 470); house(240, 1450, 600, 500, '#d9c7a8', '#8a4a3a', '#3a3f6b'); bed(330, 1450, 0.75, t, { blanket: GREEN, snore: true }); zs(430, 1300, t, 0.9);
    const a = back(u / 0.15); X.save(); X.translate(540, 700); X.scale(a, a); rr(-330, -80, 660, 150, 16, '#1f2430'); X.strokeStyle = '#ffd23f'; X.lineWidth = 8; X.strokeRect(-330, -80, 660, 150); X.font = '64px P'; X.textAlign = 'center'; X.fillStyle = '#ffd23f'; X.fillText('SNORE LUMBER CO.', 0, 20); X.restore();
    rr(0, 1330, 250, 20, 6, '#555c66'); rr(830, 1330, 250, 20, 6, '#555c66'); for (let q = 0; q < 3; q++) { const ph = (t * 0.6 + q / 3) % 1; logH(-150 + ph * 330, 1304, 130, 24); const px = 840 + ph * 300; for (let i = 0; i < 3; i++) rr(px, 1312 - i * 16, 120, 12, 3, '#e0c080'); }
    const p = wordT('c_co', 'only'), b = back((t - p) / 0.2); if (b > 0) { X.save(); X.translate(790, 1010); X.rotate(0.06); X.scale(b, b); rr(-150, -130, 300, 280, 10, '#d9a441'); rr(-128, -108, 256, 190, 4, '#f7f1e0'); X.fillStyle = SKIN; X.beginPath(); X.arc(0, -20, 54, 0, 7); X.fill(); X.strokeStyle = '#2b2f3a'; X.lineWidth = 6; X.lineCap = 'round'; X.beginPath(); X.moveTo(-28, -26); X.lineTo(-8, -24); X.moveTo(10, -24); X.lineTo(30, -26); X.stroke(); X.fillStyle = '#2b2f3a'; X.beginPath(); X.ellipse(2, 8, 8, 10, 0, 0, 7); X.fill(); X.fillStyle = '#5a3d27'; X.font = '26px P'; X.textAlign = 'center'; X.fillText('EMPLOYEE OF', 0, 112); X.fillText('THE MONTH', 0, 140); X.restore(); } },
  c_forest(t, u) { X.fillStyle = '#070a18'; X.fillRect(0, 0, W, H); for (const [x, y, r] of STARS2) { X.fillStyle = 'rgba(255,255,255,.6)'; X.fillRect(x, y, r, r); } const f = 1 - sm(u / 0.62); earth(540, 980, 330, f, t);
    const e = t - ev('bill'), money = e >= 0 ? 1e9 : Math.floor(Math.pow(cl(u / 0.7), 3) * 9.4e8); rr(170, 1500, 740, 130, 30, 'rgba(0,0,0,.6)'); txt('$' + money.toLocaleString('en-US'), 540, 1592, 84, '#3ad06a'); for (let q = 0; q < 8; q++) { const ph = (t * 0.9 + q / 8) % 1, an = q * 0.8; txt('$', 540 + Math.cos(an) * (360 + ph * 160), 980 + Math.sin(an) * (360 + ph * 160), 54, '#3ad06a', 'center', (1 - ph) * (1 - f)); }
    if (e >= 0) stamp('BILLIONAIRE', 540, 980, -0.1, cl(e / 0.25), '#ffd23f', 100); },
  c_cabin(t, u) { sky('#7cc4ec', '#cfeaf7'); X.fillStyle = '#b89a66'; X.fillRect(0, 1400, W, 520); const z = 1.7; cabin(600, 1400, z); person(250, 1326, 1.2, 'hands', t); tophat(250, 1326, 1.2);
    const p = wordT('c_cabin', 'quiet'), a = back((t - p) / 0.2); if (a > 0) { X.save(); X.translate(250, 1010); X.scale(a, a); rr(-190, -130, 380, 200, 14, '#fff'); X.strokeStyle = '#e02424'; X.lineWidth = 10; X.strokeRect(-190, -130, 380, 200); X.fillStyle = '#e02424'; X.font = '70px P'; X.textAlign = 'center'; X.fillText('SOLD', 0, -40); X.fillStyle = '#333'; X.font = '32px P'; X.fillText('Quiet cabin', 0, 10); X.fillText('in the woods', 0, 48); X.restore(); rr(244, 1080, 12, 130, 0, '#6b4a30'); } },
  c_nowoods(t, u) { sky('#c9c2b0', '#e8dcc0'); X.fillStyle = '#b89a66'; X.fillRect(0, 1100, W, 820); const z = lerp(0.7, 0.5, sm(u)); for (let row = 0; row < 9; row++) for (let i = 0; i < 9; i++) { const x = 60 + i * 125 + (row % 2) * 60, y = 1180 + row * 85; if (Math.abs(x - 540) < 150 && Math.abs(y - 1380) < 110) continue; stump(x, y, 1.6 + row * 0.12); }
    cabin(540, 1420, z); person(540 + 190 * z + 40, 1400, 0.6, 'breath', t); tophat(540 + 190 * z + 40, 1400, 0.6); const tw = (t * 160) % 1500 - 200; X.strokeStyle = 'rgba(120,95,60,.8)'; X.lineWidth = 5; X.save(); X.translate(tw, 1640 - Math.abs(Math.sin(t * 4)) * 30); X.rotate(t * 5); for (let q = 0; q < 5; q++) { X.beginPath(); X.ellipse(0, 0, 34, 20 + q * 3, q * 0.7, 0, 7); X.stroke(); } X.restore(); },
  c_oxy(t, u) { X.fillStyle = '#070a18'; X.fillRect(0, 0, W, H); for (const [x, y, r] of STARS2) { X.fillStyle = 'rgba(255,255,255,.6)'; X.fillRect(x, y, r, r); } earth(540, 950, 300, 0, t, sm((u - 0.5) / 0.3));
    const lv = lerp(0.9, 0.12, sm((u - 0.15) / 0.5)), red = lv < 0.4; rr(190, 1480, 700, 64, 32, 'rgba(0,0,0,.65)'); rr(210, 1496, 660 * lv, 32, 16, red ? '#ff4a4a' : '#6af0a8'); txt(red ? 'OXYGEN: LOW' : 'OXYGEN', 540, 1458, 48, red ? '#ff6a5a' : '#fff'); },
  c_world(t, u) { X.fillStyle = '#070a18'; X.fillRect(0, 0, W, H); for (const [x, y, r] of STARS2) { X.fillStyle = 'rgba(255,255,255,.6)'; X.fillRect(x, y, r, r); } earth(540, 980, 290, 0, t, 1); for (let q = 0; q < 8; q++) { const an = q / 8 * Math.PI * 2 + 0.3; sawWave(540 + Math.cos(an) * 330, 980 + Math.sin(an) * 330, 540 + Math.cos(an) * 620, 980 + Math.sin(an) * 620, t + q * 0.2, 34, 1, 8); }
    rr(150, 1560, 780, 120, 30, 'rgba(0,0,0,.6)'); txt('8,000,000,000 SNORING', 540, 1642, 56, '#ffd23f'); },
  c_you(t, u) { bedroom(t); sawWave(690, FL - 190, 250, FL - 430, t, 46); sawWave(720, FL - 200, 980, FL - 520, t, 40); rrr(830, 470, t, 80); for (const [x0, y0, x1, y1] of [[540, 650, 300, 900], [-40, 700, 220, 980], [1120, 900, 900, 1080], [100, 1700, 300, 1380], [980, 1700, 800, 1400], [540, 1800, 540, 1450]]) sawWave(x0, y0, x1, y1, t + x0, 30, 0.85, 7); rrr(280, 620, t + 1, 70); rrr(560, 1560, t + 2, 80); },
};
const HOT = /chainsaw|three|genius|log|firewood|perfectly|good|sell|ten|tree|window|lumber|only|idea|forest|every|billionaire|quiet|woods|oxygen|sleepy|billion|sawing|logs|awake|you/i;
window.frame = (t) => {
  if (!T) return; const sh = shotAt(t), n = sh.name, u = sh.u; const s = shake(t);
  X.save(); X.translate(Math.sin(t * 91) * s, Math.cos(t * 77) * s); X.fillStyle = '#000'; X.fillRect(-40, -40, W + 80, H + 80);
  SC[n === 'end' ? 'c_you' : n](t, u); X.restore();
  const vg = X.createRadialGradient(540, 960, 560, 540, 960, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.4)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  if (t < 3.3) { const a = 1 - sm((t - 2.9) / 0.4), p = 1 + 0.05 * Math.sin(t * 6); X.save(); X.globalAlpha = a; X.translate(540, 1620); X.scale(p, p); rr(-330, -56, 660, 104, 24, '#d42d2d'); X.restore(); txt('3 AM. EVERY. NIGHT.', 540, 1638, 56, '#fff', 'center', a); }
  const sg = T.segs[Math.min(sh.i, T.segs.length - 2)]; let word = '', w0 = 0; for (const [w, wt] of sg.words || []) if (t >= wt) { word = w; w0 = wt; }
  if (word) { const pop = 1 + 0.14 * Math.exp(-(t - w0) * 14); X.save(); X.translate(540, 310); X.scale(pop, pop); txt(word.replace(/[.,?]/g, '').toUpperCase(), 0, 0, 104, HOT.test(word) ? '#ffd23f' : '#ffffff'); X.restore(); }
};
</script></body></html>
