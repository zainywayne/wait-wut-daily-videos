// CHAINSAW: your roommate snores like a chainsaw. One literal-minded fix snowballs until it eats the planet, then loops.
const SKIN = '#f1c7a4', BLUE = '#3d7bd9';
const ev = k => T.ev[k], seg = n => T.segs.find(q => q.shot === n);
function wordT(shot, w, nth = 0) { const h = seg(shot).words.filter(([x]) => x.toLowerCase().includes(w)); return h[nth][1]; }
function rr(x, y, w, h, r, col) { X.fillStyle = col; X.beginPath(); X.roundRect(x, y, w, h, r); X.fill(); }
function clock(x, y, s, ring, t, dead, lab = '3:00') { X.save(); X.translate(x, y); X.scale(s, s); if (ring) { X.rotate(Math.sin(t * 46) * 0.07); X.translate(0, -Math.abs(Math.sin(t * 23)) * 6); }
  X.fillStyle = '#9aa4ad'; X.beginPath(); X.arc(-44, -104, 20, Math.PI, 0); X.arc(44, -104, 20, Math.PI, 0); X.fill(); X.fillRect(-4, -122, 8, 20); X.fillRect(-58, -6, 14, 12); X.fillRect(44, -6, 14, 12);
  rr(-80, -104, 160, 100, 20, '#2a2f3a'); rr(-66, -92, 132, 66, 10, '#0b0d12'); X.font = '54px P'; X.textAlign = 'center'; X.fillStyle = dead ? '#5a1f1f' : (ring && Math.sin(t * 12) < 0 ? '#ff8a8a' : '#ff3030'); X.fillText(lab, 0, -40);
  X.restore(); if (ring) for (const sd of [-1, 1]) for (let q = 0; q < 3; q++) { const ph = (t * 2.2 + q / 3) % 1; X.strokeStyle = `rgba(255,210,63,${0.85 * (1 - ph)})`; X.lineWidth = 5 * s; X.beginPath(); X.arc(x + sd * 70 * s, y - 60 * s, (30 + ph * 70) * s, sd > 0 ? -0.7 : Math.PI - 0.7, sd > 0 ? 0.7 : Math.PI + 0.7); X.stroke(); } }
function zs(x, y, t, sc = 1) { for (let q = 0; q < 3; q++) { const ph = (t * 0.55 + q / 3) % 1; txt('z', x + ph * 50 * sc, y - ph * 110 * sc, (30 + q * 9) * sc, '#dfe6ff', 'center', Math.sin(ph * Math.PI)); } }
function bed(x, y, s, t, opt = {}) { X.save(); X.translate(x, y); X.scale(s, s); rr(-16, -250, 22, 250, 6, '#6b4a30'); rr(0, -72, 440, 34, 8, '#7a5536'); X.fillStyle = '#6b4a30'; X.fillRect(14, -40, 16, 40); X.fillRect(410, -40, 16, 40);
  rr(0, -116, 440, 48, 12, '#f2f0ea'); rr(12, -146, 118, 38, 16, '#ffffff');
  if (!opt.empty) { X.fillStyle = SKIN; X.beginPath(); X.arc(78, -158, 32, 0, 7); X.fill(); } if (opt.awake) { const j = Math.sin(t * 31) * 1.5; X.fillStyle = '#fff'; X.beginPath(); X.arc(80 + j, -166, 11, 0, 7); X.arc(100 + j, -164, 10, 0, 7); X.fill(); X.fillStyle = '#111'; X.beginPath(); X.arc(82 + j, -166, 4, 0, 7); X.arc(102 + j, -164, 4, 0, 7); X.fill(); X.strokeStyle = 'rgba(120,60,90,.7)'; X.lineWidth = 3; X.beginPath(); X.arc(80, -160, 13, 0.3, 2.6); X.stroke(); } else if (!opt.empty) { X.strokeStyle = '#2b2f3a'; X.lineWidth = 4; X.lineCap = 'round'; X.beginPath(); X.moveTo(84, -162); X.lineTo(98, -160); X.stroke(); } if (opt.empty) { rr(118, -160, 318, 30, 14, opt.blanket || '#5b7fd6'); X.restore(); return; } if (opt.snore) { X.fillStyle = '#2b2f3a'; X.beginPath(); X.ellipse(100, -146, 5, 4 + 3 * Math.sin(t * 3), 0, 0, 7); X.fill(); }
  rr(118, -160, 318, 56 + 4 * Math.sin(t * 2.5), 26, opt.blanket || '#5b7fd6'); rr(118, -124, 318, 14, 6, 'rgba(0,0,0,.12)');
  if (opt.arm) { const [ax, ay] = opt.arm; X.strokeStyle = opt.shirt || BLUE; X.lineWidth = 18; X.beginPath(); X.moveTo(140, -150); X.lineTo(ax, ay); X.stroke(); X.fillStyle = SKIN; X.beginPath(); X.arc(ax, ay, 13, 0, 7); X.fill(); }
  X.restore(); }
function wall(c1, c2, floorY, floorCol) { const g = X.createLinearGradient(0, 0, 0, H); g.addColorStop(0, c1); g.addColorStop(1, c2); X.fillStyle = g; X.fillRect(0, 0, W, H); if (floorY) { X.fillStyle = floorCol; X.fillRect(0, floorY, W, H - floorY + 400); X.fillStyle = 'rgba(0,0,0,.18)'; X.fillRect(0, floorY, W, 10); } }
function windowPane(x, y, w, h, sky) { rr(x - 10, y - 10, w + 20, h + 20, 8, '#e9e2d2'); rr(x, y, w, h, 4, sky); X.fillStyle = '#e9e2d2'; X.fillRect(x + w / 2 - 5, y, 10, h); X.fillRect(x, y + h / 2 - 5, w, 10); }
function sky(top, bot) { const g = X.createLinearGradient(0, 0, 0, H); g.addColorStop(0, top); g.addColorStop(1, bot); X.fillStyle = g; X.fillRect(0, 0, W, H); }
function house(x, y, w, h, col, roof, inner) { X.fillStyle = roof; X.beginPath(); X.moveTo(x - 40, y - h); X.lineTo(x + w / 2, y - h - w * 0.36); X.lineTo(x + w + 40, y - h); X.fill(); rr(x, y - h, w, h, 0, col); rr(x + 18, y - h + 18, w - 36, h - 18, 0, inner); X.fillStyle = 'rgba(0,0,0,.15)'; X.fillRect(x + 18, y - 12, w - 36, 12); }
function stamp(s, x, y, rot, a, col = '#e02424', size = 80) { if (a <= 0) return; X.save(); X.translate(x, y); X.rotate(rot); const k = 1 + (1 - a) * 1.4; X.scale(k, k); X.globalAlpha = Math.min(1, a * 1.5); X.font = `${size}px P`; X.textAlign = 'center'; const w = X.measureText(s).width; X.strokeStyle = col; X.lineWidth = 9; X.beginPath(); X.roundRect(-w / 2 - 26, -size * 0.92, w + 52, size * 1.25, 14); X.stroke(); X.fillStyle = col; X.fillText(s, 0, 0); X.restore(); }
function penguin(x, y, flip, t) { X.save(); X.translate(x, y + Math.abs(Math.sin(t * 5)) * -6); X.rotate(Math.sin(t * 5) * 0.05); X.fillStyle = '#f08a2a'; X.beginPath(); X.ellipse(-26, 0, 30, 12, 0, 0, 7); X.ellipse(30, 0, 30, 12, 0, 0, 7); X.fill();
  X.fillStyle = '#1f2430'; X.beginPath(); X.ellipse(0, -130, 92, 136, 0, 0, 7); X.fill(); X.fillStyle = '#f7f7f2'; X.beginPath(); X.ellipse(16, -112, 62, 104, 0, 0, 7); X.fill();
  X.fillStyle = '#fff'; X.beginPath(); X.arc(34, -208, 15, 0, 7); X.fill(); X.fillStyle = '#111'; X.beginPath(); X.arc(39, -208, 7, 0, 7); X.fill(); X.fillStyle = '#f08a2a'; X.beginPath(); X.moveTo(60, -196); X.lineTo(112, -184); X.lineTo(60, -170); X.fill();
  X.save(); X.translate(70, -150); X.rotate(0.5 - flip * 1.9); X.fillStyle = '#1f2430'; X.beginPath(); X.ellipse(0, 62, 22, 70, 0, 0, 7); X.fill(); X.restore(); X.restore(); }
function rocket(x, y, t, fire) { X.save(); X.translate(x, y); if (fire) { for (let q = 0; q < 3; q++) { const L = (140 + 60 * Math.sin(t * 40 + q * 2)) * (1 - q * 0.25); X.fillStyle = ['#ff7a2a', '#ffb030', '#fff0a0'][q]; X.beginPath(); X.moveTo(-50 + q * 14, 0); X.lineTo(0, L); X.lineTo(50 - q * 14, 0); X.fill(); } }
  X.fillStyle = '#d42d2d'; X.beginPath(); X.moveTo(-70, -40); X.lineTo(-130, 30); X.lineTo(-70, 10); X.fill(); X.beginPath(); X.moveTo(70, -40); X.lineTo(130, 30); X.lineTo(70, 10); X.fill();
  rr(-72, -420, 144, 430, 40, '#f4f4f0'); X.fillStyle = '#d42d2d'; X.beginPath(); X.moveTo(-72, -384); X.quadraticCurveTo(0, -560, 72, -384); X.fill(); X.fillStyle = '#8fd3ff'; X.beginPath(); X.arc(0, -300, 34, 0, 7); X.fill(); X.strokeStyle = '#9aa4ad'; X.lineWidth = 8; X.stroke();
  X.restore(); clock(x, y - 130, 0.85, false, t, false); X.fillStyle = 'rgba(190,196,204,.95)'; X.fillRect(x - 78, y - 200, 156, 16); X.fillRect(x - 78, y - 150, 156, 16); }
function shake(t) { let s = 0; for (const [k, d, m] of [['stack', 0.35, 14], ['tree', 0.5, 12], ['bill', 0.4, 10]]) { const e = t - ev(k); if (e >= 0 && e < d) s = Math.max(s, (1 - e / d) * m); } const n = shotAt(t).name; if (n === 'c_world' || n === 'c_you' || n === 'end') s = Math.max(s, 7); if (n === 'c_hook') s = Math.max(s, 3 * Math.max(0, Math.sin(t * 5))); return s; }
const STARS2 = Array.from({ length: 90 }, (_, i) => [(i * 197.3) % 1080, (i * 311.7) % 1920, 1 + (i % 3)]);
