function iconToilet(s) { X.save(); X.scale(s, s); X.strokeStyle = '#7f8a96'; X.lineWidth = 4; X.fillStyle = '#fff'; X.beginPath(); X.roundRect(-44, -86, 88, 54, 10); X.fill(); X.stroke(); rr(26, -78, 16, 6, 3, '#9aa4ad'); X.beginPath(); X.moveTo(-58, -26); X.quadraticCurveTo(-54, 40, -22, 50); X.lineTo(22, 50); X.quadraticCurveTo(54, 40, 58, -26); X.closePath(); X.fill(); X.stroke(); X.beginPath(); X.ellipse(0, -26, 60, 16, 0, 0, 7); X.fill(); X.stroke(); el(0, -24, 44, 9, '#8fd0f5'); X.beginPath(); X.roundRect(-24, 48, 48, 20, 6); X.fill(); X.stroke(); X.restore(); }
