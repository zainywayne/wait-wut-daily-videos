  if (B.hair === 'curly') { for (let q = 0; q < 9; q++) { const a = Math.PI * (1.08 + q * 0.105); el(Math.cos(a) * 82, -30 + Math.sin(a) * 92, 32, 30, c); } for (let q = 0; q < 6; q++) el(-62 + q * 25, -88 + (q % 2) * 10, 26, 24, c); for (let q = 0; q < 4; q++) el(-46 + q * 30, -66 + (q % 2) * 8, 18, 16, c); for (let q = 0; q < 7; q++) { const a = Math.PI * (1.1 + q * 0.13); el(Math.cos(a) * 80 + 6, -36 + Math.sin(a) * 90 - 6, 7, 6, 'rgba(255,255,255,.12)'); } }
  if (B.hair === 'fade') { X.fillStyle = c; X.beginPath(); X.moveTo(-96, -36); X.quadraticCurveTo(-100, -112, -10, -122); X.quadraticCurveTo(84, -122, 97, -40); X.quadraticCurveTo(60, -70, 0, -72); X.quadraticCurveTo(-60, -70, -96, -36); X.fill(); X.fillStyle = 'rgba(23,17,13,.35)'; X.beginPath(); X.moveTo(-100, -36); X.quadraticCurveTo(-104, 10, -96, 30); X.lineTo(-88, 30); X.quadraticCurveTo(-92, -10, -88, -40); X.fill(); X.beginPath(); X.moveTo(100, -36); X.quadraticCurveTo(104, 10, 96, 30); X.lineTo(88, 30); X.quadraticCurveTo(92, -10, 88, -40); X.fill(); X.strokeStyle = 'rgba(255,255,255,.1)'; X.lineWidth = 4; X.beginPath(); X.moveTo(-50, -104); X.quadraticCurveTo(0, -116, 50, -104); X.stroke(); }
  if (B.hair === 'side') { X.fillStyle = c; X.beginPath(); X.moveTo(-98, -20); X.quadraticCurveTo(-106, -118, -10, -126); X.quadraticCurveTo(90, -126, 100, -30); X.quadraticCurveTo(90, -60, 40, -78); X.quadraticCurveTo(-20, -96, -70, -50); X.quadraticCurveTo(-86, -36, -98, -20); X.fill(); X.strokeStyle = 'rgba(255,255,255,.14)'; X.lineWidth = 5; X.beginPath(); X.moveTo(-60, -100); X.quadraticCurveTo(10, -118, 70, -90); X.stroke(); X.strokeStyle = 'rgba(0,0,0,.25)'; X.lineWidth = 3; X.beginPath(); X.moveTo(-40, -118); X.quadraticCurveTo(-36, -100, -50, -84); X.stroke(); } }
function brow(sd, o, B) { const raise = o.browY * 12 + (sd < 0 ? o.browAsym * 10 : -o.browAsym * 4), tilt = o.browTilt * 0.35 * -sd; X.save(); X.translate(sd * 38, -52 - raise); X.rotate(tilt); rr(-24, -7, 48, 14, 7, B.hairC); X.restore(); }
function eye(sd, o, B, blink, t) { const ex = sd * 38, ey = -6; if (o.happyEye > 0.5) { X.strokeStyle = INK; X.lineWidth = 7; X.lineCap = 'round'; X.beginPath(); X.arc(ex, ey + 8, 17, Math.PI * 1.15, Math.PI * 1.85); X.stroke(); return; }
  const open = Math.max(0.08, o.eye * blink), rx = 21, ry = 24 * Math.min(1.25, open); el(ex, ey, rx, ry, '#ffffff'); X.save(); X.beginPath(); X.ellipse(ex, ey, rx, ry, 0, 0, 7); X.clip(); const ir = o.eye > 1.1 ? 10 : 13, lx = o.look * 8, ly = -o.lookUp * 8; el(ex + lx, ey + ly + 2, ir, ir, B.iris); el(ex + lx, ey + ly + 2, ir * 0.55, ir * 0.55, '#111'); el(ex + lx + 4, ey + ly - 3, 4, 4, '#fff'); X.fillStyle = B.skin; X.fillRect(ex - 30, ey - 40, 60, 40 - ry * 0.98 * Math.min(1, open) - (open < 1 ? 0 : 6)); X.restore(); X.strokeStyle = 'rgba(0,0,0,.55)'; X.lineWidth = 4; X.beginPath(); X.ellipse(ex, ey, rx, ry, 0, Math.PI * 1.1, Math.PI * 1.9); X.stroke(); }
function mouth(o, B, t) { const w = 30 + o.open * 6 + o.talk * 4, op = Math.min(1, o.open + o.talk * 0.85 + (o.laugh > 0.5 ? Math.abs(Math.sin(t * 16)) * 0.25 : 0)), c = o.curve, sk = o.smirk, my = 64;
