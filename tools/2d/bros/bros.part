  const h = 8 + op * 42; X.save(); X.beginPath(); X.moveTo(-w, my + ly - c * 6); X.quadraticCurveTo(0, my - 6 - c * 4, w, my + ry - c * 6 - sk * 6); X.quadraticCurveTo(0, my + h + c * 12, -w, my + ly - c * 6); X.closePath(); X.fillStyle = '#4e1a1e'; X.fill(); X.clip(); rr(-w, my - 14 - c * 6, w * 2, 12 + op * 4, 4, '#fff'); el(0, my + h + c * 8, w * 0.6, 14, '#e2737c'); X.restore(); X.strokeStyle = 'rgba(70,20,22,.6)'; X.lineWidth = 3; X.beginPath(); X.moveTo(-w, my + ly - c * 6); X.quadraticCurveTo(0, my + h + c * 12, w, my + ry - c * 6 - sk * 6); X.stroke(); }
function beard(B) { X.fillStyle = B.hairC; X.beginPath(); X.moveTo(-99, -4); X.quadraticCurveTo(-104, 112, 0, 132); X.quadraticCurveTo(104, 112, 99, -4); X.lineTo(86, 6); X.quadraticCurveTo(76, 40, 44, 50); X.quadraticCurveTo(0, 40, -44, 50); X.quadraticCurveTo(-76, 40, -86, 6); X.closePath(); X.fill(); X.fillStyle = 'rgba(255,255,255,.06)'; X.beginPath(); X.ellipse(-50, 80, 20, 30, 0.4, 0, 7); X.fill(); }
function bro(id, t, s = BS) { const B = BROS[id], o = stateOf(id, t), blink = ((t + B.off * 1.7) % 3.9) < 0.12 ? 0.1 : 1; const breath = Math.sin(t * 1.8 + B.off) * 3, lb = o.laugh > 0.3 ? -Math.abs(Math.sin(t * 14)) * 9 * o.laugh : 0, tb = o.talk * 4;
