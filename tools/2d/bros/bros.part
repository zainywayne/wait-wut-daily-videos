// =============== AI BROS: guess what you are ===============
const SEAT = 1460, BS = 1.12;
const BROS = {
  J: { x: 185, skin: '#c98f62', skinD: '#a8714a', hair: 'curly', hairC: '#1d1510', shirt: '#7a4a2e', shirtD: '#5a3420', iris: '#4a2e1a', cap: '#ffb347', off: 0.0, item: 'toilet', label: 'Toilet' },
  M: { x: 540, skin: '#b0754c', skinD: '#8c5a36', hair: 'fade', hairC: '#17110d', beard: true, shirt: '#22304f', shirtD: '#18223a', hood: true, iris: '#3a2416', cap: '#7cc0ff', off: 1.3, item: 'duck', label: 'Rubber Duck' },
  K: { x: 895, skin: '#e2b48f', skinD: '#c4916c', hair: 'side', hairC: '#3b2617', glasses: true, shirt: '#3f7a5a', shirtD: '#2e5c43', iris: '#2f6a8a', cap: '#86e08f', off: 2.4, item: 'shark', label: 'Shark' },
};
// ---------- moods: every face is a blend of these numbers ----------
const MOOD = {
  neutral: { browY: 0, browTilt: 0, browAsym: 0, eye: 1, happyEye: 0, curve: 0.2, open: 0, smirk: 0, tilt: 0, back: 0, laugh: 0, blush: 0, pose: 'rest' },
  smirk: { browY: 0.2, browTilt: -0.2, browAsym: 0.4, eye: 0.75, happyEye: 0, curve: 0.5, open: 0, smirk: 1, tilt: 0.05, back: 0, laugh: 0, blush: 0, pose: 'rest' },
  laugh: { browY: 0.4, browTilt: -0.3, browAsym: 0, eye: 1, happyEye: 1, curve: 1, open: 0.75, smirk: 0, tilt: -0.04, back: 0.06, laugh: 1, blush: 0.6, pose: 'belly' },
  disgust: { browY: -0.3, browTilt: 0.6, browAsym: -0.5, eye: 0.7, happyEye: 0, curve: -0.8, open: 0.15, smirk: -0.8, tilt: -0.08, back: 0.1, laugh: 0, blush: 0, pose: 'palm' },
  shock: { browY: 1, browTilt: -0.4, browAsym: 0, eye: 1.3, happyEye: 0, curve: -0.2, open: 0.8, smirk: 0, tilt: 0, back: 0.08, laugh: 0, blush: 0, pose: 'face' },
  proud: { browY: 0.5, browTilt: -0.2, browAsym: 0.2, eye: 0.6, happyEye: 0, curve: 0.8, open: 0, smirk: 0.6, tilt: 0.04, back: 0.12, laugh: 0, blush: 0.2, pose: 'cross' },
  think: { browY: 0.3, browTilt: 0.2, browAsym: 0.8, eye: 0.85, happyEye: 0, curve: -0.1, open: 0, smirk: -0.3, tilt: 0.1, back: 0, laugh: 0, blush: 0, pose: 'chin', lookUp: 1 },
  confused: { browY: 0.5, browTilt: 0.3, browAsym: 1, eye: 1, happyEye: 0, curve: -0.3, open: 0.1, smirk: -0.4, tilt: 0.12, back: 0, laugh: 0, blush: 0, pose: 'rest' },
  happy: { browY: 0.5, browTilt: -0.3, browAsym: 0, eye: 1, happyEye: 1, curve: 1, open: 0.5, smirk: 0, tilt: 0, back: 0.04, laugh: 0.5, blush: 0.5, pose: 'fists' },
  sad: { browY: 0.4, browTilt: -0.9, browAsym: 0, eye: 0.8, happyEye: 0, curve: -1, open: 0, smirk: 0, tilt: 0.06, back: -0.04, laugh: 0, blush: 0, pose: 'rest' },
};
const NUMK = ['browY', 'browTilt', 'browAsym', 'eye', 'happyEye', 'curve', 'open', 'smirk', 'tilt', 'back', 'laugh', 'blush'];
const POSES = { rest: [[-78, -46], [78, -46]], belly: [[-54, -150], [54, -150]], palm: [[-78, -46], [118, -300]], face: [[-96, -430], [96, -430]], cross: [[52, -215], [-52, -205]], chin: [[-78, -46], [30, -392]], fists: [[-150, -480], [150, -480]], talk: [[-78, -46], [112, -232]] };
function moodOf(id, i) { const s = T.segs[i]; if (!s) return 'neutral'; if (s.fx && s.fx[id]) return s.fx[id]; return 'neutral'; }
function segIdx(t) { let i = 0; for (let k = 0; k < T.segs.length; k++) if (t >= T.segs[k].start) i = k; return i; }
function envAt(t) { const E = T.env, f = t * 30, i = Math.floor(f); if (!E || i < 0 || i + 1 >= E.length) return 0; return lerp(E[i], E[i + 1], f - i); }
function stateOf(id, t) { const i = segIdx(t), s = T.segs[i], k = sm(cl((t - s.start) / 0.18)); const A = MOOD[moodOf(id, i - 1)] || MOOD.neutral, B = MOOD[moodOf(id, i)] || MOOD.neutral; const o = {}; for (const n of NUMK) o[n] = lerp(A[n], B[n], k);
  const speaking = s.spk === id && t < s.start + s.talk; o.talk = speaking ? envAt(t) : 0; o.speaking = speaking; let pa = POSES[A.pose], pb = POSES[B.pose]; if (speaking && B.pose === 'rest') pb = POSES.talk; if (s.spk === id && A.pose === 'rest' && i > 0 && T.segs[i - 1].spk === id) pa = POSES.talk; o.hands = [0, 1].map(h => [lerp(pa[h][0], pb[h][0], k), lerp(pa[h][1], pb[h][1], k)]); o.lookUp = lerp(A.lookUp || 0, B.lookUp || 0, k);
  const spk = s.spk && BROS[s.spk] ? BROS[s.spk] : null; o.look = spk && s.spk !== id ? Math.sign(spk.x - BROS[id].x) : (speaking ? Math.sin(t * 0.7 + BROS[id].off) * 0.4 : 0); return o; }
// ---------- the bro ----------
function hand(x, y, skin, skinD) { el(x, y, 30, 28, skin); X.strokeStyle = 'rgba(0,0,0,.18)'; X.lineWidth = 3; X.beginPath(); X.ellipse(x, y, 30, 28, 0, 0, 7); X.stroke(); el(x - 18, y - 12, 11, 15, skinD, -0.5); }
