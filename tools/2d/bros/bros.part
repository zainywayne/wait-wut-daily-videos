  if (got > 0) { const k = back(Math.min(1, got / 0.3)); X.save(); X.translate(96, -90); X.scale(k, k); el(0, 0, 30, 30, '#2fb35a'); X.strokeStyle = '#fff'; X.lineWidth = 8; X.lineCap = 'round'; X.beginPath(); X.moveTo(-12, 0); X.lineTo(-3, 10); X.lineTo(14, -10); X.stroke(); X.restore(); }
  X.restore(); if (got > 0 && got < 1.4) confetti(x, y, got); }
function confetti(x, y, e) { const cols = ['#ffd23f', '#ff5a7a', '#5ac8ff', '#7fe08a', '#b18cff']; for (let q = 0; q < 26; q++) { const a = q * 2.399, sp = 260 + (q * 37) % 200; X.save(); X.translate(x + Math.cos(a) * sp * Math.min(1, e * 2.2), y + Math.sin(a) * sp * 0.7 * Math.min(1, e * 2.2) + e * e * 380); X.rotate(q + e * 8); X.globalAlpha = Math.max(0, 1 - e / 1.4); rr(-7, -4, 14, 8, 2, cols[q % 5]); X.restore(); } }
function crown(x, y, a, t) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(a * 0.75, a * 0.75); X.rotate(-0.12); X.fillStyle = '#ffc928'; X.beginPath(); X.moveTo(-58, 10); X.lineTo(-62, -40); X.lineTo(-32, -14); X.lineTo(0, -54); X.lineTo(32, -14); X.lineTo(62, -40); X.lineTo(58, 10); X.closePath(); X.fill(); X.strokeStyle = '#d99a10'; X.lineWidth = 4; X.stroke(); el(-60, -42, 7, 7, '#ff5a7a'); el(0, -56, 8, 8, '#5ac8ff'); el(60, -42, 7, 7, '#7fe08a'); for (let q = 0; q < 3; q++) { const ph = (t * 1.4 + q / 3) % 1; txt('✦', -70 + q * 70, -70 - ph * 30, 26, '#fff7c2', 'center', Math.sin(ph * Math.PI)); } X.restore(); }
// ---------- room ----------
function room(t) { const g = X.createLinearGradient(0, 0, 0, 1100); g.addColorStop(0, '#d8cdc2'); g.addColorStop(1, '#b8aa9d'); X.fillStyle = g; X.fillRect(-400, -400, 1900, 1500); for (let q = -4; q < 20; q++) rr(q * 70, 0, 3, 1100, 0, 'rgba(255,255,255,.12)');
  const lg = X.createRadialGradient(80, 420, 10, 80, 420, 420); lg.addColorStop(0, 'rgba(255,214,150,.55)'); lg.addColorStop(1, 'rgba(255,214,150,0)'); X.fillStyle = lg; X.fillRect(-400, 0, 900, 900);
  X.strokeStyle = 'rgba(60,40,30,.5)'; X.lineWidth = 2; X.beginPath(); X.moveTo(-40, 120); for (let q = 0; q <= 12; q++) X.quadraticCurveTo(q * 100 - 50, 160, q * 100, 120); X.stroke(); for (let q = 0; q < 12; q++) { const bx = q * 100 + 10, by = 138 + (q % 2) * 6, fl = 0.75 + 0.25 * Math.sin(t * 2 + q * 1.7); X.save(); X.shadowColor = '#ffcf7a'; X.shadowBlur = 24; el(bx, by, 9, 11, `rgba(255,214,140,${fl})`); X.restore(); }
  rr(690, 334, 100, 106, 8, '#2b2420'); rr(698, 342, 84, 90, 4, '#e9775a'); el(740, 387, 22, 22, '#f6d36b'); rr(830, 344, 90, 96, 8, '#2b2420'); rr(838, 352, 74, 80, 4, '#5a8fc8'); X.fillStyle = '#e9eef4'; X.beginPath(); X.moveTo(838, 432); X.lineTo(875, 378); X.lineTo(912, 432); X.fill();
  rr(150, 420, 220, 14, 4, '#6b4a33'); for (let q = 0; q < 6; q++) rr(160 + q * 22, 356 + (q % 2) * 10, 18, 64 - (q % 2) * 10, 3, ['#d8473a', '#3f8fd8', '#e3a32b', '#4caf50', '#8e5aa8', '#e9775a'][q]); el(320, 396, 34, 24, '#5aa35c'); rr(300, 400, 40, 22, 6, '#c0603a');
  rr(-60, 960, 1200, 380, 70, '#3a2b25'); for (let q = 0; q < 6; q++) for (let r = 0; r < 2; r++) el(100 + q * 176 + r * 88, 1050 + r * 90, 6, 6, '#2a1f1a'); rr(-60, 940, 1200, 70, 40, '#45342c'); }
function couchFront(t) { rr(-60, 1380, 1200, 560, 40, '#33251f'); rr(-60, 1380, 1200, 30, 14, '#45342c'); X.strokeStyle = 'rgba(0,0,0,.25)'; X.lineWidth = 4; for (const x of [370, 710]) { X.beginPath(); X.moveTo(x, 1400); X.lineTo(x, 1560); X.stroke(); } rr(-80, 1000, 110, 600, 40, '#3e2e27'); rr(1050, 1000, 110, 600, 40, '#3e2e27'); }
// ---------- caption + overlays ----------
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 14 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
function gotAt(id, t) { const key = { K: 'gotK', M: 'gotM', J: 'gotJ' }[id], s = T.segs.find(q => q.ev === key); if (!s) return 0; const t0 = id === 'J' ? s.start + s.talk : s.start; return t > t0 ? t - t0 : 0; }
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const i = segIdx(t), s = T.segs[i];
  // camera: punch in on the target during zoom lines
  const zf = id => id && BROS[id] ? id : null, zc = zf(s.zoom), zp = i > 0 ? zf(T.segs[i - 1].zoom) : null; const kin = sm(cl((t - s.start) / 0.16)); const tgt = id => id ? [BROS[id].x, 800, 1.4] : [540, 900, 1.0]; const A = tgt(zp), Bz = tgt(zc), cx = lerp(A[0], Bz[0], kin), cy = lerp(A[1], Bz[1], kin), cz = lerp(A[2], Bz[2], kin);
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); cam(Math.max(540 / cz + 0, Math.min(1080 - 540 / cz, cx)), cy, cz); room(t);
  for (const id of ['J', 'M', 'K']) card(id, t, gotAt(id, t));
  const heads = {}; for (const id of ['J', 'M', 'K']) heads[id] = bro(id, t);
  const cs = T.segs.find(q => q.ev === 'crown'), ce = T.segs.find(q => q.ev === 'gotK'); if (cs && t > cs.start && t < ce.start + 0.4) { const hh = heads.J; crown(hh.hx, hh.hy - 136, Math.min(1, back(cl((t - cs.start) / 0.3))) * (t > ce.start ? cl(1 - (t - ce.start) / 0.4) : 1), t); }
  couchFront(t); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  const vg = X.createRadialGradient(540, 900, 520, 540, 900, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.38)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  if (i <= 2) { const a = i < 2 ? 1 : cl((s.start + s.dur - t) / 0.3); pill("THEY DON'T KNOW WHAT THEY ARE", 540, 250, 'rgba(255,210,63,.97)', INK, 54, a); pill('EP 1', 540, 360, 'rgba(14,15,22,.88)', '#fff', 44, a); }
  if (s.ev === 'cta' || s.shot === 'end') { const c = T.segs.find(q => q.ev === 'cta'); pill('COMMENT 3 ITEMS FOR EP 2', 540, 210, '#ffd23f', INK, 56, after(t, c.start, 0.3)); pill('WHO GUESSED BEST?', 540, 300, 'rgba(14,15,22,.88)', '#fff', 46, after(t, c.start + 0.5, 0.3)); }
  const si = Math.min(i, T.segs.length - 2), list = CH[si], col = (BROS[T.segs[si].spk] || {}).cap || '#ffd23f'; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (!cur) cur = list[0]; if (cur && t < T.segs[si].start + T.segs[si].dur) { const pop = 1 + 0.14 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1660); X.scale(pop, pop); X.font = '84px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 18; X.strokeStyle = '#111219'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : col; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
function pill(s, x, y, bg, fg, size = 58, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.font = `${size}px P`; X.textAlign = 'center'; const w = X.measureText(s).width; rr(x - w / 2 - 34, y - size * 0.95, w + 68, size * 1.4, size * 0.5, bg); X.fillStyle = fg; X.fillText(s, x, y); X.restore(); }
