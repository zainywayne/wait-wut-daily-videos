  else { X.strokeStyle = B.shirtD; X.lineWidth = 12; X.beginPath(); X.ellipse(0, ty + 4, 52, 26, 0, 0.1, Math.PI - 0.1); X.stroke(); if (id === 'K') rr(50, ty + 70, 50, 56, 6, B.shirtD); }
  rr(-36, ty - 70, 72, 84, 30, B.skinD);
