// ---------- the island world ----------
const IX = 540, IY = 1135;
function pill(s, x, y, bg, fg, size = 58, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.font = `${size}px P`; X.textAlign = 'center'; const w = X.measureText(s).width; rr(x - w / 2 - 34, y - size * 0.95, w + 68, size * 1.4, size * 0.5, bg); X.fillStyle = fg; X.fillText(s, x, y); X.restore(); }
function sky(t, dark = 0) { const g = X.createLinearGradient(0, -1200, 0, 760); g.addColorStop(0, mixc('#4fb4f0', '#2a2f55', dark)); g.addColorStop(1, mixc('#d4f1ff', '#7a6a8a', dark)); X.fillStyle = g; X.fillRect(-6000, -6000, 13000, 6760);
  X.save(); X.shadowColor = '#fff3a0'; X.shadowBlur = 80; el(900, 300, 70, 70, '#fff3a0'); X.restore();
  for (let q = 0; q < 5; q++) { const cx = ((q * 430 + t * 18) % 2600) - 900, cy = 420 + (q % 3) * 90; for (const [dx, dy, r] of [[0, 0, 60], [55, -20, 70], [115, 0, 55], [60, 20, 60]]) el(cx + dx, cy + dy, r, r * 0.7, 'rgba(255,255,255,.92)'); }
  const o = X.createLinearGradient(0, 760, 0, 2400); o.addColorStop(0, '#3aa9e8'); o.addColorStop(1, '#155fa8'); X.fillStyle = o; X.fillRect(-6000, 760, 13000, 9000);
  X.strokeStyle = 'rgba(255,255,255,.35)'; X.lineWidth = 5; X.lineCap = 'round'; for (let r = 0; r < 14; r++) for (let c = 0; c < 9; c++) { const y = 800 + r * r * 9 + r * 30, x = -900 + c * 420 + (r % 2) * 200 + Math.sin(t * 0.8 + r + c) * 30, w = 40 + r * 6; X.beginPath(); X.moveTo(x - w, y); X.quadraticCurveTo(x, y - 10 - r, x + w, y); X.stroke(); } if (dark > 0) { X.fillStyle = `rgba(20,10,30,${dark * 0.35})`; X.fillRect(-3000, -3000, 7000, 7000); } }
function mixc(a, b, p) { const A = [1, 3, 5].map(i => parseInt(a.slice(i, i + 2), 16)), B = [1, 3, 5].map(i => parseInt(b.slice(i, i + 2), 16)); return `rgb(${A.map((v, i) => Math.round(lerp(v, B[i], cl(p)))).join(',')})`; }
function island(t) { const sw = Math.sin(t * 1.6) * 4; el(IX, IY + 40 + sw * 0.3, 380, 60, 'rgba(255,255,255,.35)'); el(IX, IY + 30, 350, 80, '#e0c27a'); el(IX, IY, 340, 70, '#f2d896'); el(IX - 40, IY - 14, 240, 36, '#8ccf6a'); el(IX - 40, IY - 18, 220, 28, '#9bdc78'); }
function palm(x, y, s, t) { X.save(); X.translate(x, y); X.scale(s, s); X.strokeStyle = '#9a6a3a'; X.lineWidth = 34; X.lineCap = 'round'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(30, -150, 10, -290); X.stroke(); X.strokeStyle = 'rgba(0,0,0,.14)'; X.lineWidth = 4; for (let q = 0; q < 6; q++) { const yy = -40 - q * 45, xx = 30 * (1 - (1 + yy / 290) ** 2) * 0 + (yy > -150 ? 15 * (-yy / 150) : 30 - (-yy - 150) / 7); X.beginPath(); X.moveTo(xx - 14, yy); X.lineTo(xx + 14, yy - 4); X.stroke(); }
  for (let q = 0; q < 6; q++) { const a = -Math.PI / 2 + (q - 2.5) * 0.55 + Math.sin(t * 1.5 + q) * 0.05; X.save(); X.translate(10, -290); X.rotate(a); X.fillStyle = q % 2 ? '#3f9a4c' : '#55b062'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(70, -40, 140, 10); X.quadraticCurveTo(70, 0, 0, 12); X.fill(); X.restore(); } el(0, -282, 16, 16, '#7a4a26'); el(24, -276, 16, 16, '#6b3f22'); X.restore(); }
// things people can build (ghost = see-through preview)
const gc = (g, c) => g ? 'rgba(255,255,255,.55)' : c;
function ghostLine(g) { if (!g) return; X.setLineDash([16, 12]); X.strokeStyle = 'rgba(255,255,255,.95)'; X.lineWidth = 5; X.stroke(); X.setLineDash([]); }
function house(x, y, s, g) { X.save(); X.translate(x, y); X.scale(s, s); X.beginPath(); X.rect(-90, -120, 180, 120); X.fillStyle = gc(g, '#f4e3c3'); X.fill(); ghostLine(g); X.beginPath(); X.moveTo(-110, -112); X.lineTo(0, -210); X.lineTo(110, -112); X.closePath(); X.fillStyle = gc(g, '#d8473a'); X.fill(); ghostLine(g); if (!g) { rr(-24, -70, 48, 70, 6, '#8a5a30'); rr(36, -90, 40, 36, 4, '#9fd8ff'); rr(-76, -90, 40, 36, 4, '#9fd8ff'); } X.restore(); }
function pup(x, y, s, g, t) { X.save(); X.translate(x, y); X.scale(s, s); const c = gc(g, '#c98a4b'); X.save(); X.translate(-58, -60); X.rotate(-0.6 + Math.sin(t * 12) * 0.4); rr(-7, -46, 14, 46, 7, c); X.restore(); for (const lx of [-40, -20, 24, 44]) rr(lx - 8, -40, 16, 40, 7, c); X.beginPath(); X.ellipse(0, -60, 62, 34, 0, 0, 7); X.fillStyle = c; X.fill(); ghostLine(g); X.beginPath(); X.ellipse(56, -96, 34, 30, 0, 0, 7); X.fillStyle = c; X.fill(); ghostLine(g); el(80, -88, 18, 13, gc(g, '#f3dcb5')); el(95, -94, 7, 6, g ? 'rgba(255,255,255,.9)' : INK); el(50, -86, 12, 22, gc(g, '#7a4a26'), 0.3); if (!g) el(62, -104, 5, 5, INK); X.restore(); }
function volcano(x, y, s, g, t) { X.save(); X.translate(x, y); X.scale(s, s); X.beginPath(); X.moveTo(-150, 0); X.lineTo(-44, -230); X.lineTo(44, -230); X.lineTo(150, 0); X.closePath(); X.fillStyle = gc(g, '#7a5a48'); X.fill(); ghostLine(g); X.beginPath(); X.moveTo(-44, -230); X.quadraticCurveTo(-30, -180, -10, -200); X.quadraticCurveTo(10, -150, 24, -205); X.lineTo(44, -230); X.closePath(); X.fillStyle = gc(g, '#ff6a2a'); X.fill(); for (let q = 0; q < 3; q++) { const ph = (t * 0.5 + q / 3) % 1; el(Math.sin(ph * 6 + q) * 20, -250 - ph * 160, 26 + ph * 30, 20 + ph * 24, g ? `rgba(255,255,255,${0.35 * (1 - ph)})` : `rgba(90,90,100,${0.5 * (1 - ph)})`); } X.restore(); }
function postSign(x, y, s, label, a) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(s * a, s * a); rr(-8, -150, 16, 150, 4, '#8a5a30'); rr(-90, -200, 180, 70, 10, '#c98d4f'); rr(-82, -192, 164, 54, 8, '#dba66a'); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = '#4a2f1a'; X.fillText(label, 0, -151); X.restore(); }
function bubble(x, y, s, a, t) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s, s); rr(-300, -90, 600, 180, 40, '#fff'); X.fillStyle = '#fff'; X.beginPath(); X.moveTo(-180, 80); X.lineTo(-230, 140); X.lineTo(-120, 84); X.fill(); el(-220, -10, 50, 50, '#ffd23f'); X.font = '44px P'; X.textAlign = 'left'; X.fillStyle = '#8a8f99'; X.fillText('@you', -150, -24); X.fillStyle = INK; X.font = '50px P'; X.fillText('give him a house', -150, 40); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.fillText('♥ 2,481', 120, -24); X.restore(); }
function nameTag(x, y, s, a, t) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(s * a, s * a); X.rotate(-0.06); rr(-210, -130, 420, 260, 24, '#e02424'); rr(-196, -20, 392, 136, 14, '#fff'); X.font = '54px P'; X.textAlign = 'center'; X.fillStyle = '#fff'; X.fillText('HELLO', 0, -66); X.font = '30px P'; X.fillText('MY NAME IS', 0, -30); X.font = '84px P'; X.fillStyle = INK; X.fillText(Math.floor(t * 2) % 2 ? '?' : '_ _ _', 0, 80); X.restore(); }
function stars(x, y, t, t0) { const e = t - t0; if (e < 0 || e > 1.6) return; for (let q = 0; q < 4; q++) { const a = e * 5 + q * Math.PI / 2; txt('✦', x + Math.cos(a) * 60, y + Math.sin(a) * 18, 34, '#ffd23f', 'center', 1 - e / 1.6); } }
function sparkles(t, t0, n, cx, cy, rx, ry) { const e = t - t0; if (e < 0) return; for (let q = 0; q < n; q++) { const ph = (e * 0.8 + q / n) % 1; txt('✦', cx + Math.cos(q * 2.4) * rx * (0.4 + ph * 0.6), cy + Math.sin(q * 3.1) * ry - ph * 80, 30 + (q % 3) * 10, '#fff7c2', 'center', Math.sin(ph * Math.PI) * Math.min(1, e * 3)); } }
// base scene: everything that exists on Day 1 (palm + guy), plus optional extras
function scene(t, o = {}) { sky(t, o.dark || 0); if (o.volc) volcano(865, 1105, 0.9, o.volc === 'g', t); island(t); if (o.house) house(285, IY + 4, 0.85, o.house === 'g'); palm(650, IY - 8, 1.0, t); if (o.dog) pup(560, IY + 10, 0.7, o.dog === 'g', t); }
const HX = 430, HY = IY + 8;
// ---------------- new props for the story ----------------
const WL = 1192;   // water line in front of the island
function clipAbove(y) { X.save(); X.beginPath(); X.rect(-4000, -4000, 9000, y + 4000); X.clip(); }
function whale(x, y, s, open, t) { clipAbove(y); X.save(); X.translate(x, y); X.scale(s, s); el(0, 40, 230, 150, '#3f6fb0'); el(-30, 90, 170, 80, '#a9c8e8'); X.save(); X.translate(-200, 10); X.rotate(-open * 0.6); el(60, -30, 120, 60, '#3f6fb0'); X.restore(); el(-200, 70, 90, 40 + open * 30, '#2a3550'); el(-60, -40, 14, 14, '#fff'); el(-64, -40, 7, 7, INK); for (let q = 0; q < 3; q++) { const ph = (t * 1.2 + q / 3) % 1; el(30 + Math.sin(q * 3) * 20, -110 - ph * 120, 14 + ph * 20, 18 + ph * 26, `rgba(255,255,255,${0.7 * (1 - ph)})`); } X.restore(); X.restore(); }
function fin(x, y, t) { X.fillStyle = '#5b6573'; X.beginPath(); X.moveTo(x - 40, y); X.quadraticCurveTo(x + 10, y - 70, x + 30, y - 110); X.quadraticCurveTo(x + 30, y - 40, x + 50, y); X.closePath(); X.fill(); X.strokeStyle = 'rgba(255,255,255,.7)'; X.lineWidth = 5; X.beginPath(); X.moveTo(x - 70, y + 6); X.quadraticCurveTo(x, y - 4, x + 80, y + 6); X.stroke(); }
function ripples(x, y, t) { X.strokeStyle = 'rgba(255,255,255,.75)'; X.lineWidth = 5; for (let q = 0; q < 3; q++) { const ph = (t * 1.5 + q / 3) % 1; X.globalAlpha = 1 - ph; X.beginPath(); X.ellipse(x, y, 60 + ph * 90, 12 + ph * 16, 0, 0, 7); X.stroke(); } X.globalAlpha = 1; }
function drops(t, t0, x, y, n = 10) { const e = t - t0; if (e < 0 || e > 0.8) return; for (let q = 0; q < n; q++) { const a = -Math.PI / 2 + (q / n - 0.5) * 2.4, sp = 160 + (q * 37) % 120; el(x + Math.cos(a) * sp * e, y + Math.sin(a) * sp * e + e * e * 500, 9, 12, 'rgba(200,235,255,.9)'); } }
function dust(t, t0, x, y) { const e = t - t0; if (e < 0 || e > 0.6) return; for (let q = 0; q < 8; q++) { const a = Math.PI + q / 7 * Math.PI; el(x + Math.cos(a) * e * 240, y + Math.sin(a) * e * 60, 24 * (1 - e / 0.6), 16 * (1 - e / 0.6), 'rgba(242,216,150,.9)'); } }
function helpText(t, n, wipeX) { X.save(); X.beginPath(); X.rect(wipeX, 1100, 2000, 200); X.clip(); X.translate(540, 1178); X.scale(1, 0.5); X.font = '120px P'; X.textAlign = 'center'; X.fillStyle = 'rgba(150,110,50,.75)'; X.fillText('HELP'.slice(0, n), 0, 0); X.restore(); }
function bigWave(x) { if (x < -400 || x > 1600) return; const g = X.createLinearGradient(0, 960, 0, 1260); g.addColorStop(0, '#5cc4f5'); g.addColorStop(1, '#2a8fd8'); X.fillStyle = g; X.beginPath(); X.moveTo(x - 800, 1270); X.lineTo(x - 800, 1150); X.quadraticCurveTo(x - 250, 1120, x - 60, 980); X.quadraticCurveTo(x + 60, 930, x + 110, 1010); X.quadraticCurveTo(x + 40, 990, x + 20, 1060); X.quadraticCurveTo(x + 10, 1170, x + 70, 1270); X.closePath(); X.fill(); for (let q = 0; q < 9; q++) { const a = q / 8; el(x - 60 + a * 170 - a * a * 60, 975 + Math.sin(a * 3) * 10 - a * 0, 28 - q * 1.5, 20, '#fff'); } for (let q = 0; q < 6; q++) el(x - 700 + q * 110, 1150 + Math.sin(q) * 6, 40, 12, 'rgba(255,255,255,.7)'); }
// story state: where the guy is
const S0 = () => seg('d_swim').start;
function swimX(t) { return lerp(300, 120, cl((t - S0()) / 1.6)); }
// ---------------- scenes ----------------
const SC = {
  d_spit(t, u) { const f = cl(0.12 + t / ev('land') * 0.88), lt = ev('land'); cam(600, 1010, 0.95); sky(t); whale(900, 1100 + cl((t - 0.9) / 1) * 260, 0.85, t < 0.35 ? 1 : cl(1 - (t - 0.35) / 0.3), t); island(t); palm(650, IY - 8, 1.0, t);
    if (t < lt) { const x = lerp(760, HX, f), y = lerp(990, HY, f) - Math.sin(Math.PI * f) * 560; X.save(); X.translate(x, y - 130); X.rotate(-f * 7); guy(0, 130, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'shock', hl: [-110, -330], hr: [110, -330], noShadow: true }, t); X.restore(); }
    else { guy(HX, HY, 0.62, { hair: 'slick', eyes: 'closed', mouth: 'o', squash: pulse(t, lt, 0.35), hl: [-90, -120], hr: [90, -120], tilt: Math.sin(t * 6) * 0.06 }, t); dust(t, lt, HX, HY); stars(HX, HY - 275, t, lt); }
    drops(t, -0.15, 820, 1010, 12); },
  d_tiny(t, u) { const z = lerp(0.95, 0.26, sm(cl((t - seg('d_tiny').start) / 1.1))); cam(lerp(600, 540, sm(u)), lerp(1010, 1120, sm(u)), z); sky(t); island(t); palm(650, IY - 8, 1.0, t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'open', mouth: 'flat', look: Math.sin(t * 2.5), hl: [-90, -120], hr: [90, -120] }, t); },
  d_swim(t, u) { cam(400, 1060, 1.05); sky(t); island(t); palm(650, IY - 8, 1.0, t); const x = swimX(t); clipAbove(WL); guy(x, WL + 150, 0.62, { hair: 'slick', noLegs: true, eyes: 'angry', brow: 1, mouth: 'flat', look: -1, hl: [-120, -230 + Math.sin(t * 12) * 70], hr: [120, -230 - Math.sin(t * 12) * 70], bob: Math.sin(t * 12) * 4 }, t); X.restore(); ripples(x, WL, t); const ft = ev('fin'); if (t > ft) fin(lerp(-200, x - 170, sm(cl((t - ft) / 0.6))), WL - 4, t); },
  d_nope1(t, u) { const n1 = ev('n1'); cam(400, 1060, 1.05); sky(t); island(t); palm(650, IY - 8, 1.0, t); const x0 = swimX(t); fin(lerp(x0 - 170, x0 - 90, cl((t - n1) / 0.6)), WL - 4, t);
    if (t < n1) { clipAbove(WL); guy(x0, WL + 150, 0.62, { hair: 'slick', noLegs: true, eyes: 'wide', mouth: 'shock', look: -1, hl: [-90, -150], hr: [90, -150], bob: 0 }, t); X.restore(); ripples(x0, WL, t); }
    else { const r = cl((t - n1) / 0.45), x = lerp(x0, HX, sm(r)), y = r < 1 ? WL + 10 : HY; guy(x, y, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'shock', look: -1, hl: [-110, -330], hr: [110, -330], bob: r < 1 ? -Math.abs(Math.sin(t * 30)) * 14 : 0, sweat: true }, t); if (r < 1) drops(t, n1 + ((t - n1) % 0.15), x - 30, WL, 5); }
    X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, -0.08, (t - n1) / 0.15, '#e02424', 120); },
  d_coco(t, u) { const tc = ev('coco'), n2 = ev('n2'); cam(560, 990, 1.25); sky(t); island(t); const shake = t < tc ? Math.sin(t * 40) * 0.03 : 0; X.save(); X.translate(650, IY - 8); X.rotate(shake); X.translate(-650, -(IY - 8)); palm(650, IY - 8, 1.0, t); X.restore(); guy(570, HY, 0.62, { hair: 'slick', eyes: 'angry', brow: 1, mouth: 'grin', look: 1, lookY: t > tc ? -1 : 0, hl: [100, -200 + Math.sin(t * 40) * 10], hr: [130, -230 + Math.sin(t * 40) * 10] }, t); if (t > tc) { const f = cl((t - tc) / (n2 - 0.05 - tc)); el(lerp(660, 575, f), lerp(IY - 290, HY - 270, f * f), 18, 18, '#7a4a26'); } },
  d_nope2(t, u) { const n2 = ev('n2'); cam(560, 990, 1.25); sky(t); island(t); palm(650, IY - 8, 1.0, t); guy(570, HY, 0.62, { hair: 'slick', eyes: 'closed', mouth: 'o', squash: pulse(t, n2 - 0.05, 0.35), hl: [-90, -120], hr: [90, -120], tilt: Math.sin(t * 6) * 0.06 }, t); const e = t - n2; el(575 + 60 + e * 260, HY - 270 - e * 300 + e * e * 900, 18, 18, '#7a4a26'); stars(570, HY - 275, t, n2); X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, 0.08, (t - n2 - 0.3) / 0.15, '#e02424', 120); },
  d_help(t, u) { const th = ev('help'), tw = ev('wave'); cam(540, 1060, 1.15); sky(t); island(t); palm(650, IY - 8, 1.0, t); const n = Math.min(4, Math.max(0, Math.floor((t - th - 0.1) / 0.28) + 1)); const wx = t > tw ? lerp(-500, 1500, (t - tw) / 1.1) : -600; helpText(t, n, wx); const gx = lerp(380, 730, cl((t - th) / 1.2)); guy(t < tw ? gx : 730, HY - 30, 0.62, { hair: 'slick', eyes: 'happy', mouth: 'smile', look: -1, lookY: 1, hl: [-90, -120], hr: [-60, -40], bob: 0 }, t); bigWave(wx); },
  d_nope3(t, u) { const tw = ev('wave'), n3 = ev('n3'); cam(540, 1060, 1.15); sky(t); island(t); palm(650, IY - 8, 1.0, t); const wx = lerp(-500, 1500, (t - tw) / 1.1); helpText(t, 4, wx); const soaked = wx > 730; guy(730, HY - 30, 0.62, { hair: 'slick', eyes: soaked ? 'angry' : 'wide', brow: soaked ? 1 : 0, mouth: soaked ? 'frown' : 'shock', look: -1, hl: [-90, -120], hr: [90, -120], sweat: soaked, bob: 0 }, t); bigWave(wx); if (soaked) drops(t, tw + 0.65, 730, HY - 200, 10); X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, -0.06, (t - n3) / 0.15, '#e02424', 120); },
  d_you(t, u) { const ty = ev('you'); cam(560, lerp(930, 900, u), lerp(1.7, 2.0, sm(u))); sky(t); island(t); palm(650, IY - 8, 1.0, t); guy(560, HY, 0.62, { hair: 'slick', eyes: 'open', brow: -0.6, mouth: t > ty ? 'smile' : 'frown', look: 0, lookY: 0, hl: [-60, -110], hr: [60, -110], bob: 0 }, t); sparkles(t, ty, 10, 560, 760, 220, 120); },
  d_rule(t, u) { const tt = ev('top'), tb = ev('built'), e = t - tt; cam(560, 990, 1.0); sky(t); island(t); if (t > tb) house(285, IY + 4, 0.85, true); palm(650, IY - 8, 1.0, t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'grin', look: -1, lookY: -0.4, hl: [-80, -130], hr: [80, -130] }, t);
    const t0 = seg('d_rule').start, fly = cl((t - (tb - 0.5)) / 0.5); if (t < tb) bubble(540, 600 + fly * fly * 380, 0.9 * (1 - fly * 0.7), cl((t - t0) / 0.25) * (1 - fly), t); if (t >= tb - 0.05) { postSign(170, IY + 20, 0.8, '@you', after(t, tb, 0.3)); pill('TOMORROW', 285, 830, 'rgba(14,15,22,.85)', '#fff', 40, after(t, tb + 0.2, 0.3)); } },
  d_troll(t, u) { const tr = ev('terr'), e = t - tr, sh = e > 0 && e < 1 ? Math.sin(t * 60) * 7 * (1 - e) : 0; X.translate(sh, sh * 0.5); cam(570, 990, 1.0); sky(t, e > 0 ? cl(e / 0.3) * 0.5 : 0); if (t > tr) volcano(865, 1105, 0.9, true, t); island(t); house(285, IY + 4, 0.85, true); palm(650, IY - 8, 1.0, t); guy(HX, HY, 0.62, { hair: 'slick', eyes: t > tr ? 'wide' : 'open', mouth: t > tr ? 'shock' : 'smile', look: t > tr ? 1 : 0, sweat: t > tr, hl: t > tr ? [-110, -320] : [-80, -130], hr: t > tr ? [110, -320] : [80, -130] }, t); X.setTransform(1, 0, 0, 1, 0, 0); stamp('ANYTHING', 540, 470, 0.06, (t - tr) / 0.15, '#e02424', 100); },
  d_end(t, u) { const t0 = seg('d_end').start; cam(lerp(520, 480, sm(u)), lerp(990, 1000, sm(u)), lerp(1.0, 1.2, sm(u))); sky(t); island(t); palm(650, IY - 8, 1.0, t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'open', brow: -0.5, mouth: 'smile', look: 0, hl: [-120, -260], hr: [120, -260] }, t); X.setTransform(1, 0, 0, 1, 0, 0); pill('COMMENT 1 THING', 540, 300, '#ffd23f', INK, 70, after(t, t0, 0.3)); pill('TOP COMMENT GETS BUILT', 540, 440, 'rgba(14,15,22,.88)', '#fff', 50, after(t, t0 + 0.3, 0.3)); },
};
// captions: 2-3 word chunks, bold, lower third
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 13 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const sh = shotAt(t), n = sh.name === 'end' ? 'd_end' : sh.name, u = sh.name === 'end' ? 1 : sh.u;
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); SC[n](t, u); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  const vg = X.createRadialGradient(540, 960, 600, 540, 960, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.3)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  if (n === 'd_spit' || n === 'd_tiny') { const a = n === 'd_spit' ? 1 : cl((seg('d_tiny').start + seg('d_tiny').dur - t) / 0.3); pill('YOU DECIDE WHAT HE GETS', 540, 250, 'rgba(255,210,63,.96)', INK, 62, a); }
  const i = Math.min(sh.i, T.segs.length - 2), list = CH[i]; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (sh.name === 'end') cur = list[list.length - 1]; else if (!cur) cur = list[0]; if (cur) { const pop = 1 + 0.16 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1580); X.scale(pop, pop); X.font = '90px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 20; X.strokeStyle = '#14151c'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : '#ffd23f'; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
