// ---------- the island world ----------
const IX = 540, IY = 1135;
function pill(s, x, y, bg, fg, size = 58, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.font = `${size}px P`; X.textAlign = 'center'; const w = X.measureText(s).width; rr(x - w / 2 - 34, y - size * 0.95, w + 68, size * 1.4, size * 0.5, bg); X.fillStyle = fg; X.fillText(s, x, y); X.restore(); }
function sky(t, dark = 0) { const g = X.createLinearGradient(0, -1200, 0, 760); g.addColorStop(0, mixc('#4fb4f0', '#2a2f55', dark)); g.addColorStop(1, mixc('#d4f1ff', '#7a6a8a', dark)); X.fillStyle = g; X.fillRect(-3000, -3000, 7000, 3760);
  X.save(); X.shadowColor = '#fff3a0'; X.shadowBlur = 80; el(900, 300, 70, 70, '#fff3a0'); X.restore();
  for (let q = 0; q < 5; q++) { const cx = ((q * 430 + t * 18) % 2600) - 900, cy = 420 + (q % 3) * 90; for (const [dx, dy, r] of [[0, 0, 60], [55, -20, 70], [115, 0, 55], [60, 20, 60]]) el(cx + dx, cy + dy, r, r * 0.7, 'rgba(255,255,255,.92)'); }
  const o = X.createLinearGradient(0, 760, 0, 2400); o.addColorStop(0, '#3aa9e8'); o.addColorStop(1, '#155fa8'); X.fillStyle = o; X.fillRect(-3000, 760, 7000, 4000);
  X.strokeStyle = 'rgba(255,255,255,.35)'; X.lineWidth = 5; X.lineCap = 'round'; for (let r = 0; r < 14; r++) for (let c = 0; c < 9; c++) { const y = 800 + r * r * 9 + r * 30, x = -900 + c * 420 + (r % 2) * 200 + Math.sin(t * 0.8 + r + c) * 30, w = 40 + r * 6; X.beginPath(); X.moveTo(x - w, y); X.quadraticCurveTo(x, y - 10 - r, x + w, y); X.stroke(); } if (dark > 0) { X.fillStyle = `rgba(20,10,30,${dark * 0.35})`; X.fillRect(-3000, -3000, 7000, 7000); } }
function mixc(a, b, p) { const A = [1, 3, 5].map(i => parseInt(a.slice(i, i + 2), 16)), B = [1, 3, 5].map(i => parseInt(b.slice(i, i + 2), 16)); return `rgb(${A.map((v, i) => Math.round(lerp(v, B[i], cl(p)))).join(',')})`; }
function island(t) { const sw = Math.sin(t * 1.6) * 4; el(IX, IY + 40 + sw * 0.3, 380, 60, 'rgba(255,255,255,.35)'); el(IX, IY + 30, 350, 80, '#e0c27a'); el(IX, IY, 340, 70, '#f2d896'); el(IX - 40, IY - 14, 240, 36, '#8ccf6a'); el(IX - 40, IY - 18, 220, 28, '#9bdc78'); }
function palm(x, y, s, t) { X.save(); X.translate(x, y); X.scale(s, s); X.strokeStyle = '#9a6a3a'; X.lineWidth = 34; X.lineCap = 'round'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(30, -150, 10, -290); X.stroke(); X.strokeStyle = 'rgba(0,0,0,.14)'; X.lineWidth = 4; for (let q = 0; q < 6; q++) { const yy = -40 - q * 45, xx = 30 * (1 - (1 + yy / 290) ** 2) * 0 + (yy > -150 ? 15 * (-yy / 150) : 30 - (-yy - 150) / 7); X.beginPath(); X.moveTo(xx - 14, yy); X.lineTo(xx + 14, yy - 4); X.stroke(); }
  for (let q = 0; q < 6; q++) { const a = -Math.PI / 2 + (q - 2.5) * 0.55 + Math.sin(t * 1.5 + q) * 0.05; X.save(); X.translate(10, -290); X.rotate(a); X.fillStyle = q % 2 ? '#3f9a4c' : '#55b062'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(70, -40, 140, 10); X.quadraticCurveTo(70, 0, 0, 12); X.fill(); X.restore(); } el(0, -282, 16, 16, '#7a4a26'); el(24, -276, 16, 16, '#6b3f22'); X.restore(); }
// things people can build (ghost = see-through preview)
const gc = (g, c) => g ? 'rgba(255,255,255,.55)' : c;
function ghostLine(g) { if (!g) return; X.setLineDash([16, 12]); X.strokeStyle = 'rgba(255,255,255,.95)'; X.lineWidth = 5; X.stroke(); X.setLineDash([]); }
function house(x, y, s, g) { X.save(); X.translate(x, y); X.scale(s, s); X.beginPath(); X.rect(-90, -120, 180, 120); X.fillStyle = gc(g, '#f4e3c3'); X.fill(); ghostLine(g); X.beginPath(); X.moveTo(-110, -112); X.lineTo(0, -210); X.lineTo(110, -112); X.closePath(); X.fillStyle = gc(g, '#d8473a'); X.fill(); ghostLine(g); if (!g) { rr(-24, -70, 48, 70, 6, '#8a5a30'); rr(36, -90, 40, 36, 4, '#9fd8ff'); rr(-76, -90, 40, 36, 4, '#9fd8ff'); } X.restore(); }
function pup(x, y, s, g, t) { X.save(); X.translate(x, y); X.scale(s, s); const c = gc(g, '#c98a4b'); X.save(); X.translate(-58, -60); X.rotate(-0.6 + Math.sin(t * 12) * 0.4); rr(-7, -46, 14, 46, 7, c); X.restore(); for (const lx of [-40, -20, 24, 44]) rr(lx - 8, -40, 16, 40, 7, c); X.beginPath(); X.ellipse(0, -60, 62, 34, 0, 0, 7); X.fillStyle = c; X.fill(); ghostLine(g); X.beginPath(); X.ellipse(56, -96, 34, 30, 0, 0, 7); X.fillStyle = c; X.fill(); ghostLine(g); el(80, -88, 18, 13, gc(g, '#f3dcb5')); el(95, -94, 7, 6, g ? 'rgba(255,255,255,.9)' : INK); el(50, -86, 12, 22, gc(g, '#7a4a26'), 0.3); if (!g) el(62, -104, 5, 5, INK); X.restore(); }
function volcano(x, y, s, g, t) { X.save(); X.translate(x, y); X.scale(s, s); X.beginPath(); X.moveTo(-150, 0); X.lineTo(-44, -230); X.lineTo(44, -230); X.lineTo(150, 0); X.closePath(); X.fillStyle = gc(g, '#7a5a48'); X.fill(); ghostLine(g); X.beginPath(); X.moveTo(-44, -230); X.quadraticCurveTo(-30, -180, -10, -200); X.quadraticCurveTo(10, -150, 24, -205); X.lineTo(44, -230); X.closePath(); X.fillStyle = gc(g, '#ff6a2a'); X.fill(); for (let q = 0; q < 3; q++) { const ph = (t * 0.5 + q / 3) % 1; el(Math.sin(ph * 6 + q) * 20, -250 - ph * 160, 26 + ph * 30, 20 + ph * 24, g ? `rgba(255,255,255,${0.35 * (1 - ph)})` : `rgba(90,90,100,${0.5 * (1 - ph)})`); } X.restore(); }
function postSign(x, y, s, label, a) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(s * a, s * a); rr(-8, -150, 16, 150, 4, '#8a5a30'); rr(-90, -200, 180, 70, 10, '#c98d4f'); rr(-82, -192, 164, 54, 8, '#dba66a'); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = '#4a2f1a'; X.fillText(label, 0, -151); X.restore(); }
function bubble(x, y, s, a, t) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s, s); rr(-300, -90, 600, 180, 40, '#fff'); X.fillStyle = '#fff'; X.beginPath(); X.moveTo(-180, 80); X.lineTo(-230, 140); X.lineTo(-120, 84); X.fill(); el(-220, -10, 50, 50, '#ffd23f'); X.font = '44px P'; X.textAlign = 'left'; X.fillStyle = '#8a8f99'; X.fillText('@you', -150, -24); X.fillStyle = INK; X.font = '50px P'; X.fillText('give him a house', -150, 40); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.fillText('♥ 2,481', 120, -24); X.restore(); }
function nameTag(x, y, s, a, t) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(s * a, s * a); X.rotate(-0.06); rr(-210, -130, 420, 260, 24, '#e02424'); rr(-196, -20, 392, 136, 14, '#fff'); X.font = '54px P'; X.textAlign = 'center'; X.fillStyle = '#fff'; X.fillText('HELLO', 0, -66); X.font = '30px P'; X.fillText('MY NAME IS', 0, -30); X.font = '84px P'; X.fillStyle = INK; X.fillText(Math.floor(t * 2) % 2 ? '?' : '_ _ _', 0, 80); X.restore(); }
function stars(x, y, t, t0) { const e = t - t0; if (e < 0 || e > 1.6) return; for (let q = 0; q < 4; q++) { const a = e * 5 + q * Math.PI / 2; txt('✦', x + Math.cos(a) * 60, y + Math.sin(a) * 18, 34, '#ffd23f', 'center', 1 - e / 1.6); } }
function sparkles(t, t0, n, cx, cy, rx, ry) { const e = t - t0; if (e < 0) return; for (let q = 0; q < n; q++) { const ph = (e * 0.8 + q / n) % 1; txt('✦', cx + Math.cos(q * 2.4) * rx * (0.4 + ph * 0.6), cy + Math.sin(q * 3.1) * ry - ph * 80, 30 + (q % 3) * 10, '#fff7c2', 'center', Math.sin(ph * Math.PI) * Math.min(1, e * 3)); } }
// base scene: everything that exists on Day 1 (palm + guy), plus optional extras
function scene(t, o = {}) { sky(t, o.dark || 0); if (o.volc) volcano(865, 1105, 0.9, o.volc === 'g', t); island(t); if (o.house) house(285, IY + 4, 0.85, o.house === 'g'); palm(650, IY - 8, 1.0, t); if (o.dog) pup(560, IY + 10, 0.7, o.dog === 'g', t); }
const HX = 430, HY = IY + 8;
// ---------------- scenes ----------------
const SC = {
  d1_hook(t, u) { const z = t < 1.7 ? lerp(0.32, 1.25, sm(t / 1.7)) : 1.25 + (t - 1.7) * 0.02; cam(lerp(540, 470, sm(t / 1.7)), lerp(1060, 1010, sm(t / 1.7)), z); scene(t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'open', mouth: 'smile', look: 0.3, hl: [-80, -130], hr: [100, -330 + Math.sin(t * 9) * 30], bob: Math.sin(t * 4) * 3 }, t); },
  d1_tree(t, u) { const tc = ev('coco'); cam(lerp(500, 520, u), 1000, lerp(1.25, 1.3, u)); scene(t); const hit = t > tc; guy(HX + 40, HY, 0.62, { hair: 'slick', eyes: hit ? 'closed' : 'open', mouth: hit ? 'o' : 'flat', look: hit ? 0 : 0.6, lookY: hit ? 0 : -0.6, squash: pulse(t, tc, 0.3), hl: [-70, -120], hr: [70, -120], tilt: hit ? -0.05 : 0 }, t);
    const cy = Math.min(lerp(IY - 290, HY - 270, cl((t - (tc - 0.4)) / 0.4) ** 2), HY - 270); if (t < tc) { if (t > tc - 0.4) el(660 - (t - tc + 0.4) * 400, cy, 18, 18, '#7a4a26'); } else { const e = t - tc; el(HX + 40 + 60 + e * 260, HY - 270 - e * 300 + e * e * 900, 18, 18, '#7a4a26'); stars(HX + 40, HY - 275, t, tc); } },
  d1_name(t, u) { const tn = ev('name'); cam(560, 980, 1.18); scene(t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'open', brow: -0.5, mouth: 'frown', look: 1, hl: [-120, -260], hr: [120, -260], bob: 0 }, t); nameTag(430, 680, 0.8, after(t, tn - 0.15, 0.3), t); },
  d1_rule(t, u) { const tw = ev('world'); cam(540, lerp(1000, 990, sm(u)), lerp(1.18, 1.0, sm(u))); scene(t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'grin', look: -0.4, lookY: -0.6, hl: [-90, -300], hr: [90, -300] }, t); sparkles(t, tw - 0.3, 16, IX, IY - 120, 330, 120); stamp('YOU BUILD IT', 540, 470, -0.05, (t - tw) / 0.2, '#2a8a3e', 84); },
  d1_how(t, u) { const tt = ev('top'), ty = ev('you'), e = t - tt; cam(540, 990, 1.0); scene(t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'open', mouth: 'smile', look: -1, lookY: -0.4, hl: [-80, -130], hr: [80, -130] }, t);
    const fly = cl((t - (ty - 0.5)) / 0.5); if (t < ty) bubble(540, 600 + fly * fly * 380, 0.9 * (1 - fly * 0.7), cl(e / 0.2) * (1 - fly), t); if (t >= ty - 0.05) { for (let q = 0; q < 10; q++) { const ee = t - ty; if (ee < 0.6) txt('✦', 285 + Math.cos(q * 0.63) * ee * 300, IY - 100 + Math.sin(q * 0.63) * ee * 200, 30, '#fff7c2', 'center', 1 - ee / 0.6); } postSign(285, IY + 4, 1.0, '@you', after(t, ty, 0.3)); } },
  d1_ideas(t, u) { const th = ev('h'), td = ev('d'), tv = ev('v'), ta = ev('any'); cam(570, 990, lerp(1.0, 0.97, u)); scene(t, { house: t > th ? 'g' : 0, dog: t > td ? 'g' : 0, volc: t > tv ? 'g' : 0 }); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'o', look: t < td ? -1 : 1, hl: [-80, -130], hr: [80, -130] }, t);
    if (t > ta) for (let q = 0; q < 9; q++) { const a = after(t, ta + q * 0.06, 0.25); if (a > 0) txt('?', 120 + q * 105 + Math.sin(q * 7) * 20, 640 + Math.sin(q * 2.3) * 60 + Math.sin(t * 3 + q) * 10, 70 * Math.min(1.2, a), '#fff', 'center', Math.min(1, a)); } },
  d1_stay(t, u) { const ts = ev('stays'), tf = ev('forever'), e = t - ts, solid = t > ts, dk = cl(e / 0.4) * (1 - cl((t - (tf + 1.0)) / 0.5)); const sh = e > 0 && e < 1.6 ? Math.sin(t * 60) * 6 * (1 - e / 1.6) : 0; X.translate(sh, sh * 0.5); cam(570, 990, lerp(0.97, 1.05, sm(u))); scene(t, { house: solid ? 1 : 'g', dog: solid ? 1 : 'g', volc: solid ? 1 : 'g', dark: dk }); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'shock', sweat: solid, look: 1, hl: [-80, -130], hr: [80, -130] }, t); X.setTransform(1, 0, 0, 1, 0, 0); stamp('FOREVER', 540, 430, 0.06, (t - tf) / 0.15, '#e02424', 110); },
  d1_end(t, u) { const t0 = seg('d1_end').start, tf = ev('first'); cam(lerp(520, 480, sm(u)), lerp(980, 1000, sm(u)), lerp(1.0, 1.25, sm(u))); scene(t); guy(HX, HY, 0.62, { hair: 'slick', eyes: 'happy', mouth: 'grin', look: 0, hl: [-80, -130], hr: [100, -330 + Math.sin(t * 9) * 30] }, t); X.setTransform(1, 0, 0, 1, 0, 0); pill('DAY 1', 540, 250, '#ffd23f', INK, 70, after(t, t0, 0.3)); pill('1. NAME HIM', 540, 400, 'rgba(14,15,22,.88)', '#fff', 56, after(t, t0 + 0.6, 0.3)); pill('2. GIVE HIM ONE THING', 540, 520, 'rgba(14,15,22,.88)', '#fff', 56, after(t, tf - 0.3, 0.3)); },
};
// captions: 2-3 word chunks, bold, lower third
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 13 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const sh = shotAt(t), n = sh.name === 'end' ? 'd1_end' : sh.name, u = sh.name === 'end' ? 1 : sh.u;
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); SC[n](t, u); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  const vg = X.createRadialGradient(540, 960, 600, 540, 960, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.3)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  if (n === 'd1_hook' || n === 'd1_tree') { const a = n === 'd1_hook' ? 1 : cl((seg('d1_tree').start + 0.5 - t) / 0.3); pill('YOU BUILD HIS WORLD', 540, 250, 'rgba(255,210,63,.96)', INK, 66, a); pill('DAY 1', 540, 390, 'rgba(14,15,22,.88)', '#fff', 52, a); }
  const i = Math.min(sh.i, T.segs.length - 2), list = CH[i]; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (sh.name === 'end') cur = list[list.length - 1]; else if (!cur) cur = list[0]; if (cur) { const pop = 1 + 0.16 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1580); X.scale(pop, pop); X.font = '90px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 20; X.strokeStyle = '#14151c'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : '#ffd23f'; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
</script></body></html>
