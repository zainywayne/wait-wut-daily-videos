// ---------- helpers ----------
const hex = c => [1, 3, 5].map(i => parseInt(c.slice(i, i + 2), 16));
const mix = (a, b, p) => { const A = hex(a), B = hex(b); return `rgb(${A.map((v, i) => Math.round(lerp(v, B[i], cl(p)))).join(',')})`; };
const hueMix = (h1, h2, S, L, p) => `hsl(${((lerp(h1, h2, cl(p)) % 360) + 360) % 360},${S}%,${L}%)`;
const SEG = n => T.segs.find(q => q.shot === n), END = n => SEG(n).start + SEG(n).dur;
function pill(s, x, y, bg, fg, size = 58, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = a; X.font = `${size}px P`; X.textAlign = 'center'; const w = X.measureText(s).width; rr(x - w / 2 - 34, y - size * 0.95, w + 68, size * 1.4, size * 0.5, bg); X.fillStyle = fg; X.fillText(s, x, y); X.restore(); }
function ring(x, y, w, h, t, t0) { const e = t - t0; if (e < 0) return; const k = back(e / 0.3), pu = 1 + Math.sin(e * 7) * 0.03; X.save(); X.translate(x + w / 2, y + h / 2); X.scale(k * pu, k * pu); X.strokeStyle = '#ff2d2d'; X.lineWidth = 12; X.shadowColor = 'rgba(255,45,45,.7)'; X.shadowBlur = 24; X.beginPath(); X.ellipse(0, 0, w / 2 + 30, h / 2 + 30, 0, 0, 7); X.stroke(); X.restore(); }
function timer(t, c0, n) { const e = t - c0, left = Math.max(0, n - e), k = Math.ceil(left - 1e-6), f = left / n, pp = 1 + 0.12 * Math.exp(-((e % 1) + 1) * 0) * Math.exp(-(e % 1) * 10); const x = 540, y = 330; X.save(); X.translate(x, y); X.scale(pp, pp); el(0, 0, 100, 100, 'rgba(12,14,22,.9)'); X.strokeStyle = 'rgba(255,255,255,.15)'; X.lineWidth = 14; X.beginPath(); X.arc(0, 0, 84, 0, 7); X.stroke(); X.strokeStyle = left < 3.01 ? '#ff4040' : '#ffd23f'; X.lineCap = 'round'; X.beginPath(); X.arc(0, 0, 84, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * f); X.stroke(); X.font = '96px P'; X.textAlign = 'center'; X.fillStyle = '#fff'; X.fillText(String(k), 0, 32); X.restore(); }
function wallClock(x, y, r, t) { el(x, y, r + 8, r + 8, '#3a3f4c'); el(x, y, r, r, '#fff'); X.strokeStyle = INK; X.lineCap = 'round'; for (let q = 0; q < 12; q++) { const a = q / 12 * 7; X.lineWidth = 4; X.beginPath(); X.moveTo(x + Math.cos(a) * r * 0.82, y + Math.sin(a) * r * 0.82); X.lineTo(x + Math.cos(a) * r * 0.92, y + Math.sin(a) * r * 0.92); X.stroke(); } const s = Math.floor(t) / 60 * Math.PI * 2 - Math.PI / 2; X.lineWidth = 7; X.beginPath(); X.moveTo(x, y); X.lineTo(x + Math.cos(-2) * r * 0.5, y + Math.sin(-2) * r * 0.5); X.stroke(); X.lineWidth = 5; X.beginPath(); X.moveTo(x, y); X.lineTo(x + Math.cos(-0.3) * r * 0.72, y + Math.sin(-0.3) * r * 0.72); X.stroke(); X.strokeStyle = '#e02424'; X.lineWidth = 3; X.beginPath(); X.moveTo(x, y); X.lineTo(x + Math.cos(s) * r * 0.85, y + Math.sin(s) * r * 0.85); X.stroke(); el(x, y, 7, 7, INK); }
function plant(x, y, s, t) { X.save(); X.translate(x, y); X.scale(s, s); for (let q = 0; q < 7; q++) { X.save(); X.rotate((q - 3) * 0.32 + Math.sin(t * 1.3 + q) * 0.03); el(0, -110, 26, 70, q % 2 ? '#3f9a4c' : '#55b062'); X.restore(); } X.fillStyle = '#c0603a'; X.beginPath(); X.moveTo(-56, -40); X.lineTo(56, -40); X.lineTo(42, 40); X.lineTo(-42, 40); X.fill(); rr(-62, -52, 124, 22, 6, '#a84f2e'); X.restore(); }
// ---------- round 1: kitchen (the fridge turns green) ----------
function kitchen(t, p) { rr(0, 0, W, H, 0, '#f4ead8'); rr(0, 1300, W, 700, 0, '#d9d4cb'); for (let r = 0; r < 6; r++) for (let c = 0; c < 9; c++) if ((r + c) % 2) rr(c * 130 - (r % 2) * 0, 1300 + r * 130, 130, 130, 0, '#c4beb4');
  rr(380, 820, 700, 190, 0, '#e8f0f4'); for (let r = 0; r < 3; r++) for (let c = 0; c < 12; c++) { X.strokeStyle = 'rgba(80,120,160,.25)'; X.lineWidth = 3; X.strokeRect(380 + c * 60, 820 + r * 64, 60, 64); }
  rr(410, 470, 270, 300, 14, '#c98d4f'); rr(424, 484, 116, 272, 8, '#d9a066'); rr(552, 484, 116, 272, 8, '#d9a066'); rr(520, 600, 10, 50, 4, '#6b4320'); rr(562, 600, 10, 50, 4, '#6b4320');
  rr(720, 470, 250, 300, 10, '#fff'); rr(734, 484, 222, 272, 4, '#9fd8ff'); el(800, 560, 30, 30, '#ffe58a'); rr(839, 484, 12, 272, 0, '#fff'); rr(734, 614, 222, 12, 0, '#fff'); for (const sd of [0, 1]) { const sw = Math.sin(t * 1.1 + sd) * 6; X.fillStyle = hueMix(6, -148, 70, 63, p); X.beginPath(); X.moveTo(712 + sd * 266, 460); X.lineTo(712 + sd * 266 + (sd ? -60 : 60) + sw, 460); X.lineTo(712 + sd * 266 + (sd ? -30 : 30) + sw * 2, 790); X.lineTo(712 + sd * 266, 790); X.fill(); } rr(700, 452, 290, 16, 8, '#8a5a30');
  rr(380, 1000, 700, 34, 6, '#e7e2da'); rr(380, 1034, 700, 266, 0, '#b8794a'); for (let q = 0; q < 4; q++) { rr(392 + q * 172, 1050, 160, 232, 8, '#c98d4f'); rr(458 + q * 172, 1066, 28, 8, 4, '#4a3020'); }
  rr(440, 990, 180, 20, 6, '#9aa4ad'); X.strokeStyle = '#8a929b'; X.lineWidth = 14; X.lineCap = 'round'; X.beginPath(); X.moveTo(530, 990); X.lineTo(530, 920); X.quadraticCurveTo(530, 890, 570, 896); X.stroke(); const dp = (t * 0.8) % 1; el(574, 910 + dp * 80, 6, 9, `rgba(120,190,255,${1 - dp})`);
  rr(690, 960, 250, 44, 8, '#2a2d34'); el(760, 958, 50, 10, '#45484f'); el(870, 958, 50, 10, '#45484f'); rr(720, 880, 110, 80, 10, '#c7473a'); rr(706, 874, 138, 16, 8, '#a83a2f'); for (let q = 0; q < 4; q++) { const ph = (t * 0.6 + q / 4) % 1; el(775 + Math.sin(ph * 9 + q) * 24, 860 - ph * 260, 26 + ph * 30, 20 + ph * 24, `rgba(255,255,255,${0.5 * (1 - ph)})`); }
  el(990, 975, 56, 26, '#e3a32b'); el(970, 952, 22, 22, '#d8473a'); el(1004, 948, 22, 22, '#9acd32'); el(1030, 960, 20, 20, '#e3a32b');
  // the fridge
  const fc = '#f1f1ec', fs = '#d6d6cf'; rr(50, 560, 330, 745, 26, fs); rr(56, 560, 318, 735, 24, fc); rr(56, 830, 318, 8, 0, fs); rr(320, 640, 16, 140, 8, '#5b616b'); rr(320, 880, 16, 200, 8, '#5b616b');
  rr(110, 900, 150, 190, 4, '#fff'); X.strokeStyle = '#3f8fd8'; X.lineWidth = 6; X.beginPath(); X.moveTo(130, 1060); X.lineTo(170, 960); X.lineTo(210, 1060); X.stroke(); el(225, 935, 18, 18, '#ffd23f'); el(185, 892, 10, 10, '#d8473a'); el(110, 640, 16, 16, '#3f8fd8'); el(160, 700, 14, 14, '#e3a32b'); el(250, 660, 15, 15, '#4caf50');
  for (let q = 0; q < 4; q++) { rr(424 + q * 62, 404 + (q % 2) * 10, 48, 66 - (q % 2) * 10, 8, ['#e8d9b8', '#cfe3f0', '#f0c9b8', '#d8ecd0'][q]); rr(424 + q * 62, 398 + (q % 2) * 10, 48, 12, 4, '#8a5a30'); }
  rr(400, 840, 300, 10, 4, '#7a7f88'); for (let q = 0; q < 4; q++) { const sw = Math.sin(t * 1.7 + q) * 0.05; X.save(); X.translate(430 + q * 76, 850); X.rotate(sw); rr(-5, 0, 10, 90, 4, '#9aa4ad'); el(0, 100, q % 2 ? 20 : 14, q % 2 ? 26 : 18, '#9aa4ad'); X.restore(); }
  X.save(); X.translate(820, 1090); X.rotate(Math.sin(t * 1.3) * 0.06); rr(-50, 0, 100, 140, 8, '#f4f1de'); for (let q = 0; q < 3; q++) rr(-50, 24 + q * 38, 100, 12, 0, '#d8473a'); X.restore();
  wallClock(200, 400, 64, t); }
// ---------- round 2: bedroom (the painting fades out) ----------
function bedroom(t, p) { rr(0, 0, W, H, 0, '#d8e3ec'); for (let q = 0; q < 14; q++) rr(q * 80, 0, 3, 1320, 0, 'rgba(255,255,255,.35)'); rr(0, 1320, W, 700, 0, '#a8774c'); for (let q = 0; q < 10; q++) rr(0, 1320 + q * 70, W, 4, 0, 'rgba(0,0,0,.08)'); el(540, 1500, 470, 90, '#8e5aa8'); el(540, 1500, 400, 66, '#a873c0');
  rr(760, 470, 260, 360, 10, '#fff'); rr(774, 484, 232, 332, 4, '#1d2550'); for (let q = 0; q < 12; q++) X.fillRect(780 + (q * 67) % 220, 490 + (q * 41) % 300, 3, 3); X.fillStyle = '#fff'; el(940, 560, 26, 26, '#f4f1de'); rr(884, 484, 12, 332, 0, '#fff');
  for (const sd of [0, 1]) { const sw = Math.sin(t * 1.4 + sd * 2) * 12; X.fillStyle = '#6a8fc8'; X.beginPath(); X.moveTo(744 + sd * 292, 450); X.lineTo(744 + sd * 292 + (sd ? -70 : 70), 450); X.lineTo(744 + sd * 292 + (sd ? -40 : 40) + sw, 860); X.lineTo(744 + sd * 292, 860); X.fill(); } rr(730, 442, 320, 16, 8, '#5a3d27');
  // the painting (fades away)
  { X.save(); rr(300, 560, 380, 260, 8, '#8a5a30'); rr(316, 576, 348, 228, 4, '#ffcf8a'); const g = X.createLinearGradient(0, 576, 0, 804); g.addColorStop(0, '#ff9a5a'); g.addColorStop(1, '#ffd88a'); X.fillStyle = g; X.fillRect(316, 576, 348, 228); el(490, 700, 50, 50, '#fff2b0'); X.fillStyle = '#5a6fae'; X.beginPath(); X.moveTo(316, 804); X.lineTo(420, 680); X.lineTo(520, 804); X.fill(); X.fillStyle = '#3f5596'; X.beginPath(); X.moveTo(440, 804); X.lineTo(560, 650); X.lineTo(664, 804); X.fill(); X.restore(); }
  rr(110, 880, 760, 200, 30, '#7a5536'); rr(130, 900, 720, 160, 20, '#8a6040'); rr(140, 1040, 700, 120, 30, '#f2f0ea'); rr(170, 1010, 200, 80, 34, '#fff'); rr(410, 1010, 200, 80, 34, '#fff'); rr(110, 1100, 760, 220, 40, '#3f8fd8'); rr(110, 1100, 760, 40, 20, '#5aa3e8'); rr(110, 1290, 760, 40, 10, '#5e3f27'); rr(130, 1320, 26, 40, 4, '#5e3f27'); rr(824, 1320, 26, 40, 4, '#5e3f27');
  const bl = Math.sin(t * 5) > 0.3; rr(640, 1150, 60, 100, 12, '#22242e'); rr(646, 1158, 48, 84, 8, bl ? '#7fd0ff' : '#2b3a55');
  rr(0, 1080, 104, 240, 10, '#c98d4f'); rr(10, 1120, 84, 6, 2, '#8a5a30'); X.save(); X.globalAlpha = 1 - cl(p); rr(40, 1060, 34, 20, 6, '#6b6f78'); rr(52, 990, 10, 72, 2, '#6b6f78'); X.fillStyle = '#ffe9a8'; X.beginPath(); X.moveTo(8, 1000); X.lineTo(106, 1000); X.lineTo(88, 920); X.lineTo(26, 920); X.fill(); X.restore(); rr(14, 1036, 22, 30, 6, '#3f8fd8');
  rr(880, 1100, 180, 220, 10, '#c98d4f'); rr(960, 1010, 14, 90, 4, '#555'); el(967, 980, 62, 62, 'rgba(180,190,200,.45)'); X.save(); X.translate(967, 980); X.rotate(t * 14); for (let q = 0; q < 3; q++) { X.rotate(Math.PI * 2 / 3); el(0, -32, 14, 30, '#9aa4ad'); } X.restore(); el(967, 980, 10, 10, '#555'); X.strokeStyle = '#8a929b'; X.lineWidth = 4; X.beginPath(); X.arc(967, 980, 62, 0, 7); X.stroke();
  rr(60, 500, 200, 20, 6, '#8a5a30'); plant(110, 470, 0.45, t); rr(170, 430, 60, 70, 6, '#d8473a'); rr(200, 446, 50, 54, 6, '#3f8fd8');
  rr(360, 1420, 90, 40, 20, '#e86aa8'); rr(470, 1430, 90, 40, 20, '#e86aa8'); }
// ---------- round 3: living room (the cat grows, the walls change colour) ----------
function sleepyCat(x, y, s, t) { X.save(); X.translate(x, y); X.scale(s, s); el(0, 6, 120, 16, 'rgba(0,0,0,.18)'); X.save(); X.translate(90, -20); X.rotate(Math.sin(t * 2.2) * 0.25); X.strokeStyle = '#e08a3a'; X.lineWidth = 22; X.lineCap = 'round'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(50, 10, 40, -50); X.stroke(); X.restore(); el(10, -40, 110, 50, '#f0a04b'); for (let q = 0; q < 3; q++) rr(-20 + q * 34, -86, 14, 34, 6, '#d9822f'); const br = Math.sin(t * 2) * 2;
  X.fillStyle = '#f0a04b'; for (const sd of [-1, 1]) { X.beginPath(); X.moveTo(-80 + sd * 22, -86); X.lineTo(-80 + sd * 36, -126); X.lineTo(-80 + sd * 6, -100); X.fill(); } el(-80, -64 + br, 50, 42, '#f0a04b'); X.strokeStyle = INK; X.lineWidth = 4; for (const sd of [-1, 1]) { X.beginPath(); X.arc(-80 + sd * 18, -66 + br, 9, 0.2, Math.PI - 0.2); X.stroke(); } el(-80, -52 + br, 5, 4, '#e88a9a'); X.restore(); }
function living(t, pc, pw) { rr(0, 0, W, H, 0, '#a9c8e8'); rr(0, 1080, W, 26, 0, '#8fb2d6'); rr(0, 1300, W, 700, 0, '#9a6a42'); for (let q = 0; q < 10; q++) rr(q * 120, 1300, 4, 700, 0, 'rgba(0,0,0,.1)'); el(540, 1420, 470, 110, '#c94c4c'); el(540, 1420, 400, 84, '#e0705a');
  rr(70, 520, 380, 250, 14, '#1a1c24'); X.save(); X.beginPath(); X.rect(86, 536, 348, 218); X.clip(); const hue = (t * 40) % 360; X.fillStyle = `hsl(${hue},70%,62%)`; X.fillRect(86, 536, 348, 218); const bx = 140 + Math.abs(((t * 160) % 520) - 260), by = 730 - Math.abs(Math.sin(t * 4)) * 150; el(bx, by, 26, 26, '#fff'); X.restore(); rr(200, 770, 120, 16, 4, '#2a2d34');
  rr(600, 500, 180, 220, 8, '#8a5a30'); rr(614, 514, 152, 192, 4, '#f4f1de'); el(690, 590, 40, 40, '#3f8fd8'); rr(650, 630, 80, 60, 20, '#3f8fd8'); rr(820, 540, 130, 160, 8, '#8a5a30'); rr(832, 552, 106, 136, 4, hueMix(130, 205, 38, 63, pw)); X.strokeStyle = 'rgba(255,255,255,.6)'; X.lineWidth = 5; X.beginPath(); X.moveTo(850, 660); X.lineTo(885, 600); X.lineTo(920, 660); X.stroke();
  rr(150, 960, 760, 120, 40, '#d0683f'); rr(130, 1040, 800, 200, 40, '#c85a32'); rr(190, 1000, 330, 120, 30, '#de7a4f'); rr(540, 1000, 330, 120, 30, '#de7a4f'); rr(110, 1000, 80, 220, 36, '#b04e2a'); rr(870, 1000, 80, 220, 36, '#b04e2a'); rr(170, 1236, 30, 50, 6, '#5e3f27'); rr(860, 1236, 30, 50, 6, '#5e3f27'); rr(lerp(240, 640, cl(pc)), 1010, 120, 90, 24, '#ffd23f');
  rr(-6, 1120, 104, 180, 8, '#7a5536'); el(46, 1070, 48, 46, 'rgba(170,220,255,.6)'); const fx = 46 + Math.sin(t * 1.6) * 22; X.fillStyle = '#ff8a2a'; X.beginPath(); X.ellipse(fx, 1075, 14, 9, 0, 0, 7); X.fill(); X.beginPath(); X.moveTo(fx - (Math.cos(t * 1.6) > 0 ? 12 : -12), 1075); X.lineTo(fx - (Math.cos(t * 1.6) > 0 ? 26 : -26), 1066); X.lineTo(fx - (Math.cos(t * 1.6) > 0 ? 26 : -26), 1084); X.fill();
  rr(985, 760, 10, 540, 4, '#3a3f4c'); X.fillStyle = '#ffe9a8'; X.beginPath(); X.moveTo(940, 770); X.lineTo(1040, 770); X.lineTo(1015, 690); X.lineTo(965, 690); X.fill();
  sleepyCat(560, 1420, 1.25, t); rr(600, 830, 230, 16, 6, '#7a5536'); for (let q = 0; q < 5; q++) rr(612 + q * 28, 752 + (q % 2) * 12, 22, 78 - (q % 2) * 12, 3, ['#d8473a', '#3f8fd8', '#e3a32b', '#4caf50', '#8e5aa8'][q]); plant(785, 826, 0.32, t); }
// ---------------- scenes ----------------
const p1 = t => cl((t - SEG('r1_in').start) / (END('r1_c') - SEG('r1_in').start)), p2 = t => cl((t - SEG('r2_in').start) / (END('r2_c') - SEG('r2_in').start));
const replay = (t, t0, d = 0.9) => sm((t - t0) / d);
const SC = {
  r1_in(t, u) { kitchen(t, p1(t)); pill('ROUND 1 / 2', 540, 350, 'rgba(12,14,22,.88)', '#fff', 54, cl((t - 0.15) / 0.2 + 1)); },
  r1_c(t, u) { kitchen(t, p1(t)); timer(t, ev('r1c'), 10); },
  r1_r(t, u) { const w = ev('w1'); kitchen(t, t < w ? 1 : 0); if (t >= w) pill('BEFORE', 540, 350, '#fff', INK, 60); ring(700, 452, 290, 340, t, wordT('r1_r', 'curtains')); },
  r1_r2(t, u) { kitchen(t, replay(t, ev('n1'))); pill('NOW', 540, 350, '#2a8a3e', '#fff', 60); ring(700, 452, 290, 340, t, SEG('r1_r').start); },
  r2_in(t, u) { bedroom(t, p2(t)); pill('ROUND 2 / 2', 540, 350, 'rgba(12,14,22,.88)', '#fff', 54); },
  r2_c(t, u) { bedroom(t, p2(t)); timer(t, ev('r2c'), 10); },
  r2_r(t, u) { const a = ev('p2'), f = ev('f2'); bedroom(t, t < a ? 1 : t < f ? 0 : replay(t, f, 1.2)); if (t >= a) pill(t < f ? 'BEFORE' : 'NOW', 540, 350, t < f ? '#fff' : '#2a8a3e', t < f ? INK : '#fff', 60); ring(0, 910, 110, 170, t, a); },
  out(t, u) { bedroom(t, 1); stamp('? / 2', 540, 380, -0.05, (t - ev('four')) / 0.2, '#e02424', 120); if (t > ev('again')) { const e = t - ev('again'); X.save(); X.globalAlpha = Math.min(1, e * 3) * 0.5; X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.restore(); X.save(); X.translate(540, 820); X.rotate(-e * 6); X.strokeStyle = '#fff'; X.lineWidth = 18; X.lineCap = 'round'; X.globalAlpha = Math.min(1, e * 3); X.beginPath(); X.arc(0, 0, 90, 0.4, Math.PI * 1.8); X.stroke(); X.fillStyle = '#fff'; X.beginPath(); X.moveTo(70, 10); X.lineTo(118, 30); X.lineTo(104, -24); X.fill(); X.restore(); } },
};
// captions: 2-3 word chunks, bold, lower third
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 13 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const sh = shotAt(t), n = sh.name === 'end' ? 'out' : sh.name, u = sh.name === 'end' ? 1 : sh.u;
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); SC[n](t, u); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  if (n === 'r1_in') pill('CAN YOU CATCH BOTH?', 540, 200, 'rgba(255,210,63,.95)', INK, 64);
  const i = Math.min(sh.i, T.segs.length - 2), list = CH[i]; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (sh.name === 'end') cur = list[list.length - 1]; else if (!cur) cur = list[0]; if (cur) { const pop = 1 + 0.16 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1580); X.scale(pop, pop); X.font = '88px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 20; X.strokeStyle = '#14151c'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : '#ffd23f'; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
</script></body></html>
