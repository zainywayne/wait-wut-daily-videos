// ================= DAY 2: the chained superyacht =================
let SCX = 0;
const YP = 1330;                      // where the yacht sits, chained to the palm
const DECK = -100, AFT = -270;        // deck height and the spot he stands on (yacht units)
const GS = 0.55;                      // guy scale
const ANCHOR = () => [640, IY - 14];
const sternOf = (x, y = WL, s = 1, flip = false) => [x + (flip ? 360 : -360) * s, y - 70 * s];
const gyOf = (y = WL, s = 1) => y + DECK * s;
function yacht(x, y, s, t, o = {}) { X.save(); X.beginPath(); X.rect(-6000, -6000, 13000, y + 14 + 6000); X.clip(); X.translate(x, y); X.rotate(o.rot || 0); X.scale(s * (o.flip ? -1 : 1), s);
  rr(-354, -240, 6, 140, 2, '#8a929b'); X.fillStyle = '#e02424'; X.beginPath(); X.moveTo(-348, -240); X.lineTo(-290 + Math.sin(t * 8) * 6, -226); X.lineTo(-348, -210); X.fill();
  X.fillStyle = '#ffffff'; X.beginPath(); X.moveTo(-360, -100); X.lineTo(400, -128); X.quadraticCurveTo(330, -30, 250, 30); X.lineTo(-330, 30); X.quadraticCurveTo(-366, -30, -360, -100); X.fill();
  X.fillStyle = '#1f3b70'; X.beginPath(); X.moveTo(-362, -78); X.lineTo(388, -108); X.lineTo(374, -88); X.lineTo(-361, -58); X.fill(); X.fillStyle = '#d42d2d'; X.beginPath(); X.moveTo(-360, -52); X.lineTo(368, -82); X.lineTo(360, -72); X.lineTo(-358, -44); X.fill();
  for (const px of [-40, 40, 120, 200]) el(px, -32 - px * 0.02, 10, 10, '#2b4a7a');
  X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = '#1f3b70'; X.save(); X.translate(-200, -8); if (o.flip) X.scale(-1, 1); X.fillText(o.name || '', 0, 0); X.restore();
  X.fillStyle = '#f7f7f2'; X.beginPath(); X.moveTo(-210, -104); X.lineTo(-210, -196); X.lineTo(170, -196); X.lineTo(262, -118); X.lineTo(262, -110); X.fill(); X.fillStyle = '#22324f'; X.beginPath(); X.moveTo(-190, -172); X.lineTo(160, -172); X.lineTo(214, -128); X.lineTo(-190, -128); X.fill(); for (let q = 0; q < 5; q++) rr(-150 + q * 70, -172, 4, 44, 0, '#f7f7f2');
  X.fillStyle = '#ffffff'; X.beginPath(); X.moveTo(-140, -196); X.lineTo(-140, -262); X.lineTo(90, -262); X.lineTo(166, -196); X.fill(); X.fillStyle = '#22324f'; X.beginPath(); X.moveTo(-122, -244); X.lineTo(84, -244); X.lineTo(128, -210); X.lineTo(-122, -210); X.fill();
  rr(-60, -300, 90, 40, 10, '#f1f1ec'); el(-16, -312, 24, 14, '#e6e6e0'); rr(-18, -360, 5, 50, 2, '#8a929b'); X.save(); X.translate(-16, -360); X.rotate(t * 3); rr(-26, -3, 52, 6, 3, '#6b6f78'); X.restore();
  X.strokeStyle = '#c3cad2'; X.lineWidth = 5; X.beginPath(); X.moveTo(-356, -132); X.lineTo(-212, -136); X.moveTo(264, -146); X.lineTo(396, -156); X.stroke(); for (let q = 0; q < 4; q++) { X.beginPath(); X.moveTo(-340 + q * 40, -132); X.lineTo(-340 + q * 40, -102); X.stroke(); } for (let q = 0; q < 3; q++) { X.beginPath(); X.moveTo(290 + q * 36, -148); X.lineTo(290 + q * 36, -120); X.stroke(); }
  rr(-222, -160, 12, 60, 4, '#6b6f78'); X.save(); X.translate(-216, -162); X.rotate(o.wheel || 0); X.strokeStyle = '#8a5a30'; X.lineWidth = 6; X.beginPath(); X.arc(0, 0, 22, 0, 7); X.stroke(); for (let q = 0; q < 4; q++) { X.rotate(Math.PI / 4); X.beginPath(); X.moveTo(-26, 0); X.lineTo(26, 0); X.stroke(); } X.restore();
  if (o.lever != null) { X.save(); X.translate(-236, -104); X.rotate(-0.5 + o.lever * 1.0); rr(-4, -52, 8, 52, 3, '#6b6f78'); el(0, -54, 10, 10, '#e02424'); X.restore(); }
  if (o.deck) o.deck(); X.restore(); }
function guyOnDeck(x, t, o, y = WL, s = 1) { guy(x, gyOf(y, s), GS * s, Object.assign({ hair: 'slick' }, o), t); }
function shadesOn(x, t, y = WL, bob = 0) { shades(x, gyOf(y) - 330 * GS - 10 + bob * GS, GS, 1); }
function wake(t, x, y, dir, n = 5, len = 140) { for (let q = 0; q < n; q++) { const ph = (t * 3 + q / n) % 1; el(x + dir * ph * len, y + 6, 54 * (1 - ph), 9, `rgba(255,255,255,${0.75 * (1 - ph)})`); } }
function shades(x, y, s, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s, s); rr(-62, -30, 56, 30, 10, '#14151c'); rr(6, -30, 56, 30, 10, '#14151c'); rr(-8, -26, 16, 6, 3, '#14151c'); el(-46, -22, 8, 4, 'rgba(255,255,255,.35)'); el(22, -22, 8, 4, 'rgba(255,255,255,.35)'); X.restore(); }
function chain(x0, y0, x1, y1, sag, t, appear = 1, buzz = 0) { const n = 26; X.save(); X.lineWidth = 6; X.strokeStyle = '#6f7782'; for (let i = 0; i < n; i++) { const f = (i + 0.5) / n; if (f > appear) break; let x = lerp(x0, x1, f), y = lerp(y0, y1, f) + Math.sin(f * Math.PI) * sag; y += Math.sin(f * Math.PI * 6 + t * 70) * buzz; const a = Math.atan2(y1 - y0 + Math.cos(f * Math.PI) * sag * Math.PI / n, x1 - x0); X.save(); X.translate(x, y); X.rotate(a); X.beginPath(); if (i % 2) X.ellipse(0, 0, 11, 6, 0, 0, 7); else { X.moveTo(-11, 0); X.lineTo(11, 0); } X.stroke(); X.restore(); } X.restore(); }
function gauge(x, y, s, f, t, a) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s * Math.min(1, a), s * Math.min(1, a)); rr(-190, -150, 380, 200, 40, 'rgba(14,15,22,.9)'); X.lineCap = 'round'; X.lineWidth = 22; X.strokeStyle = '#3a3f4c'; X.beginPath(); X.arc(0, 20, 120, Math.PI * 1.1, Math.PI * 1.9); X.stroke(); X.strokeStyle = '#e02424'; X.beginPath(); X.arc(0, 20, 120, Math.PI * 1.1, Math.PI * 1.25); X.stroke(); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = f < 0.05 && Math.sin(t * 14) > 0 ? '#ff4040' : '#fff'; X.fillText('E', -130, -40); X.fillStyle = '#fff'; X.fillText('F', 130, -40); const an = Math.PI * (1.1 + 0.8 * f); X.strokeStyle = '#ffd23f'; X.lineWidth = 9; X.beginPath(); X.moveTo(0, 20); X.lineTo(Math.cos(an) * 104, 20 + Math.sin(an) * 104); X.stroke(); el(0, 20, 14, 14, '#ffd23f'); X.restore(); }
function smoke(t, t0, x, y, n, col) { for (let q = 0; q < n; q++) { const ph = ((t - t0) * 1.4 + q / n) % 1; if (t < t0) return; el(x - ph * 120, y - ph * 140, 18 + ph * 34, 16 + ph * 30, col.replace('A', (0.7 * (1 - ph)).toFixed(2))); } }
function card(t, a, hl) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); const k = 0.9 + 0.1 * Math.min(1, a); X.translate(540, 470); X.scale(k, k); rr(-470, -170, 940, 340, 40, '#ffffff'); el(-380, -90, 54, 54, '#b8bcc4'); for (const [dx, dy] of [[-16, -6], [14, -6]]) el(-380 + dx, -96 + dy, 6, 9, '#6b6f78'); rr(-392, -70, 24, 6, 3, '#6b6f78'); X.textAlign = 'left'; X.font = '40px P'; X.fillStyle = '#8a8f99'; X.fillText('@stupider8', -306, -96); X.font = '50px P'; X.fillStyle = INK; X.fillText('give him a yacht that is', -306, -26); X.fillStyle = hl ? '#e02424' : INK; X.fillText('chained to the island', -306, 38); X.fillStyle = INK; X.fillText("so it can't leave", -306, 102); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.textAlign = 'right'; X.fillText('♥ 19', 440, -96); if (hl) { X.strokeStyle = '#e02424'; X.lineWidth = 6; X.beginPath(); X.moveTo(-306, 50); X.lineTo(-306 + 520, 50); X.stroke(); } X.restore(); }
function bulbGlow(x, y, a) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(a, a); X.shadowColor = '#ffe58a'; X.shadowBlur = 50; el(0, 0, 40, 44, '#ffe58a'); X.shadowBlur = 0; rr(-16, 38, 32, 24, 5, '#9aa4ad'); X.restore(); }
function fishShape(x, y, s, t, cooked) { X.save(); X.translate(x, y); X.scale(s, s); X.rotate(cooked ? 0 : Math.sin(t * 18) * 0.3); X.fillStyle = cooked ? '#c9783a' : '#ff8a2a'; X.beginPath(); X.ellipse(0, 0, 60, 30, 0, 0, 7); X.fill(); X.beginPath(); X.moveTo(-50, 0); X.lineTo(-90, -28); X.lineTo(-90, 28); X.fill(); el(30, -6, 6, 6, INK); if (cooked) { X.strokeStyle = '#7a4a26'; X.lineWidth = 4; for (let q = 0; q < 3; q++) { X.beginPath(); X.moveTo(-20 + q * 20, -20); X.lineTo(-30 + q * 20, 20); X.stroke(); } } X.restore(); }
function bootShape(x, y, s, r) { X.save(); X.translate(x, y); X.rotate(r); X.scale(s, s); rr(-20, -60, 40, 70, 8, '#5a3d27'); rr(-20, -4, 70, 30, 12, '#5a3d27'); rr(-24, 20, 78, 8, 4, '#3a2a1e'); for (let q = 0; q < 3; q++) el(0, -40 + q * 14, 12, 3, '#d8c8a8'); X.restore(); }
function homeDeco(t, th) { return () => { const a1 = after(t, th + 0.1, 0.25), a2 = after(t, th + 0.3, 0.25), a3 = after(t, th + 0.5, 0.25);
  if (a2 > 0) { X.strokeStyle = '#8a929b'; X.lineWidth = 3; X.beginPath(); X.moveTo(-60, -290); X.quadraticCurveTo(-200, -230, -351, -236); X.stroke(); X.save(); X.globalAlpha = Math.min(1, a2); for (const [f, col, w] of [[0.22, '#e02424', 40], [0.48, '#ffd23f', 28], [0.72, '#3d7bd9', 36]]) { const px = lerp(-60, -351, f), py = lerp(-290, -236, f) + Math.sin(f * Math.PI) * 30; X.save(); X.translate(px, py); X.rotate(Math.sin(t * 3 + f * 9) * 0.12); rr(-w / 2, 0, w, w * 1.1, 6, col); X.restore(); } X.restore(); }
  if (a1 > 0) { X.save(); X.translate(-20, -150); X.scale(a1, a1); rr(-80, -30, 160, 60, 10, '#c98d4f'); rr(-72, -22, 144, 44, 8, '#dba66a'); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = '#4a2f1a'; X.fillText('HOME', 0, 14); X.restore(); }
  if (a3 > 0) { X.save(); X.translate(330, -132); X.scale(a3, a3); X.fillStyle = '#c0603a'; X.beginPath(); X.moveTo(-24, -34); X.lineTo(24, -34); X.lineTo(18, 0); X.lineTo(-18, 0); X.fill(); for (let q = 0; q < 4; q++) { X.save(); X.translate(0, -34); X.rotate((q - 1.5) * 0.4); el(0, -26, 10, 24, '#55b062'); X.restore(); } X.restore(); } }; }
function parked(t, o = {}) { const x = YP, y = WL + Math.sin(t * 2) * 3, st = sternOf(x, y), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 24, t); yacht(x, y, 1, t, Object.assign({ name: 'STUPIDER8' }, o)); return y; }
function base(t) { sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); }
// orbit: the chain only lets the yacht go round and round the island
const ORX = YP - IX, ORY = 260;
function orbitA(t) { const c = ev('circ'), e = ev('out') + 1.0; return Math.PI * 4 * sm(cl((t - c) / (e - c))); }
function orbitScene(t) { const a = orbitA(t), Y = { x: IX + ORX * Math.cos(a), y: WL + ORY * Math.sin(a), s: 1 + 0.25 * Math.sin(a), flip: Math.sin(a) > 0.02 }, moving = t < ev('out') + 0.9;
  cam(560, 1070, 0.5); sky(t); X.save(); X.globalAlpha = moving ? 0.5 : 0.2; X.strokeStyle = '#fff'; X.lineWidth = 12; X.setLineDash([40, 30]); X.beginPath(); X.ellipse(IX, WL, ORX, ORY, 0, 0, 7); X.stroke(); X.setLineDash([]); X.restore();
  const go = { hair: 'slick', eyes: moving ? 'angry' : 'wide', brow: moving ? 1 : 0, mouth: moving ? 'grin' : 'shock', look: 1, hl: [40, -120], hr: [62, -113], tilt: moving ? 0.1 : 0 };
  const drawY = () => { const st = sternOf(Y.x, Y.y, Y.s, Y.flip), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 0, t); yacht(Y.x, Y.y, Y.s, t, { name: 'STUPIDER8', lever: 1.2, flip: Y.flip, deck: () => guy(AFT + 20, DECK, GS, go, t) }); if (moving) wake(t, st[0], Y.y, Y.flip ? 1 : -1, 6, 220); };
  if (Math.sin(a) < 0) drawY(); island(t); palm(650, IY - 8, 1.0, t); const L = t > ev('ha2') && t < ev('ha2') + 0.6; gullBird(258, IY + 8, 1.0, t, { laugh: L }); if (L) txt('HA HA', 300, IY - 110, 60, '#fff', 'center'); if (moving && t > ev('circ') + 0.8) for (let q = 0; q < 3; q++) { const an2 = t * 6 + q * 2.1; txt('✦', 270 + Math.cos(an2) * 50, IY - 100 + Math.sin(an2) * 12, 40, '#ffd23f'); } if (Math.sin(a) >= 0) drawY(); }
function finAt(t, t0) { const a = (t - t0) * 1.3; return { x: YP + Math.cos(a) * 600, y: WL + 40 + Math.sin(a) * 70, front: Math.sin(a) >= 0 }; }
function fishScene(t) { const tc = ev('cast'), tb = ev('boot'), tf = ev('catch'); cam(1080, 1000, 1.05); base(t); const y = parked(t, { deck: homeDeco(t, -9) }); const gx = YP + AFT, gy = gyOf(y); const hand = [gx - 90 * GS, gy - 200 * GS];
  guy(gx, gy, GS, { hair: 'slick', eyes: t > tf ? 'happy' : t > tb && t < tb + 0.8 ? 'angry' : 'open', mouth: t > tf ? 'grin' : t > tb && t < tb + 0.8 ? 'frown' : 'flat', look: -1, hl: [-90, -200], hr: [-40, -150] }, t);
  const jerk = (t > tb - 0.1 && t < tb + 0.2) || (t > tf - 0.1 && t < tf + 0.3) ? 40 : 0, tip = [hand[0] - 110, hand[1] - 170 + jerk]; X.strokeStyle = '#6b4320'; X.lineWidth = 6; X.beginPath(); X.moveTo(hand[0], hand[1]); X.lineTo(tip[0], tip[1]); X.stroke();
  const cast = cl((t - tc) / 0.35), bob = [925, WL + 8 + Math.sin(t * 4) * 4]; let p; if (t < tb) p = [lerp(tip[0], bob[0], cast), lerp(tip[1], bob[1], cast) - Math.sin(cast * Math.PI) * 60]; else if (t < tb + 0.6) { const f = cl((t - tb) / 0.3); p = [bob[0], lerp(bob[1], tip[1] + 130, f)]; } else if (t < tf) p = bob; else { const f = cl((t - tf) / 0.3); p = [bob[0], lerp(bob[1], tip[1] + 140, f)]; }
  X.strokeStyle = 'rgba(255,255,255,.9)'; X.lineWidth = 2; X.beginPath(); X.moveTo(tip[0], tip[1]); X.lineTo(p[0], p[1]); X.stroke(); if (t < tb || (t > tb + 0.6 && t < tf)) el(p[0], p[1], 8, 8, '#e02424');
  if (t >= tb && t < tb + 0.6) bootShape(p[0], p[1] + 30, 0.8, Math.sin(t * 10) * 0.2); if (t >= tb + 0.6 && t < tb + 1.4) { const f = (t - tb - 0.6) / 0.8; bootShape(lerp(bob[0], 1700, f), lerp(tip[1] + 130, 760, f) + f * f * 500, 0.8, f * 9); }
  if (t >= tf) fishShape(p[0], p[1] + 40, 0.9, t, false); X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, -0.08, (t - tb - 0.15) / 0.15 * (t < tb + 0.9 ? 1 : 0), '#e02424', 110); stamp('DINNER', 540, 370, 0.06, (t - tf - 0.2) / 0.15, '#2a8a3e', 110); }
function gullSpot2(t) { gullBird(258, IY + 8, 1.0, t, {}); }
// ---------- scenes ----------
const SC = {
  d2_drop(t, u) { const ts = ev('splash'), f = cl(t / ts); cam(935, 1000, 0.66); base(t); const y = t < ts ? lerp(780, WL, f * f) : WL + Math.sin((t - ts) * 9) * 12 * Math.exp(-(t - ts) * 2.5);
    if (t < ts) { X.strokeStyle = 'rgba(255,255,255,.7)'; X.lineWidth = 8; for (let q = 0; q < 6; q++) { X.beginPath(); X.moveTo(YP - 300 + q * 120, y - 380 - (q % 2) * 40); X.lineTo(YP - 300 + q * 120, y - 560 - (q % 2) * 40); X.stroke(); } }
    yacht(YP, y, 1, t, { rot: (1 - f) * 0.12, name: 'STUPIDER8' }); if (t > ts) { const e = t - ts; el(YP, WL, 520 * Math.min(1, e * 4), 70 * Math.max(0, 1 - e), `rgba(255,255,255,${Math.max(0, 0.9 - e)})`); drops(t, ts, YP - 300, WL, 16); drops(t, ts + 0.05, YP + 300, WL, 16); }
    guy(HX, HY, 0.62, { hair: 'slick', eyes: t < ts ? 'wide' : 'happy', mouth: t < ts ? 'shock' : 'grin', look: 1, lookY: t < ts ? -1 : 0, hl: t < ts ? [-90, -150] : [-110, -330], hr: t < ts ? [90, -150] : [110, -330], bob: t > ts ? -Math.abs(Math.sin(t * 9)) * 16 : 0 }, t); },
  d2_recap(t, u) { const t0 = seg('d2_recap').start, e = t - t0, f = cl(e / 1.5); X.save(); X.filter = 'sepia(0.85) brightness(1.05)'; cam(600, 1010, 0.95); sky(t); whale(900, 1100 + cl((e - 1.2) / 1) * 260, 0.85, e < 0.3 ? 1 : cl(1 - (e - 0.3) / 0.3), t); island(t); palm(650, IY - 8, 1.0, t);
    if (f < 1) { const x = lerp(760, HX, f), y = lerp(990, HY, f) - Math.sin(Math.PI * f) * 560; X.save(); X.translate(x, y - 130); X.rotate(-f * 7); guy(0, 130, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'shock', hl: [-110, -330], hr: [110, -330] }, t); X.restore(); } else guy(HX, HY, 0.62, { hair: 'slick', eyes: 'closed', mouth: 'o', squash: pulse(t, t0 + 1.5, 0.35), hl: [-90, -120], hr: [90, -120] }, t); X.restore(); X.filter = 'none';
    X.setTransform(1, 0, 0, 1, 0, 0); pill('◀◀ YESTERDAY', 230, 150, 'rgba(14,15,22,.85)', '#fff', 44); },
  d2_rule(t, u) { const t0 = seg('d2_rule').start, tc = ev('chain'), r = cl((t - t0) / 1.0); cam(935, 1010, 0.66); base(t); const y = WL + Math.sin(t * 2) * 3; if (t > tc) { const d = cl((t - tc) / 0.35), st = sternOf(YP, y), an = ANCHOR(); chain(an[0], an[1] - (1 - d) * 600, st[0], st[1] - (1 - d) * 600, 24, t); } yacht(YP, y, 1, t, { name: 'STUPIDER8' });
    if (r < 1) { const gx = lerp(HX, YP + AFT, sm(r)), jr = cl((r - 0.6) / 0.4), gy = r < 0.6 ? HY : lerp(HY, gyOf(y), jr) - Math.sin(jr * Math.PI) * 140; guy(gx, gy, lerp(0.62, GS, r), { hair: 'slick', eyes: 'happy', mouth: 'grin', look: 1, hl: [-110, -300], hr: [110, -300], bob: -Math.abs(Math.sin(t * 14)) * 10 }, t); } else guyOnDeck(YP + AFT, t, { eyes: 'happy', mouth: 'grin', look: 1, hl: [-100, -300], hr: [100, -300], bob: -Math.abs(Math.sin(t * 8)) * 8 }, y); },
  d2_card(t, u) { cam(935, 1120, 0.66); base(t); const y = parked(t); guyOnDeck(YP + AFT, t, { eyes: 'happy', mouth: 'grin', look: 1, hl: [-100, -300 + Math.sin(t * 8) * 30], hr: [100, -300 - Math.sin(t * 8) * 30], bob: -Math.abs(Math.sin(t * 8)) * 8 }, y); X.setTransform(1, 0, 0, 1, 0, 0); card(t, after(t, ev('card'), 0.3), t > ev('chained')); },
  d2_party(t, u) { cam(lerp(1110, 1130, u), 990, lerp(1.0, 1.06, u)); base(t); const y = parked(t), gx = YP + AFT + Math.sin(t * 5) * 24, bob = -Math.abs(Math.sin(t * 10)) * 12; guyOnDeck(gx, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-120, -280 + Math.sin(t * 10) * 50], hr: [120, -280 - Math.sin(t * 10) * 50], bob, tilt: Math.sin(t * 5) * 0.1 }, y); shadesOn(gx, t, y, bob);
    if (t > ev('fine')) { X.setTransform(1, 0, 0, 1, 0, 0); pill('...', 230, 760, 'rgba(14,15,22,.8)', '#fff', 44, after(t, ev('fine'), 0.3)); } },
  d2_go(t, u) { const tg = ev('go'), e = Math.max(0, t - tg), x = YP + Math.min(85, e * e * 120); cam(1100, 1000, 0.75); base(t); const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 24 * (1 - (x - YP) / 85), t); yacht(x, WL, 1, t, { name: 'STUPIDER8', lever: cl(e * 2), wheel: Math.sin(t * 6) * 0.3 }); wake(t, st[0], WL, -1);
    guyOnDeck(x + AFT + 20, t, { eyes: 'angry', brow: 1, mouth: 'grin', look: 1, hl: [40, -120], hr: [62, -113], tilt: 0.08 }); shadesOn(x + AFT + 20 + 8, t); },
  d2_snap(t, u) { const ts = ev('snap'), e = t - ts, x = YP + 85 - (e > 0 ? Math.min(20, e * 160) : 0); cam(1100, 990, 1.0 + pulse(t, ts, 0.3) * 0.06); base(t); const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 0, t, 1, e > 0 && e < 0.4 ? 6 * (1 - e / 0.4) : 0); yacht(x, WL, 1, t, { name: 'STUPIDER8', lever: 1, rot: pulse(t, ts, 0.3) * 0.04 });
    const fly = cl(e / 0.2), gx = x + AFT + 20 + fly * 28, gy = gyOf() - Math.sin(fly * Math.PI) * 60; guy(gx, gy, GS, { hair: 'slick', eyes: e > 0.15 ? 'closed' : 'angry', mouth: e > 0.15 ? 'o' : 'grin', look: 1, hl: [-60, -200], hr: [60, -200], squash: e > 0.2 && e < 0.6 ? -0.5 : 0, tilt: fly * 0.35 }, t); if (e > 0.2) stars(gx, gy - 300 * GS, t, ts + 0.2); X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, -0.08, (t - ts - 0.5) / 0.15, '#e02424', 120); },
  d2_try(t, u) { if (t > ev('circ')) return orbitScene(t); const tl = ev('lever'), e = Math.max(0, t - tl), vib = Math.sin(t * 70) * 4 * cl(e * 3), x = YP + 65 + vib; cam(1060, 1010, 0.74); base(t); const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 0, t, 1, 3 * cl(e)); yacht(x, WL, 1, t, { name: 'STUPIDER8', lever: t > tl ? 1.2 : 0.5 }); smoke(t, tl, st[0], st[1] - 20, 6, 'rgba(60,60,70,A)'); wake(t, st[0], WL, -1); guyOnDeck(x + AFT + 20, t, { eyes: 'angry', brow: 1, mouth: 'frown', look: 1, hl: [40, -120], hr: [62, -113], tilt: 0.12, sweat: true }); },
  d2_circle(t, u) { orbitScene(t); },
  d2_gas(t, u) { const to = ev('out'); orbitScene(t); X.setTransform(1, 0, 0, 1, 0, 0); gauge(540, 400, 1.0, Math.max(0, 0.3 - Math.max(0, t - to + 0.5) * 0.4), t, after(t, to - 0.5, 0.3)); },
  d2_stop(t, u) { cam(lerp(1080, 1110, u), 1000, lerp(1.0, 1.08, u)); base(t); const y = parked(t); guyOnDeck(YP + AFT, t, { eyes: 'closed', mouth: 'frown', look: -1, hl: [-60, -110], hr: [60, -110], tilt: -0.06, bob: 6 }, y); },
  d2_home(t, u) { const th = ev('home'); cam(1120, 990, 1.0); base(t); const y = parked(t, { deck: homeDeco(t, th) }), gx = YP + AFT; guyOnDeck(gx, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-90, -130], hr: [110, -200] }, y); if (t > th + 0.7) { el(gx + 110 * GS, gyOf(y) - 205 * GS, 16, 18, '#7a4a26'); rr(gx + 110 * GS - 4, gyOf(y) - 245 * GS, 3, 22, 1, '#ff6aa8'); } },
  d2_fish(t, u) { fishScene(t); },
  d_sun(t, u) { cam(1120, 990, lerp(1.0, 1.08, u)); base(t); const y = parked(t, { deck: () => { homeDeco(t, -9)(); rr(-345, -168, 56, 50, 6, '#2a2d34'); for (let q = 0; q < 3; q++) { const ph = (t * 0.8 + q / 3) % 1; el(-318 + Math.sin(ph * 6) * 10, -180 - ph * 120, 12 + ph * 14, 10 + ph * 12, `rgba(230,230,235,${0.5 * (1 - ph)})`); } } }), gx = YP + AFT + 30; guyOnDeck(gx, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-60, -120], hr: [70, -260] }, y); X.save(); X.translate(gx + 70 * GS + 22, gyOf(y) - 260 * GS - 12); X.rotate(-0.3); fishShape(0, 0, 0.6, t, true); X.restore(); tint(t); },
  d_night(t, u) { const tc = ev('circling'), F = finAt(t, tc - 0.5); cam(lerp(1110, 1140, u), 1000, lerp(0.9, 1.0, sm(u))); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, { sleep: true }); if (t > tc - 0.5 && !F.front) fin(F.x, F.y - 30, t); const y = parked(t, { deck: homeDeco(t, -9) }); guyOnDeck(YP + AFT, t, { eyes: 'wide', mouth: 'flat', look: t > tc ? Math.sign(F.x - YP - AFT) : 0, sweat: t > tc, hl: [-60, -130], hr: [100, -190] }, y); if (t > tc - 0.5 && F.front) fin(F.x, F.y, t); tint(t); },
  d2_end(t, u) { const t0 = seg('d2_end').start, F = finAt(t, ev('circling') - 0.5); cam(lerp(1140, 1100, sm(u)), lerp(1000, 990, sm(u)), lerp(1.0, 1.1, sm(u))); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, { sleep: true }); if (!F.front) fin(F.x, F.y - 30, t); const y = parked(t, { deck: homeDeco(t, -9) }); guyOnDeck(YP + AFT, t, { eyes: 'open', brow: -0.6, mouth: 'smile', look: 0, sweat: true, hl: [-120, -260], hr: [120, -260] }, y); if (F.front) fin(F.x, F.y, t); tint(t);
    X.setTransform(1, 0, 0, 1, 0, 0); pill('DAY 3: COMMENT ONE WORD', 540, 300, '#ffd23f', INK, 62, after(t, t0, 0.3)); pill('TOP COMMENT GETS BUILT', 540, 430, 'rgba(14,15,22,.88)', '#fff', 50, after(t, ev('word'), 0.3)); },
};
// captions: 2-3 word chunks, bold, lower third
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 13 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const sh = shotAt(t), n = sh.name === 'end' ? 'd2_end' : sh.name, u = sh.name === 'end' ? 1 : sh.u; SCX = 0;
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); SC[n](t, u); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  const vg = X.createRadialGradient(540, 960, 600, 540, 960, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.3)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  if (n === 'd2_drop') { pill("BUT THERE'S A CATCH", 540, 250, 'rgba(255,210,63,.96)', INK, 64); pill('DAY 2', 540, 380, 'rgba(14,15,22,.88)', '#fff', 50); }
  const i = Math.min(sh.i, T.segs.length - 2), list = CH[i]; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (sh.name === 'end') cur = list[list.length - 1]; else if (!cur) cur = list[0]; if (cur) { const pop = 1 + 0.16 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1580); X.scale(pop, pop); X.font = '90px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 20; X.strokeStyle = '#14151c'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : '#ffd23f'; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
</script></body></html>
