// ================= DAY 2: the chained yacht =================
let SCX = 0;                        // sideways scroll for the towing shots
const YS = 0.9, YX0 = 1060;          // yacht scale and parked spot
const ANCHOR = () => [640, IY - 14];
function sternOf(x) { return [x - 230 * YS, WL - 46 * YS]; }
function shades(x, y, s, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s, s); rr(-62, -30, 56, 30, 10, '#14151c'); rr(6, -30, 56, 30, 10, '#14151c'); rr(-8, -26, 16, 6, 3, '#14151c'); el(-46, -22, 8, 4, 'rgba(255,255,255,.35)'); el(22, -22, 8, 4, 'rgba(255,255,255,.35)'); X.restore(); }
function yacht(x, y, s, t, o = {}) { X.save(); X.beginPath(); X.rect(-6000, -6000, 13000, y + 14 + 6000); X.clip(); X.translate(x, y); X.rotate(o.rot || 0); X.scale(s, s);
  rr(-6, -330, 8, 200, 3, '#8a929b'); X.fillStyle = '#e02424'; X.beginPath(); X.moveTo(2, -330); X.lineTo(70 + Math.sin(t * 8) * 6, -312); X.lineTo(2, -292); X.fill();
  rr(-210, -205, 220, 120, 18, '#f7f7f2'); for (let q = 0; q < 3; q++) rr(-190 + q * 66, -182, 50, 40, 8, '#2b4a7a'); rr(-218, -215, 236, 18, 8, '#d8dde3');
  X.fillStyle = '#9fd8ff'; X.beginPath(); X.moveTo(96, -150); X.lineTo(130, -150); X.lineTo(150, -92); X.lineTo(96, -92); X.fill(); X.strokeStyle = '#d8dde3'; X.lineWidth = 6; X.stroke();
  X.fillStyle = '#ffffff'; X.beginPath(); X.moveTo(-240, -92); X.lineTo(250, -100); X.quadraticCurveTo(220, -20, 170, 40); X.lineTo(-200, 40); X.quadraticCurveTo(-240, -20, -240, -92); X.fill();
  X.fillStyle = '#1f3b70'; X.beginPath(); X.moveTo(-236, -62); X.lineTo(236, -70); X.lineTo(226, -48); X.lineTo(-232, -40); X.fill(); X.fillStyle = '#d42d2d'; X.beginPath(); X.moveTo(-234, -36); X.lineTo(222, -44); X.lineTo(214, -34); X.lineTo(-230, -28); X.fill();
  X.strokeStyle = '#c3cad2'; X.lineWidth = 5; X.beginPath(); X.moveTo(-230, -126); X.lineTo(240, -132); X.stroke(); for (let q = 0; q < 8; q++) { X.beginPath(); X.moveTo(-200 + q * 60, -128); X.lineTo(-200 + q * 60, -94); X.stroke(); }
  X.font = '30px P'; X.textAlign = 'center'; X.fillStyle = '#1f3b70'; if (o.flip) { X.save(); X.translate(40, -4); X.scale(-1, 1); X.fillText(o.name || '', 0, 0); X.restore(); } else X.fillText(o.name || '', 40, -4);
  rr(54, -150, 10, 60, 4, '#6b6f78'); X.save(); X.translate(59, -152); X.rotate(o.wheel || 0); X.strokeStyle = '#8a5a30'; X.lineWidth = 7; X.beginPath(); X.arc(0, 0, 26, 0, 7); X.stroke(); for (let q = 0; q < 4; q++) { X.rotate(Math.PI / 4); X.beginPath(); X.moveTo(-30, 0); X.lineTo(30, 0); X.stroke(); } X.restore();
  if (o.lever != null) { X.save(); X.translate(20, -96); X.rotate(-0.5 + o.lever * 1.0); rr(-4, -60, 8, 60, 3, '#6b6f78'); el(0, -62, 11, 11, '#e02424'); X.restore(); }
  X.restore(); }
function chain(x0, y0, x1, y1, sag, t, appear = 1, buzz = 0) { const n = 26; X.save(); X.lineWidth = 6; X.strokeStyle = '#6f7782'; for (let i = 0; i < n; i++) { const f = (i + 0.5) / n; if (f > appear) break; let x = lerp(x0, x1, f), y = lerp(y0, y1, f) + Math.sin(f * Math.PI) * sag; y += Math.sin(f * Math.PI * 6 + t * 70) * buzz; const a = Math.atan2(y1 - y0 + Math.cos(f * Math.PI) * sag * Math.PI / n, x1 - x0); X.save(); X.translate(x, y); X.rotate(a); X.beginPath(); if (i % 2) X.ellipse(0, 0, 11, 6, 0, 0, 7); else { X.moveTo(-11, 0); X.lineTo(11, 0); } X.stroke(); X.restore(); } X.restore(); }
function underside(lift, t) { if (lift <= 0) return; X.fillStyle = '#7a5a3a'; X.beginPath(); X.moveTo(IX - 330, IY + 20); X.quadraticCurveTo(IX - 200, IY + 60 + 280 * lift, IX, IY + 40 + 320 * lift); X.quadraticCurveTo(IX + 200, IY + 60 + 280 * lift, IX + 330, IY + 20); X.fill(); X.strokeStyle = '#5a3d27'; X.lineWidth = 5; for (let q = 0; q < 6; q++) { X.beginPath(); X.moveTo(IX - 220 + q * 88, IY + 40); X.quadraticCurveTo(IX - 230 + q * 92, IY + 90 + 120 * lift, IX - 200 + q * 80 + Math.sin(t * 3 + q) * 10, IY + 110 + 200 * lift); X.stroke(); } el(IX - 120, IY + 90 + 80 * lift, 30, 22, '#8a8f99'); el(IX + 140, IY + 70 + 110 * lift, 24, 18, '#9aa0a8');
  X.save(); X.translate(IX + 60, IY + 60 + 160 * lift); X.rotate(Math.sin(t * 14) * 0.4); X.fillStyle = '#ff8a2a'; X.beginPath(); X.ellipse(0, 0, 26, 14, 0, 0, 7); X.fill(); X.beginPath(); X.moveTo(-22, 0); X.lineTo(-44, -14); X.lineTo(-44, 14); X.fill(); el(12, -3, 3.5, 3.5, INK); X.restore(); for (let q = 0; q < 5; q++) { const ph = (t * 1.6 + q / 5) % 1; el(IX - 250 + q * 120, IY + 40 + ph * 160 * lift + ph * 60, 7, 10, `rgba(170,220,255,${1 - ph})`); } }
function islandGroup(t, dx, dy, rot, lift, o = {}) { X.save(); X.translate(dx, dy); X.translate(IX, IY); X.rotate(rot); X.translate(-IX, -IY); underside(lift, t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, o); if (o.laugh) txt('HA HA', 300, IY - 100, 40, '#fff', 'center'); if (o.guy) o.guy(); X.restore(); }
function dolphin(x, y, s, t, ph) { const a = ph * Math.PI; const px = x + (ph - 0.5) * 300, py = y - Math.sin(a) * 180; if (ph <= 0 || ph >= 1) return; X.save(); X.translate(px, py); X.rotate(-Math.cos(a) * 0.9); X.scale(s, s); X.fillStyle = '#6f8fb3'; X.beginPath(); X.ellipse(0, 0, 70, 24, 0, 0, 7); X.fill(); X.beginPath(); X.moveTo(60, -6); X.lineTo(96, 0); X.lineTo(60, 8); X.fill(); X.beginPath(); X.moveTo(-6, -20); X.lineTo(10, -46); X.lineTo(22, -18); X.fill(); X.beginPath(); X.moveTo(-66, 0); X.lineTo(-96, -18); X.lineTo(-86, 0); X.lineTo(-96, 18); X.fill(); el(0, 8, 50, 12, '#c9d8ea'); el(40, -6, 4, 4, INK); X.restore(); }
function whaleR(x, y, s, t, blink, rise) { X.save(); X.beginPath(); X.rect(-6000, -6000, 13000, y + 10 + 6000); X.clip(); X.translate(x, y + (1 - rise) * 260); X.scale(s, s); el(0, 40, 260, 160, '#3f6fb0'); el(40, 110, 200, 90, '#a9c8e8'); el(200, 60, 80, 50, '#3f6fb0'); X.strokeStyle = '#2a3550'; X.lineWidth = 8; X.beginPath(); X.moveTo(150, 90); X.quadraticCurveTo(210, 110, 260, 80); X.stroke(); const op = blink ? 0.1 : 1; el(120, -30, 24, 24 * op, '#fff'); if (op > 0.5) { el(128, -28, 11, 11, INK); el(132, -33, 4, 4, '#fff'); } X.strokeStyle = INK; X.lineWidth = 6; X.beginPath(); X.moveTo(92, -66); X.lineTo(150, -60); X.stroke(); for (let q = 0; q < 3; q++) { const ph = (t * 1.1 + q / 3) % 1; el(-20 + Math.sin(q * 3) * 20, -140 - ph * 140, 16 + ph * 22, 20 + ph * 28, `rgba(255,255,255,${0.7 * (1 - ph)})`); } X.restore(); }
function gauge(x, y, s, f, t, a) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s * Math.min(1, a), s * Math.min(1, a)); rr(-190, -150, 380, 200, 40, 'rgba(14,15,22,.9)'); X.lineCap = 'round'; X.lineWidth = 22; X.strokeStyle = '#3a3f4c'; X.beginPath(); X.arc(0, 20, 120, Math.PI * 1.1, Math.PI * 1.9); X.stroke(); X.strokeStyle = '#e02424'; X.beginPath(); X.arc(0, 20, 120, Math.PI * 1.1, Math.PI * 1.25); X.stroke(); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = f < 0.05 && Math.sin(t * 14) > 0 ? '#ff4040' : '#fff'; X.fillText('E', -130, -40); X.fillStyle = '#fff'; X.fillText('F', 130, -40); const an = Math.PI * (1.1 + 0.8 * f); X.strokeStyle = '#ffd23f'; X.lineWidth = 9; X.beginPath(); X.moveTo(0, 20); X.lineTo(Math.cos(an) * 104, 20 + Math.sin(an) * 104); X.stroke(); el(0, 20, 14, 14, '#ffd23f'); X.restore(); }
function smoke(t, t0, x, y, n, col) { for (let q = 0; q < n; q++) { const ph = ((t - t0) * 1.4 + q / n) % 1; if (t < t0) return; el(x - ph * 120, y - ph * 140, 18 + ph * 34, 16 + ph * 30, col.replace('A', (0.7 * (1 - ph)).toFixed(2))); } }
function card(t, a, hl) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); const k = 0.9 + 0.1 * Math.min(1, a); X.translate(540, 470); X.scale(k, k); rr(-470, -170, 940, 340, 40, '#ffffff'); el(-380, -90, 54, 54, '#b8bcc4'); for (const [dx, dy] of [[-16, -6], [14, -6]]) el(-380 + dx, -96 + dy, 6, 9, '#6b6f78'); rr(-392, -70, 24, 6, 3, '#6b6f78'); X.textAlign = 'left'; X.font = '40px P'; X.fillStyle = '#8a8f99'; X.fillText('@stupider8', -306, -96); X.font = '50px P'; X.fillStyle = INK; X.fillText('give him a yacht that is', -306, -26); X.fillStyle = hl ? '#e02424' : INK; X.fillText('chained to the island', -306, 38); X.fillStyle = INK; X.fillText("so it can't leave", -306, 102); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.textAlign = 'right'; X.fillText('♥ 19', 440, -96); if (hl) { X.strokeStyle = '#e02424'; X.lineWidth = 6; X.beginPath(); X.moveTo(-306, 50); X.lineTo(-306 + 520, 50); X.stroke(); } X.restore(); }
function guyOnDeck(x, t, o) { guy(x, WL - 64 * YS, 0.55, Object.assign({ hair: 'slick' }, o), t); }
function bulbGlow(x, y, a) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(a, a); X.shadowColor = '#ffe58a'; X.shadowBlur = 50; el(0, 0, 40, 44, '#ffe58a'); X.shadowBlur = 0; rr(-16, 38, 32, 24, 5, '#9aa4ad'); X.restore(); }
// ---------- scenes ----------
const SC = {
  d2_drop(t, u) { const ts = ev('splash'), f = cl(t / ts); cam(720, 1010, 0.95); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); const y = t < ts ? lerp(640, WL, f * f) : WL + Math.sin((t - ts) * 9) * 10 * Math.exp(-(t - ts) * 2.5);
    if (t < ts) { X.strokeStyle = 'rgba(255,255,255,.7)'; X.lineWidth = 6; for (let q = 0; q < 5; q++) { X.beginPath(); X.moveTo(1020 + q * 60, y - 260 - q * 20); X.lineTo(1020 + q * 60, y - 420 - q * 20); X.stroke(); } }
    yacht(YX0, y, YS, t, { rot: (1 - f) * 0.2, name: 'STUPIDER8' }); if (t > ts) { const e = t - ts; el(YX0, WL, 300 * Math.min(1, e * 4), 50 * Math.max(0, 1 - e), `rgba(255,255,255,${Math.max(0, 0.9 - e)})`); drops(t, ts, YX0 - 150, WL, 14); drops(t, ts + 0.05, YX0 + 150, WL, 14); }
    guy(HX, HY, 0.62, { hair: 'slick', eyes: t < ts ? 'wide' : 'happy', mouth: t < ts ? 'shock' : 'grin', look: 1, lookY: t < ts ? -1 : 0, hl: t < ts ? [-90, -150] : [-110, -330], hr: t < ts ? [90, -150] : [110, -330], bob: t > ts ? -Math.abs(Math.sin(t * 9)) * 16 : 0 }, t); },
  d2_recap(t, u) { const t0 = seg('d2_recap').start, e = t - t0, f = cl(e / 1.5); X.save(); X.filter = 'sepia(0.85) brightness(1.05)'; cam(600, 1010, 0.95); sky(t); whale(900, 1100 + cl((e - 1.2) / 1) * 260, 0.85, e < 0.3 ? 1 : cl(1 - (e - 0.3) / 0.3), t); island(t); palm(650, IY - 8, 1.0, t);
    if (f < 1) { const x = lerp(760, HX, f), y = lerp(990, HY, f) - Math.sin(Math.PI * f) * 560; X.save(); X.translate(x, y - 130); X.rotate(-f * 7); guy(0, 130, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'shock', hl: [-110, -330], hr: [110, -330] }, t); X.restore(); } else guy(HX, HY, 0.62, { hair: 'slick', eyes: 'closed', mouth: 'o', squash: pulse(t, t0 + 1.5, 0.35), hl: [-90, -120], hr: [90, -120] }, t); X.restore(); X.filter = 'none';
    X.setTransform(1, 0, 0, 1, 0, 0); pill('◀◀ YESTERDAY', 230, 150, 'rgba(14,15,22,.85)', '#fff', 44); },
  d2_rule(t, u) { const t0 = seg('d2_rule').start, tc = ev('chain'), r = cl((t - t0) / 0.9); cam(740, 1010, 0.95); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); yacht(YX0, WL + Math.sin(t * 2) * 4, YS, t, { name: 'STUPIDER8' });
    const st = sternOf(YX0), an = ANCHOR(); if (t > tc) { const d = cl((t - tc) / 0.35); chain(an[0], an[1] - (1 - d) * 500, st[0], st[1] - (1 - d) * 500, 60, t); }
    if (r < 1) { const x = lerp(HX, YX0 - 40, sm(r)), y = r < 0.6 ? HY : lerp(HY, WL - 64 * YS, cl((r - 0.6) / 0.4)) - Math.sin(cl((r - 0.6) / 0.4) * Math.PI) * 120; guy(x, y, lerp(0.62, 0.55, r), { hair: 'slick', eyes: 'happy', mouth: 'grin', look: 1, hl: [-110, -300], hr: [110, -300], bob: -Math.abs(Math.sin(t * 14)) * 10 }, t); } else guyOnDeck(YX0 - 40, t, { eyes: 'happy', mouth: 'grin', look: 1, hl: [-100, -300], hr: [100, -300], bob: -Math.abs(Math.sin(t * 8)) * 8 }); },
  d2_card(t, u) { cam(760, 1090, 0.95); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); yacht(YX0, WL + Math.sin(t * 2) * 4, YS, t, { name: 'STUPIDER8' }); const st = sternOf(YX0), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 60, t); guyOnDeck(YX0 - 40, t, { eyes: 'happy', mouth: 'grin', look: 1, hl: [-100, -300 + Math.sin(t * 8) * 30], hr: [100, -300 - Math.sin(t * 8) * 30], bob: -Math.abs(Math.sin(t * 8)) * 8 });
    X.setTransform(1, 0, 0, 1, 0, 0); card(t, after(t, ev('card'), 0.3), t > ev('chained')); },
  d2_party(t, u) { cam(lerp(930, 950, u), 1000, lerp(1.2, 1.28, u)); sky(t); island(t); palm(650, IY - 8, 1.0, t); const lookChain = t > ev('fine'); gullBird(258, IY + 8, 1.0, t, {}); yacht(YX0, WL + Math.sin(t * 2) * 4, YS, t, { name: 'STUPIDER8' }); const st = sternOf(YX0), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 60, t);
    const gx = YX0 - 40 + Math.sin(t * 5) * 30; guyOnDeck(gx, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-120, -280 + Math.sin(t * 10) * 50], hr: [120, -280 - Math.sin(t * 10) * 50], bob: -Math.abs(Math.sin(t * 10)) * 12, tilt: Math.sin(t * 5) * 0.12 }); shades(gx + Math.sin(t * 5) * 30 * 0.12, WL - 64 * YS - 330 * 0.55 - 10 - Math.abs(Math.sin(t * 10)) * 12 * 0.55, 0.55, 1);
    if (lookChain) { X.save(); X.setTransform(1, 0, 0, 1, 0, 0); pill('...', 300, 700, 'rgba(14,15,22,.8)', '#fff', 44, after(t, ev('fine'), 0.3)); X.restore(); } },
  d2_go(t, u) { const tg = ev('go'), e = Math.max(0, t - tg), x = YX0 + Math.min(85, e * e * 120); cam(820, 1010, 0.95); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); yacht(x, WL, YS, t, { name: 'STUPIDER8', lever: cl(e * 2), wheel: Math.sin(t * 6) * 0.2 }); const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 60 * (1 - (x - YX0) / 85), t); for (let q = 0; q < 4; q++) { const ph = (t * 2 + q / 4) % 1; el(st[0] - ph * 120, WL + 6, 40 * (1 - ph), 8, `rgba(255,255,255,${0.8 * (1 - ph)})`); }
    guyOnDeck(x + 10, t, { eyes: 'angry', brow: 1, mouth: 'grin', look: 1, hl: [80, -180], hr: [100, -200], tilt: 0.08 }); shades(x + 10 + 10, WL - 64 * YS - 330 * 0.55 - 10, 0.55, 1); },
  d2_snap(t, u) { const ts = ev('snap'), e = t - ts, x = YX0 + 85 - (e > 0 ? Math.min(20, e * 160) : 0); cam(1060, 990, 1.15 + pulse(t, ts, 0.3) * 0.06); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullSpot2(t); yacht(x, WL, YS, t, { name: 'STUPIDER8', lever: 1, rot: pulse(t, ts, 0.3) * 0.05 }); const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 0, t, 1, e > 0 && e < 0.4 ? 6 * (1 - e / 0.4) : 0);
    const fly = cl(e / 0.18), gx = x + 10 + fly * 80; guyOnDeck(gx, t, { eyes: e > 0.1 ? 'closed' : 'angry', mouth: e > 0.1 ? 'o' : 'grin', look: 1, hl: [-60, -200], hr: [60, -200], squash: e > 0.18 && e < 0.6 ? -0.5 : 0, tilt: fly * 0.3 }); if (e > 0.18) stars(gx, WL - 64 * YS - 300 * 0.55, t, ts + 0.18); X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, -0.08, (t - ts - 0.5) / 0.15, '#e02424', 120); },
  d2_try(t, u) { if (t > ev('circ')) return orbitScene(t, 0.82); const tl = ev('lever'), e = Math.max(0, t - tl), vib = Math.sin(t * 70) * 4 * cl(e * 3), x = YX0 + 65 + vib; cam(790, 1010, 0.95); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); yacht(x, WL, YS, t, { name: 'STUPIDER8', lever: t > tl ? 1.2 : 0.5 }); const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 0, t, 1, 3 * cl(e)); smoke(t, tl, st[0], st[1] - 20, 6, 'rgba(60,60,70,A)'); guyOnDeck(x + 10, t, { eyes: 'angry', brow: 1, mouth: 'frown', look: 1, hl: [60, -150], hr: [100, -200], tilt: 0.12, sweat: true }); },
  d2_circle(t, u) { orbitScene(t, 0.82); },
  d2_gas(t, u) { const to = ev('out'); orbitScene(t, 0.82); X.setTransform(1, 0, 0, 1, 0, 0); gauge(540, 400, 1.0, Math.max(0, 0.3 - Math.max(0, t - to + 0.5) * 0.4), t, after(t, to - 0.5, 0.3)); },
  d2_stop(t, u) { cam(lerp(900, 960, u), 1000, lerp(1.1, 1.2, u)); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); parked(t); guyOnDeck(YX0 + 30, t, { eyes: 'closed', mouth: 'frown', look: -1, hl: [-60, -110], hr: [60, -110], tilt: -0.06, bob: 6 }); },
  d2_home(t, u) { const th = ev('home'); cam(960, 990, 1.2); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); homeStuff(t, th); parked(t); homeFront(t, th); guyOnDeck(YX0 + 115, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-90, -130], hr: [110, -200] }); if (t > th + 0.7) { el(YX0 + 115 + 62, WL - 64 * YS - 200 * 0.55, 16, 18, '#7a4a26'); rr(YX0 + 115 + 58, WL - 64 * YS - 236 * 0.55, 3, 22, 1, '#ff6aa8'); } },
  d2_fish(t, u) { fishScene(t); },
  d_sun(t, u) { const td = ev('dinner'); cam(960, 990, lerp(1.15, 1.25, u)); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); homeStuff(t, -9); parked(t); homeFront(t, -9); const gx = YX0 + 115; rr(gx + 70, WL - 64 * YS - 70, 60, 50, 6, '#2a2d34'); for (let q = 0; q < 3; q++) { const ph = (t * 0.8 + q / 3) % 1; el(gx + 100 + Math.sin(ph * 6) * 10, WL - 64 * YS - 80 - ph * 120, 12 + ph * 14, 10 + ph * 12, `rgba(230,230,235,${0.5 * (1 - ph)})`); } guyOnDeck(gx, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-60, -120], hr: [70, -260] }); X.save(); X.translate(gx + 70 * 0.55 + 20, WL - 64 * YS - 260 * 0.55 - 10); X.rotate(-0.3); fishShape(0, 0, 0.6, t, true); X.restore(); tint(t); },
  d_night(t, u) { const tc = ev('circling'); cam(lerp(940, 1000, u), lerp(1000, 990, u), lerp(1.0, 1.15, sm(u))); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, { sleep: true }); txt('z', 300 + Math.sin(t * 2) * 6, IY - 70 - ((t * 30) % 40), 34, '#fff', 'center', 0.8); homeStuff(t, -9); parked(t); homeFront(t, -9); const a = (t - tc + 0.5) * 1.3; if (t > tc - 0.5) { const fx = YX0 + 115 + Math.cos(a) * 380, fy = WL + 34 + Math.sin(a) * 60; if (Math.sin(a) < 0) { X.save(); X.globalAlpha = 0.85; fin(fx, fy - 20, t); X.restore(); } }
    guyOnDeck(YX0 + 115, t, { eyes: 'wide', mouth: 'flat', look: t > tc ? Math.cos((t - tc) * 1.3 + 1.6) : 0, sweat: t > tc, hl: [-60, -130], hr: [100, -190] }); if (t > tc - 0.5) { const fx = YX0 + 115 + Math.cos(a) * 380, fy = WL + 34 + Math.sin(a) * 60; if (Math.sin(a) >= 0) fin(fx, fy, t); } tint(t); },
  d2_end(t, u) { const t0 = seg('d2_end').start, a = (t - ev('circling') + 0.5) * 1.3; cam(lerp(1000, 980, sm(u)), lerp(990, 980, sm(u)), lerp(1.15, 1.25, sm(u))); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, { sleep: true }); homeStuff(t, -9); parked(t); homeFront(t, -9); const fx = YX0 + 115 + Math.cos(a) * 380, fy = WL + 34 + Math.sin(a) * 60; if (Math.sin(a) < 0) fin(fx, fy - 20, t); guyOnDeck(YX0 + 115, t, { eyes: 'open', brow: -0.6, mouth: 'smile', look: 0, sweat: true, hl: [-120, -260], hr: [120, -260] }); if (Math.sin(a) >= 0) fin(fx, fy, t); tint(t);
    X.setTransform(1, 0, 0, 1, 0, 0); pill('DAY 3: COMMENT ONE WORD', 540, 300, '#ffd23f', INK, 62, after(t, t0, 0.3)); pill('TOP COMMENT GETS BUILT', 540, 430, 'rgba(14,15,22,.88)', '#fff', 50, after(t, ev('word'), 0.3)); },
};
// orbit: the yacht can only go round and round the island on its chain
const ORX = 585, ORY = 210;
function orbitA(t) { const c = ev('circ'), e = ev('out') + 1.0; return Math.PI * 4 * sm(cl((t - c) / (e - c))); }
function yachtAt(t, a, s0) { const x = IX + ORX * Math.cos(a), y = WL - 20 + ORY * Math.sin(a) + 20, s = YS * (1 + 0.25 * Math.sin(a)), flip = Math.sin(a) > 0.02 || (Math.sin(a) > -0.02 && Math.cos(a) < 0 && false); return { x, y, s, flip }; }
function drawOrbitYacht(t, Y, guyO) { const st = [Y.x + (Y.flip ? 230 : -230) * Y.s, Y.y - 46 * Y.s], an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 0, t); X.save(); X.translate(Y.x, Y.y); X.scale(Y.flip ? -1 : 1, 1); yacht(0, 0, Y.s, t, { name: 'STUPIDER8', lever: 1.2, flip: Y.flip }); guy(10, -64 * Y.s, 0.55 * Y.s / YS, Object.assign({ hair: 'slick' }, guyO), t); X.restore(); for (let q = 0; q < 5; q++) { const ph = (t * 3 + q / 5) % 1; el(st[0] + (Y.flip ? 1 : -1) * ph * 140, Y.y + 6, 50 * (1 - ph), 9, `rgba(255,255,255,${0.75 * (1 - ph)})`); } }
function orbitScene(t, z) { const a = orbitA(t), Y = yachtAt(t, a), moving = t < ev('out') + 0.9, dizzy = t > ev('circ') + 0.8; cam(560, 1040, 0.68); sky(t); X.save(); X.globalAlpha = moving ? 0.5 : 0.2; X.strokeStyle = '#fff'; X.lineWidth = 8; X.setLineDash([30, 24]); X.beginPath(); X.ellipse(IX, WL, ORX, ORY, 0, 0, 7); X.stroke(); X.setLineDash([]); X.restore();
  const go = { eyes: moving ? 'angry' : 'wide', brow: moving ? 1 : 0, mouth: moving ? 'grin' : 'shock', look: 1, hl: [60, -150], hr: [100, -200], tilt: moving ? 0.1 : 0 };
  if (Math.sin(a) < 0) drawOrbitYacht(t, Y, go); island(t); palm(650, IY - 8, 1.0, t); const L = t > ev('ha2') && t < ev('ha2') + 0.6; gullBird(258, IY + 8, 1.0, t, { laugh: L }); if (L) txt('HA HA', 300, IY - 100, 40, '#fff', 'center'); if (dizzy && moving) for (let q = 0; q < 3; q++) { const an2 = t * 6 + q * 2.1; txt('✦', 280 + Math.cos(an2) * 40, IY - 90 + Math.sin(an2) * 10, 28, '#ffd23f'); } if (Math.sin(a) >= 0) drawOrbitYacht(t, Y, go); }
function parked(t) { const x = YX0 + 65, Y = { x, y: WL, s: YS, flip: false }; const st = sternOf(x), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 30, t); yacht(x, WL + Math.sin(t * 2) * 3, YS, t, { name: 'STUPIDER8' }); }
function homeStuff(t, th) { const x = YX0 + 65, top = WL - 205 * YS; const a2 = after(t, th + 0.3, 0.25); if (a2 > 0) { X.strokeStyle = '#8a929b'; X.lineWidth = 3; const x0 = x - 200 * YS, x1 = x + 2 * YS, yl = WL - 300 * YS; X.beginPath(); X.moveTo(x0, yl + 40); X.quadraticCurveTo((x0 + x1) / 2, yl + 70, x1, yl); X.stroke(); rr(x0 - 4, yl + 40, 8, 110, 3, '#8a929b'); X.save(); X.globalAlpha = Math.min(1, a2); for (const [fx, col, w] of [[0.25, '#e02424', 46], [0.5, '#ffd23f', 30], [0.72, '#3d7bd9', 40]]) { const px = lerp(x0, x1, fx), py = lerp(yl + 40, yl, fx) + Math.sin(fx * Math.PI) * 24; X.save(); X.translate(px, py); X.rotate(Math.sin(t * 3 + fx * 9) * 0.12); rr(-w / 2, 0, w, w * 1.1, 6, col); X.restore(); } X.restore(); } }
function homeFront(t, th) { const x = YX0 + 65; const a1 = after(t, th + 0.1, 0.25); if (a1 > 0) { X.save(); X.translate(x - 96 * YS, WL - 158 * YS); X.scale(a1 * 0.85, a1 * 0.85); rr(-70, -34, 140, 60, 10, '#c98d4f'); X.font = '38px P'; X.textAlign = 'center'; X.fillStyle = '#4a2f1a'; X.fillText('HOME', 0, 12); X.restore(); } const a3 = after(t, th + 0.5, 0.25); if (a3 > 0) { X.save(); X.translate(x + 180 * YS, WL - 92 * YS); X.scale(a3, a3); X.fillStyle = '#c0603a'; X.beginPath(); X.moveTo(-22, -30); X.lineTo(22, -30); X.lineTo(16, 0); X.lineTo(-16, 0); X.fill(); for (let q = 0; q < 4; q++) { X.save(); X.translate(0, -30); X.rotate((q - 1.5) * 0.4); el(0, -24, 9, 22, '#55b062'); X.restore(); } X.restore(); } }
function fishShape(x, y, s, t, cooked) { X.save(); X.translate(x, y); X.scale(s, s); X.rotate(cooked ? 0 : Math.sin(t * 18) * 0.3); X.fillStyle = cooked ? '#c9783a' : '#ff8a2a'; X.beginPath(); X.ellipse(0, 0, 60, 30, 0, 0, 7); X.fill(); X.beginPath(); X.moveTo(-50, 0); X.lineTo(-90, -28); X.lineTo(-90, 28); X.fill(); el(30, -6, 6, 6, INK); if (cooked) { X.strokeStyle = '#7a4a26'; X.lineWidth = 4; for (let q = 0; q < 3; q++) { X.beginPath(); X.moveTo(-20 + q * 20, -20); X.lineTo(-30 + q * 20, 20); X.stroke(); } } X.restore(); }
function bootShape(x, y, s, r) { X.save(); X.translate(x, y); X.rotate(r); X.scale(s, s); rr(-20, -60, 40, 70, 8, '#5a3d27'); rr(-20, -4, 70, 30, 12, '#5a3d27'); rr(-24, 20, 78, 8, 4, '#3a2a1e'); for (let q = 0; q < 3; q++) el(0, -40 + q * 14, 12, 3, '#d8c8a8'); X.restore(); }
function fishScene(t) { const tc = ev('cast'), tb = ev('boot'), tf = ev('catch'); cam(1000, 980, 1.2); sky(t); island(t); palm(650, IY - 8, 1.0, t); gullBird(258, IY + 8, 1.0, t, {}); homeStuff(t, -9); parked(t); homeFront(t, -9); const gx = YX0 + 115, hy = WL - 64 * YS; const hand = [gx + 100 * 0.55, hy - 210 * 0.55]; guyOnDeck(gx, t, { eyes: t > tf ? 'happy' : t > tb && t < tb + 0.8 ? 'angry' : 'open', mouth: t > tf ? 'grin' : t > tb && t < tb + 0.8 ? 'frown' : 'flat', look: 1, hl: [60, -160], hr: [100, -210] });
  const tip = [hand[0] + 150, hand[1] - 160 + (t > tb - 0.1 && t < tb + 0.2 || t > tf - 0.1 && t < tf + 0.3 ? 40 : 0)]; X.strokeStyle = '#6b4320'; X.lineWidth = 6; X.beginPath(); X.moveTo(hand[0], hand[1]); X.lineTo(tip[0], tip[1]); X.stroke();
  const cast = cl((t - tc) / 0.35), bobX = tip[0] + 60, bobY = WL + 10 + Math.sin(t * 4) * 4; let endP; if (t < tb) endP = [lerp(tip[0], bobX, cast), lerp(tip[1], bobY, cast) - Math.sin(cast * Math.PI) * 60]; else if (t < tb + 0.6) { const f = cl((t - tb) / 0.3); endP = [bobX - f * 30, lerp(bobY, tip[1] + 120, f)]; } else if (t < tf) endP = [bobX, bobY]; else { const f = cl((t - tf) / 0.3); endP = [bobX - f * 30, lerp(bobY, tip[1] + 130, f)]; }
  X.strokeStyle = 'rgba(255,255,255,.85)'; X.lineWidth = 2; X.beginPath(); X.moveTo(tip[0], tip[1]); X.lineTo(endP[0], endP[1]); X.stroke(); if (t < tb || (t > tb + 0.6 && t < tf)) { el(endP[0], endP[1], 8, 8, '#e02424'); }
  if (t >= tb && t < tb + 0.6) bootShape(endP[0], endP[1] + 30, 0.8, Math.sin(t * 10) * 0.2); if (t >= tb + 0.6 && t < tb + 1.4) { const f = (t - tb - 0.6) / 0.8; bootShape(lerp(bobX, 1500, f), lerp(tip[1] + 120, 900, f) + f * f * 500, 0.8, f * 9); }
  if (t >= tf) fishShape(endP[0], endP[1] + 40, 0.9, t, false); X.setTransform(1, 0, 0, 1, 0, 0); stamp('NOPE', 540, 370, -0.08, (t - tb - 0.15) / 0.15 * (t < tb + 0.9 ? 1 : 0), '#e02424', 110); stamp('DINNER', 540, 370, 0.06, (t - tf - 0.2) / 0.15, '#2a8a3e', 110); }
function gullSpot2(t) { const L = t > ev('ha1') && t < ev('ha1') + 0.6; gullBird(258, IY + 8, 1.0, t, { laugh: L }); if (L) txt('HA HA', 300, IY - 100, 40, '#fff', 'center'); }
// captions: 2-3 word chunks, bold, lower third
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 13 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const sh = shotAt(t), n = sh.name === 'end' ? 'd2_end' : sh.name, u = sh.name === 'end' ? 1 : sh.u; SCX = 0;
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); SC[n](t, u); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  const vg = X.createRadialGradient(540, 960, 600, 540, 960, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.3)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  if (n === 'd2_drop') { pill("BUT THERE'S A CATCH", 540, 250, 'rgba(255,210,63,.96)', INK, 64); pill('DAY 2', 540, 380, 'rgba(14,15,22,.88)', '#fff', 50); }
  const i = Math.min(sh.i, T.segs.length - 2), list = CH[i]; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (sh.name === 'end') cur = list[list.length - 1]; else if (!cur) cur = list[0]; if (cur) { const pop = 1 + 0.16 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1580); X.scale(pop, pop); X.font = '90px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 20; X.strokeStyle = '#14151c'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : '#ffd23f'; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
</script></body></html>
