  if (storm) { const sk = at('w_sink') ? 0 : at('w_alone') ? sm(u) : 1; boat(-430, SEA - 30 + Math.sin(t * 3) * 14, -0.15 + Math.sin(t * 2.2) * 0.08 - sk * 0.5, sk * 260);
    if (at('w_sink') || at('w_alone')) person(-470, SEA - 70 + Math.sin(t * 3) * 14 + (at('w_alone') ? sk * 120 : 0), 0.9, 'breath', t);
    if (at('w_swim')) { const px = lerp(-120, 80, u), py = SEA + 8 + Math.sin(t * 2.5) * 8; X.save(); X.translate(px, py); X.rotate(0.3 + Math.sin(t) * 0.1); X.fillStyle = '#fbfaf5'; X.fillRect(-26, -22, 52, 44); X.fillStyle = '#8cc8f0'; X.fillRect(-21, -18, 42, 30); X.fillStyle = '#c0563a'; X.fillRect(-14, -6, 7, 16); X.fillStyle = '#3d7bd9'; X.fillRect(-4, -9, 7, 19); X.fillStyle = '#e0b030'; X.fillRect(6, 0, 5, 10); X.restore(); }
    if (at('w_swim')) { const x = lerp(-380, 640, sm(u)), y = SEA + 14 + Math.sin(t * 3 + x * 0.01) * 10; X.fillStyle = '#f1c7a4'; X.beginPath(); X.arc(x, y - 18, 22, 0, 7); X.fill(); X.strokeStyle = '#3d7bd9'; X.lineWidth = 12; X.lineCap = 'round'; const s = Math.sin(t * 6); X.beginPath(); X.moveTo(x - 10, y); X.lineTo(x + 30 + s * 20, y - 28 + Math.abs(s) * 18); X.stroke(); X.beginPath(); X.moveTo(x - 6, y + 4); X.lineTo(x - 40 - s * 20, y - 10); X.stroke(); X.fillStyle = 'rgba(255,255,255,.8)'; X.beginPath(); X.ellipse(x - 50, y + 4, 30, 6, 0, 0, 7); X.fill(); } }
  if (at('w_wash')) { X.save(); X.translate(720, bY(720) - 22); X.rotate(-Math.PI / 2 + 0.05); person(0, 0, 1.0, 'stand', 0); X.restore(); }
  if (at('w_inv')) person(900, bY(900), 1.2, 'stand', t);
  if (at('w_water')) person(STILL_X + 190, bY(STILL_X + 190), 1.15, u < 0.3 ? 'dig' : 'stand', t);
  if (at('w_shelter')) person(SHEL_X + 200, bY(SHEL_X + 200), 1.15, 'breath', t);
  if (at('w_fire')) { X.save(); X.translate(FIRE_X - 90, bY(FIRE_X) - 10); person(0, 0, 1.1, u < 0.75 ? 'saw' : 'stand', t); X.restore(); }
  if (at('w_night')) { X.save(); X.translate(FIRE_X + 170, bY(FIRE_X + 170) - 24); X.rotate(-Math.PI / 2); person(0, 0, 1.0, 'stand', 0); X.restore(); for (let q = 0; q < 3; q++) { const ph = (t * 0.5 + q / 3) % 1; txt('z', FIRE_X + 110 + ph * 30, bY(FIRE_X) - 80 - ph * 80, 34 + q * 6, '#cfd8ff', 'center', (1 - ph) * sm(u / 0.3)); } }
  if (at('w_sos')) person(BEACON_X + 140, bY(BEACON_X + 140), 1.15, 'stand', t);
  if (at('w_gone')) person(BEACON_X + 120, bY(BEACON_X + 120), 1.15, 'breath', t);
  if (at('w_morning')) person(lerp(FIRE_X + 100, 880, sm(u)), bY(lerp(FIRE_X + 100, 880, sm(u))), 1.15, 'stand', t);
  if (at('w_prints')) person(800, bY(800), 1.15, 'breath', t);
  // ----- sea on top (so the underwater slope shows through) -----
  X.fillStyle = night > 0.5 ? 'rgba(10,30,50,.88)' : 'rgba(31,111,158,.82)'; waterPath(t, storm); X.fill();
  X.strokeStyle = 'rgba(255,255,255,.5)'; X.lineWidth = 4; X.beginPath(); for (let x = -3000; x <= 760; x += 20) { const y = SEA + Math.sin(x * 0.012 + t * (storm ? 3 : 1.2)) * (storm ? 22 : 6) + Math.sin(x * 0.031 - t * 2) * (storm ? 10 : 3); x === -3000 ? X.moveTo(x, y) : X.lineTo(x, y); } X.stroke();
  // inventory items
  if (at('w_inv')) { const items = [['KNIFE', 0.18], ['TARP', 0.3], ['WATER', 0.42], ['BEACON', 0.62]]; items.forEach(([n, at0], i) => { const s = back((u - at0) / 0.12); if (s <= 0) return; X.save(); X.translate(650 + i * 165, 700); X.scale(s * 1.45, s * 1.45);
      if (i === 0) { X.fillStyle = '#c9d0d6'; X.beginPath(); X.moveTo(-40, 0); X.lineTo(30, -10); X.lineTo(30, 6); X.fill(); X.fillStyle = '#5a3a20'; X.fillRect(30, -10, 30, 16); }
      if (i === 1) { X.fillStyle = '#3a6fb0'; X.beginPath(); X.roundRect(-40, -30, 80, 60, 10); X.fill(); X.strokeStyle = '#2a5a90'; X.lineWidth = 3; X.beginPath(); X.moveTo(-40, 0); X.lineTo(40, 0); X.stroke(); }
      if (i === 2) { X.fillStyle = 'rgba(160,220,255,.8)'; X.beginPath(); X.roundRect(-18, -46, 36, 80, 10); X.fill(); X.fillStyle = '#2a7ab8'; X.fillRect(-10, -58, 20, 14); }
      if (i === 3) { X.fillStyle = '#f2b81c'; X.beginPath(); X.roundRect(-18, -50, 36, 70, 8); X.fill(); X.fillStyle = '#ff3030'; X.beginPath(); X.arc(-4, -56, 10, Math.PI, 0); X.fill(); X.strokeStyle = '#333'; X.lineWidth = 3; X.beginPath(); X.moveTo(10, -50); X.lineTo(14, -90); X.stroke(); }
      X.restore(); txt(n, 650 + i * 165, 600, 30, '#ffd23f', 'center', cl(s)); }); }
  // labels
  label('SOLAR STILL', STILL_X, bY(STILL_X) + 10, STILL_X + 15, bY(STILL_X) - 230, at('w_water') ? cl((u - 0.7) / 0.12) : 0);
  label('OFF THE GROUND', SHEL_X - 60, bY(SHEL_X) - 34, SHEL_X - 40, bY(SHEL_X) - 260, at('w_shelter') ? cl((u - 0.45) / 0.15) : 0);
  if (flash > 0) { X.fillStyle = `rgba(230,235,255,${0.55 * flash})`; X.fillRect(-4000, -2000, 9000, 6000); }
  X.restore();
  // rain
  if (storm) { X.strokeStyle = 'rgba(190,210,240,.35)'; X.lineWidth = 2; for (let q = 0; q < 120; q++) { const x = (q * 97 + t * 500) % (W + 300) - 150, y = (q * 211 + t * 2600) % (H + 200) - 100; X.beginPath(); X.moveTo(x, y); X.lineTo(x - 18, y + 46); X.stroke(); } }
  // aerial shots
  if (at('w_wash')) aerial(t, lerp(3.2, 1.0, sm((u - 0.35) / 0.55)), 0, 0, sm((u - 0.35) / 0.2));
  if (at('w_sos') && u > 0.7) { const a = sm((u - 0.7) / 0.1); X.fillStyle = `rgba(0,0,0,${0.55 * a})`; X.beginPath(); X.roundRect(300, 1560, 480, 110, 26); X.fill(); txt('SENDING YOUR LOCATION', 540, 1632, 40, '#ffd23f', 'center', a); }
  // vignette
  const vg = X.createRadialGradient(540, 960, 520, 540, 960, 1200); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.45)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  // text hook (frame 0)
  if (t < 3.6) { const a = 1 - sm((t - 3.2) / 0.4), p = 1 + 0.05 * Math.sin(t * 6); X.save(); X.globalAlpha = a; X.translate(540, 1690); X.scale(p, p); X.fillStyle = '#d42d2d'; X.beginPath(); X.roundRect(-420, -50, 840, 96, 22); X.fill(); X.restore(); txt("NOBODY KNOWS YOU'RE OUT HERE", 540, 1708, 48, '#fff', 'center', a);
    X.save(); X.globalAlpha = a; X.fillStyle = '#ffd23f'; X.beginPath(); X.roundRect(250, 1770, 580, 90, 45); X.fill(); X.restore(); txt('NEW SERIES · PART 1', 540, 1830, 44, '#10141c', 'center', a); }
  if (at('w_gone')) { const a = sm((u - 0.2) / 0.15); X.fillStyle = `rgba(0,0,0,${0.55 * a})`; X.beginPath(); X.roundRect(330, 1560, 420, 110, 26); X.fill(); txt('NEXT MORNING', 540, 1632, 46, '#fff', 'center', a); label2off(u); }
  // choice screen
  if (at('w_ask') || at('end')) { const a = at('w_ask') ? sm((u - 0.38) / 0.12) : 1; if (a > 0) { X.fillStyle = `rgba(6,8,14,${0.84 * a})`; X.fillRect(0, 0, W, H);
    txt('PART 2: YOU DECIDE', 540, 420, 70, '#ffd23f', 'center', a); txt('Someone switched it off.', 540, 505, 46, '#ffffff', 'center', a); txt("They don't want you rescued.", 540, 570, 46, '#ff6a5a', 'center', a);
    const opts = [['1', 'Follow the footprints', '#6af0a8'], ['2', 'Turn it on, stay up and watch', '#5ec3ff'], ['3', 'Set a trap', '#ff8a5e']];
    opts.forEach(([n, s2, col], i) => { const b = at('w_ask') ? back((u - 0.45 - i * 0.07) / 0.15) : 1; if (b <= 0) return; X.save(); X.translate(540, 790 + i * 240); X.scale(b, b); X.globalAlpha = a; X.fillStyle = 'rgba(255,255,255,.08)'; X.beginPath(); X.roundRect(-470, -95, 940, 190, 36); X.fill(); X.strokeStyle = col; X.lineWidth = 6; X.stroke();
      X.fillStyle = col; X.beginPath(); X.arc(-370, 0, 62, 0, 7); X.fill(); txt(n, -370, 26, 76, '#10141c'); txt(s2, -275, 18, 44, '#fff', 'left'); X.restore(); });
    txt('Comment 1, 2 or 3', 540, 1560, 54, '#fff', 'center', a); txt('Top comment decides.', 540, 1640, 48, '#ffd23f', 'center', a); } }
  // captions
  if (!(at('w_ask') && u > 0.38) && !at('end')) { const seg = T.segs[sh.i]; let word = '', wt0 = 0; for (const [w, wt] of seg.words || []) if (t >= wt) { word = w; wt0 = wt; }
    if (word) { const pop = 1 + 0.12 * Math.exp(-(t - wt0) * 12); X.save(); X.translate(540, 300); X.scale(pop, pop); txt(word.replace(/[.,?]/g, '').toUpperCase(), 0, 0, 100, /reef|sinking|fast|alone|island|water|beacon|shelter|fire|smoke|rescuers|coming|off|footprints|yours|someone|rescued/i.test(word) ? '#ffd23f' : '#ffffff'); X.restore(); } }
};
</script></body></html>
