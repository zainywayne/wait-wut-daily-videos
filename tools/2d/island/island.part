      X.fillStyle = '#ddd'; X.fillRect(-12, -40, 24, 16); X.fillStyle = on ? '#3ad06a' : '#d03a3a'; X.fillRect(on ? -10 : 0, -38, 10, 12); X.restore();
    if (on) for (let q = 0; q < 4; q++) { const ph = (t * 0.5 + q / 4) % 1; X.strokeStyle = `rgba(255,80,80,${0.7 * (1 - ph)})`; X.lineWidth = 5; X.beginPath(); X.arc(BEACON_X + 22, by - 240, 20 + ph * 380, -2.4, -0.7); X.stroke(); } }
  // the morning: footprints into the jungle
