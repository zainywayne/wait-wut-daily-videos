// ================= DAY 4: a bag of bricks, concrete and wood =================
const HSX = 830, HSY = IY + 4, GI = 0.62;      // house spot, guy scale on the island
const BRICK = '#c4553a', BRICKD = '#a3442d', MORTAR = '#e8d9c4', WOOD = '#a8743a', WOODD = '#7a4a26';
function bricksRow(x, y, w, n, off) { for (let q = 0; q < n; q++) rr(x + q * (w / n) + (off ? -w / n / 2 : 0), y, w / n - 4, 22, 3, q % 3 ? BRICK : BRICKD); }
function house4(x, y, o = {}, t = 0) { const w = 200, h = 150, b = o.build == null ? 1 : o.build; X.save(); X.translate(x, y);
  const rows = Math.floor(b * 6); X.save(); X.beginPath(); X.rect(-w / 2, -h, w, h); X.clip(); rr(-w / 2, -h, w, h, 0, MORTAR); for (let r = 0; r < rows; r++) bricksRow(-w / 2, -26 - r * 25, w + w / 6, 6, r % 2); X.restore();
  if (b >= 1) { rr(-24, -84, 48, 84, 6, WOODD); rr(-20, -80, 40, 80, 4, WOOD); el(12, -40, 5, 5, '#ffd23f'); rr(44, -112, 40, 36, 4, '#9fd8ff'); X.strokeStyle = WOODD; X.lineWidth = 4; X.strokeRect(44, -112, 40, 36); }
  if (o.roof) { X.fillStyle = WOOD; X.beginPath(); X.moveTo(-w / 2 - 26, -h + 4); X.lineTo(0, -h - 92); X.lineTo(w / 2 + 26, -h + 4); X.closePath(); X.fill(); X.strokeStyle = WOODD; X.lineWidth = 4; for (let q = 1; q < 5; q++) { X.beginPath(); X.moveTo(-w / 2 - 26 + q * 25, -h + 4 - q * 18.4); X.lineTo(w / 2 + 26 - q * 25, -h + 4 - q * 18.4); X.stroke(); } }
  if (o.cut > 0) { X.save(); X.globalAlpha = Math.min(1, o.cut); rr(-w / 2 + 8, -h + 8, w - 16, h - 8, 4, '#5a3d27'); for (let s = 0; s < 3; s++) { rr(-w / 2 + 12, -h + 46 + s * 44, w - 24, 6, 2, WOOD); for (let q = 0; q < 5; q++) { if ((q + s) % 2) coconut(-w / 2 + 34 + q * 34, -h + 32 + s * 44, 0.7); else { X.save(); X.translate(-w / 2 + 34 + q * 34, -h + 34 + s * 44); fishShape(0, 0, 0.32, 0, true); X.restore(); } } } X.restore(); }
  if (o.sign) { X.save(); X.translate(0, -h - 20); X.rotate(-0.05); rr(-70, -22, 140, 40, 8, '#fff'); X.strokeStyle = '#e02424'; X.lineWidth = 5; X.strokeRect(-70, -22, 140, 40); X.font = '26px P'; X.textAlign = 'center'; X.fillStyle = '#e02424'; X.fillText('NO DINOS', 0, 8); X.restore(); }
  X.restore(); }
function sack(x, y, s, t) { X.save(); X.translate(x, y); X.scale(s, s); X.fillStyle = '#c9a86a'; X.beginPath(); X.moveTo(-120, 0); X.quadraticCurveTo(-150, -160, -60, -230); X.lineTo(60, -230); X.quadraticCurveTo(150, -160, 120, 0); X.closePath(); X.fill(); rr(-70, -260, 140, 40, 16, '#b08f52'); X.strokeStyle = '#7a5a2e'; X.lineWidth = 6; X.beginPath(); X.moveTo(-60, -232); X.quadraticCurveTo(0, -210, 60, -232); X.stroke(); rr(-96, -150, 192, 74, 10, '#f4ead6'); X.font = '24px P'; X.textAlign = 'center'; X.fillStyle = '#4a2f1a'; X.fillText('BRICKS', 0, -122); X.fillText('CONCRETE + WOOD', 0, -92); X.restore(); }
function materials(x, y, t, a = 1) { X.save(); X.globalAlpha = a; for (let q = 0; q < 9; q++) rr(x - 90 + (q % 5) * 34 + (q > 4 ? 16 : 0), y - 24 - (q > 4 ? 22 : 0), 30, 18, 3, q % 2 ? BRICK : BRICKD); for (let q = 0; q < 4; q++) { X.save(); X.translate(x + 110, y - 10 - q * 12); X.rotate(-0.08 + q * 0.04); rr(-70, -6, 140, 12, 3, q % 2 ? WOOD : WOODD); X.restore(); } X.fillStyle = '#9aa0a8'; X.beginPath(); X.moveTo(x - 150, y); X.quadraticCurveTo(x - 160, y - 60, x - 130, y - 70); X.lineTo(x - 100, y - 70); X.quadraticCurveTo(x - 80, y - 50, x - 90, y); X.fill(); X.font = '16px P'; X.textAlign = 'center'; X.fillStyle = '#4a4f58'; X.fillText('CEMENT', x - 120, y - 30); X.restore(); }
function flyBricks(t, t0, x, y, n = 14) { const e = t - t0; if (e < 0 || e > 1.6) return; for (let q = 0; q < n; q++) { const a = -Math.PI / 2 + (q / n - 0.5) * 2.6, sp = 300 + (q * 53) % 250; X.save(); X.translate(x + Math.cos(a) * sp * e, y + Math.sin(a) * sp * e + e * e * 700); X.rotate(q + e * 8); rr(-15, -9, 30, 18, 3, q % 2 ? BRICK : BRICKD); X.restore(); } }
function tub(x, y, t, stir) { el(x, y - 70, 92, 22, '#6b6f78'); X.fillStyle = '#8a8f99'; X.beginPath(); X.moveTo(x - 92, y - 70); X.lineTo(x - 76, y); X.lineTo(x + 76, y); X.lineTo(x + 92, y - 70); X.fill(); el(x, y - 70, 84, 18, '#b8bcc4'); if (stir > 0) { X.strokeStyle = '#8f949c'; X.lineWidth = 6; X.beginPath(); X.ellipse(x, y - 70, 50 + Math.sin(t * 6) * 10, 10, 0, t * 8, t * 8 + 4); X.stroke(); } }
function penguin(x, y, s, t) { X.save(); X.translate(x, y + Math.abs(Math.sin(t * 6)) * -6); X.scale(s, s); el(0, -70, 46, 70, '#1c1d24'); el(0, -60, 32, 56, '#fff'); el(0, -150, 34, 32, '#1c1d24'); el(-10, -156, 6, 6, '#fff'); el(12, -156, 6, 6, '#fff'); X.fillStyle = '#ffb02a'; X.beginPath(); X.moveTo(-8, -144); X.lineTo(8, -144); X.lineTo(0, -128); X.fill(); el(-20, 0, 18, 8, '#ffb02a'); el(20, 0, 18, 8, '#ffb02a'); X.restore(); }
function pizzaOven(x, y, s, t) { X.save(); X.translate(x, y); X.scale(s, s); X.fillStyle = '#c4553a'; X.beginPath(); X.arc(0, 0, 90, Math.PI, 0); X.fill(); rr(-100, 0, 200, 20, 4, '#a3442d'); X.fillStyle = '#2a1a14'; X.beginPath(); X.arc(0, 0, 40, Math.PI, 0); X.fill(); el(0, -14, 22 + Math.sin(t * 12) * 3, 16, '#ff8a2a'); el(0, -10, 12, 9, '#ffd23f'); rr(40, -130, 24, 60, 4, '#8a8f99'); X.restore(); }
// ---------- scene pieces ----------
function world4(t, o = {}) { sky(t); X.save(); X.translate(IX, 0); X.scale(1.4, 1); X.translate(-IX, 0); island(t); X.restore(); palm(650, IY - 8, 1.0, t, true); }
function boat4(t, o = {}) { const y = WL + Math.sin(t * 2) * 3, st = sternOf(YP, y), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 24, t); yacht(YP, y, 1, t, { name: 'STUPIDER8', deck: () => { homeDeco(t, -9)(); } }); gullBird(YP + 250, y - 150, 1.0, t, { laugh: o.laugh }); if (o.laugh) txt('HA HA', YP + 290, y - 270, 44, '#fff', 'center'); return y; }
const gIsland = (x, t, o) => guy(x, HY, GI, Object.assign({ hair: 'slick' }, o), t);
// ---------------- scenes ----------------
const SC = {
  d4_drop(t, u) { const td = ev('drop'), tb = ev('burst'), f = cl(t / td), e = t - td; const sh = e > 0 && e < 0.6 ? Math.sin(t * 60) * 10 * (1 - e / 0.6) : 0; X.translate(sh, sh * 0.6); cam(960, 990, 0.6); world4(t); trex(TX, TY, 1, t, { head: e > 0 ? [330, -560] : HEAD0, happy: false, jaw: e > 0 && e < 0.8 ? 0.5 : 0, squash: pulse(t, td, 0.3) * 0.5 }); if (t < tb) { const y = t < td ? lerp(IY - 780, HSY, f * f) : HSY; X.strokeStyle = 'rgba(255,255,255,.7)'; X.lineWidth = 10; if (t < td) for (let q = 0; q < 4; q++) { X.beginPath(); X.moveTo(HSX - 90 + q * 60, y - 320); X.lineTo(HSX - 90 + q * 60, y - 520); X.stroke(); } sack(HSX, y, 2.0, t); } else { materials(HSX, HSY, t); flyBricks(t, tb, HSX, HSY - 80); for (let q = 0; q < 10; q++) { const ee = t - tb; if (ee < 0.6) el(HSX + Math.cos(q) * ee * 400, HSY - 30 - Math.abs(Math.sin(q * 2)) * ee * 200, 30 * (1 - ee / 0.6), 20 * (1 - ee / 0.6), 'rgba(200,190,170,.7)'); } }
    boat4(t); gIsland(1000, t, { eyes: e > 0 ? 'wide' : 'open', mouth: e > 0 ? 'shock' : 'flat', look: 1, lookY: e < 0 ? -1 : 0, hl: [-110, -330], hr: [110, -330] }); },
  d4_recap(t, u) { const tc = ev('rchain'), tr = ev('rrex'); X.save(); X.filter = 'sepia(0.85) brightness(1.05)'; cam(960, 1000, 0.6); world4(t); trex(TX, TY, 1, t, { head: t > tr ? [600, -170] : HEAD0, hungry: t > tr, jaw: t > tr ? Math.abs(Math.sin(t * 16)) * 0.7 : 0 }); boat4(t); materials(HSX, HSY, t); gIsland(1000, t, { eyes: 'open', mouth: 'flat', look: 1 }); X.restore(); X.filter = 'none'; X.setTransform(1, 0, 0, 1, 0, 0); pill('◀◀ SO FAR', 200, 150, 'rgba(14,15,22,.85)', '#fff', 44); stamp('CHAINED', 540, 330, -0.06, (t - tc) / 0.15, '#e02424', 84); stamp('EATS HIS FOOD', 540, 470, 0.05, (t - tr) / 0.15, '#e02424', 70); },
  d4_card(t, u) { cardScene(t, false); },
  d4_read(t, u) { cardScene(t, true); },
  d4_never(t, u) { const tn = ev('never'); cam(lerp(820, 840, u), lerp(900, 880, u), lerp(1.1, 1.25, sm(u))); world4(t); trex(TX, TY, 1, t, { head: [380, -520], happy: true }); boat4(t); materials(HSX, HSY, t); gIsland(1000, t, { eyes: 'open', brow: -0.6, mouth: t > tn ? 'frown' : 'flat', look: 1, lookY: 0.6, hl: [-60, -120], hr: [140, -260], tilt: 0.06 }); X.setTransform(1, 0, 0, 1, 0, 0); stamp('0 EXPERIENCE', 540, 380, -0.05, (t - tn) / 0.15, '#e02424', 80); },
  d4_try1(t, u) { const t0 = seg('d4_try1').start; cam(760, 900, 1.15); world4(t); trex(TX, TY, 1, t, { head: [380, -520], happy: true }); boat4(t); const n = Math.min(8, Math.floor(Math.max(0, t - t0 - 0.3) / 0.16) + 1), sw = Math.sin(t * 5) * 0.06 * (n / 8); X.save(); X.translate(HSX, HSY); X.rotate(sw); for (let q = 0; q < n; q++) rr(-34 + (q % 2) * 6, -22 - q * 22, 68, 20, 3, q % 2 ? BRICK : BRICKD); X.restore(); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: -1, hl: [-110, -330], hr: [110, -330] }); },
  d4_sneeze(t, u) { const ts = ev('sneeze'), e = t - ts; cam(720, 880, 1.1); world4(t); trex(TX, TY, 1, t, { head: e < 0 ? [lerp(380, 400, cl((e + 0.4) / 0.4)), lerp(-520, -560, cl((e + 0.4) / 0.4))] : [460, -480], headRot: e < 0 ? -0.2 * cl((e + 0.4) / 0.4) : 0.15, jaw: e > 0 && e < 0.4 ? 0.8 : 0, happy: e > 0.6 }); const y = boat4(t, { laugh: t > ev('ha1') && t < ev('ha1') + 0.7 });
    if (e < 0) { X.save(); X.translate(HSX, HSY); X.rotate(Math.sin(t * 5) * 0.06); for (let q = 0; q < 8; q++) rr(-34 + (q % 2) * 6, -22 - q * 22, 68, 20, 3, q % 2 ? BRICK : BRICKD); X.restore(); } else { flyBricks(t, ts, HSX, HSY - 90, 8); windLines(t, ts, 720, 760, 1000); if (e > 0.9) for (let q = 0; q < 8; q++) rr(HSX - 120 + q * 30, HSY - 18 - (q % 3) * 8, 28, 16, 3, q % 2 ? BRICK : BRICKD); }
    gIsland(1000, t, { eyes: e > 0 ? 'closed' : 'happy', mouth: e > 0 ? 'frown' : 'grin', look: -1, hl: [-90, -150], hr: [90, -150], tilt: e > 0 && e < 0.5 ? 0.15 : 0 }); X.setTransform(1, 0, 0, 1, 0, 0); stamp('ACHOO', 540, 330, 0.08, e / 0.12, INK, 100); stamp('NOPE', 540, 480, -0.08, (t - ev('nope')) / 0.15, '#e02424', 110); },
  d4_mix(t, u) { const tm = ev('mix'); cam(820, 900, 0.85); world4(t); const stir = t > tm - 0.2 ? 1 : 0; tub(HSX + 60, HSY, t, stir); trex(TX + 120, TY, 1, t, { flip: true, head: [260, -560], happy: true, wag: stir ? 4 : 1, armWave: 0.2 }); boat4(t); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: -1, hl: [-110, -330 + Math.sin(t * 9) * 25], hr: [90, -140] }); },
  d4_nail(t, u) { const tn = ev('nail'), e = t - tn, bonkPh = e > 0.15 ? ((e - 0.15) % 0.32) / 0.32 : 0, down = e > 0.15 && e < 1.75 ? Math.max(0, 1 - bonkPh * 3) : 0; cam(760, 860, 1.0); world4(t); house4(HSX, HSY, { build: 0.7 + 0.3 * cl(e / 1.7), roof: e > 0.8 }, t); const hp = [430, lerp(-520, -380, down)]; const hd = trex(TX, TY, 1, t, { head: hp, happy: true, armWave: 0.9, armSpeed: 14 }); if (e > 0.15 && down > 0.6) stars(hd[0] + 60, hd[1] - 90, t, t - 0.1); boat4(t); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: -1, hl: [-110, -260], hr: [90, -140] }); X.setTransform(1, 0, 0, 1, 0, 0); stamp('BONK', 540, 330, 0.06, e > 0.15 ? (e - 0.15) / 0.12 : 0, INK, 96); },
  d4_later(t, u) { const t0 = seg('d4_later').start; cam(960, 990, 0.6); world4(t); house4(HSX, HSY, { build: 1, roof: true }, t); trex(TX, TY, 1, t, { head: HEAD0, happy: true }); boat4(t); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-90, -150], hr: [90, -150] }); X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = `rgba(14,15,22,${0.55 * Math.min(1, (t - t0) * 3)})`; X.fillRect(0, 0, W, H); pill('3 DAYS LATER', 540, 900, '#ffd23f', INK, 90, after(t, t0, 0.25)); },
  d4_done(t, u) { const td = ev('done'); cam(lerp(840, 800, u), lerp(900, 880, u), lerp(1.05, 1.15, sm(u))); world4(t); house4(HSX, HSY, { build: 1, roof: true }, t); trex(TX, TY, 1, t, { head: [360, -540], happy: true, armWave: 0.9, armSpeed: 10 }); boat4(t); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: -1, hl: [-140, -200], hr: [110, -330] }); sparkles(t, td - 0.2, 12, HSX, HSY - 120, 150, 90); },
  d4_why(t, u) { cam(lerp(800, 780, u), 880, lerp(1.15, 1.25, sm(u))); world4(t); house4(HSX, HSY, { build: 1, roof: true }, t); trex(TX, TY, 1, t, { head: [360, -540], happy: true }); boat4(t); gIsland(1000, t, { eyes: 'open', brow: 0.4, mouth: 'smile', look: 0, hl: [-60, -120], hr: [60, -120] }); },
  d4_pantry(t, u) { const tp = ev('pantry'); cam(780, 880, 1.25); world4(t); house4(HSX, HSY, { build: 1, roof: true, cut: cl((t - tp + 0.4) / 0.3), sign: t > tp + 0.2 }, t); trex(TX, TY, 1, t, { head: [360, -540], happy: true }); boat4(t); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: -1, hl: [-140, -200], hr: [60, -120] }); },
  d4_day14(t, u) { const c = ev('c14'), tf = ev('fourteen'), e = t - tf; cam(820, 900, 0.95); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); trex(TX, TY, 1, t, { head: [lerp(360, 300, cl(e / 0.6)), lerp(-540, -360, cl(e / 0.6))], hungry: e > 0, jaw: e > 0.5 && e < 1.1 ? 0.6 : 0 }); boat4(t); gIsland(1000, t, { eyes: e > 0.3 ? 'wide' : 'open', mouth: e > 0.3 ? 'flat' : 'smile', look: -1, sweat: e > 0.3, hl: [-60, -120], hr: [60, -120] }); redSky(cl(e / 0.6)); X.setTransform(1, 0, 0, 1, 0, 0); calendar(14, t, c, true); },
  d4_fit(t, u) { const tf = ev('fit'), t2 = ev('fit2'); cam(760, 900, 1.1); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); const hit = (tt) => Math.max(0, 1 - Math.abs(t - tt) / 0.15); const push = Math.max(hit(tf), hit(t2)); const hd = trex(TX, TY, 1, t, { head: [lerp(240, 300, push), -230], hungry: true, headRot: push * 0.05 }); if (t > tf) stars(hd[0] + 230, hd[1] - 60, t, tf); boat4(t); gIsland(1000, t, { eyes: 'wide', mouth: 'flat', look: -1, sweat: true, hl: [-60, -120], hr: [60, -120] }); redSky(1); X.setTransform(1, 0, 0, 1, 0, 0); stamp("DOESN'T FIT", 540, 330, -0.06, (t - tf) / 0.15, '#e02424', 84); },
  d4_arms(t, u) { const ta = ev('arms'); cam(lerp(700, 680, u), 860, lerp(1.25, 1.4, sm(u))); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); trex(TX, TY, 1, t, { head: [200, -300], hungry: true, armWave: 1.2, armSpeed: 16 }); if (t > ta) { X.save(); X.strokeStyle = '#e02424'; X.lineWidth = 6; X.setLineDash([16, 10]); X.beginPath(); X.moveTo(TX + 270, TY - 410); X.lineTo(HSX + 12, HSY - 40); X.stroke(); X.setLineDash([]); X.restore(); } boat4(t); redSky(1); X.setTransform(1, 0, 0, 1, 0, 0); stamp('TOO SHORT', 540, 330, 0.06, (t - ta) / 0.15, '#e02424', 90); },
  d4_sad(t, u) { const t0 = seg('d4_sad').start; cam(lerp(620, 600, u), lerp(780, 760, u), lerp(1.4, 1.6, sm(u))); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); trex(TX, TY, 1, t, { head: [240, -320], sad: true, wag: 0.1, armWave: 0.05 }); boat4(t); redSky(cl(1 - (t - t0) / 1.2)); },
  d4_share(t, u) { const ts = ev('share'), tg = ev('gulp'), e = t - ts; cam(760, 880, 1.0); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); const hd = trex(TX, TY, 1, t, { head: [300, -330], sad: t < tg, happy: t >= tg, jaw: e > 0 && t < tg ? 0.6 : 0, wag: t > tg ? 4 : 0.2, armWave: t > tg ? 1 : 0.05, armSpeed: 12 }); boat4(t); const gx = lerp(HSX + 10, 1000, cl(e / 0.5)); gIsland(gx, t, { eyes: 'happy', mouth: 'smile', look: -1, hl: [-120, -230], hr: [60, -120] }, t); if (t < ts + 0.2) { X.save(); X.translate(gx - 120 * GI, HY - 240 * GI); fishShape(0, 0, 0.5, t, true); X.restore(); } else if (t < tg) { const f = cl((t - ts - 0.2) / (tg - ts - 0.2)); X.save(); X.translate(lerp(gx - 75, hd[0] + 200, f), lerp(HY - 150, hd[1] + 30, f) - Math.sin(f * Math.PI) * 120); X.rotate(f * 8); fishShape(0, 0, 0.5, t, true); X.restore(); } hearts(t, tg, hd[0] + 140, hd[1] - 40); },
  d4_ask(t, u) { cam(960, 990, 0.6); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); trex(TX, TY, 1, t, { head: HEAD0, happy: true, armWave: 0.7 }); boat4(t); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-110, -330 + Math.sin(t * 9) * 30], hr: [100, -150] }); X.setTransform(1, 0, 0, 1, 0, 0); pill('DAY 5 IS UP TO YOU', 540, 1290, '#ffd23f', INK, 64, after(t, seg('d4_ask').start + 0.1, 0.3)); },
  d4_ideas(t, u) { ideas4(t, 1); },
  d4_end(t, u) { ideas4(t, 2); },
};
function cardScene(t, reading) { cam(960, 1170, 0.6); world4(t); trex(TX, TY, 1, t, { head: [330, -430], happy: true }); boat4(t); materials(HSX, HSY, t); gIsland(1000, t, { eyes: 'open', mouth: 'flat', look: 1, hl: [-60, -120], hr: [60, -120] }); X.setTransform(1, 0, 0, 1, 0, 0); card4(t, after(t, ev('card'), 0.3), reading); if (t > ev('again')) stamp('WON AGAIN', 540, 1060, -0.05, (t - ev('again')) / 0.15, '#2a8a3e', 64); }
function card4(t, a, hl) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); const k = 0.82 + 0.06 * Math.min(1, a); X.translate(540, 1270); X.scale(k, k); rr(-470, -150, 940, 300, 40, '#ffffff'); el(-380, -70, 54, 54, '#b8bcc4'); for (const [dx, dy] of [[-16, -6], [14, -6]]) el(-380 + dx, -76 + dy, 6, 9, '#6b6f78'); X.textAlign = 'left'; X.font = '40px P'; X.fillStyle = '#8a8f99'; X.fillText('@stupider8', -306, -76); X.font = '48px P'; X.fillStyle = INK; X.fillText('give him a big bag of bricks', -306, -10); X.fillText('concrete amd wood to', -306, 52); X.fillStyle = hl && t > ev('hl') ? '#e02424' : INK; X.fillText('make a house', -306 + X.measureText('concrete amd wood to ').width * 0 + 0, 112); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.textAlign = 'right'; X.fillText('♥ 4', 440, -76); X.restore(); }
function ideas4(t, mode) { const tj = ev('jet'), tg = ev('gran'), tr = ev('rex2'); cam(960, 960, 0.64); world4(t); house4(HSX, HSY, { build: 1, roof: true, sign: true }, t); ghost(after(t, tr, 0.3), () => volcano(150, IY + 10, 0.55, false, t)); trex(TX, TY, 1, t, { head: HEAD0, happy: true, armWave: 0.6 }); const y = boat4(t); ghost(after(t, tj, 0.3), () => penguin(YP - 120, y + DECK, 0.9, t)); ghost(after(t, tg, 0.3), () => pizzaOven(YP + 60, y + DECK, 0.6, t)); gIsland(1000, t, { eyes: 'happy', mouth: 'grin', look: 0, hl: [-110, -330], hr: [110, -330] });
  for (const [tt, x, yy] of [[tj, YP - 120, y + DECK - 230], [tg, YP + 60, y + DECK - 190], [tr, 150, IY - 220]]) if (t > tt) txt('?', x, yy - ((t - tt) * 20) % 30, 70, '#fff', 'center', Math.min(1, (t - tt) * 4));
  X.setTransform(1, 0, 0, 1, 0, 0); if (mode === 2) { const e0 = seg('d4_end').start; pill('COMMENT ANYTHING', 540, 1270, '#ffd23f', INK, 70, after(t, e0, 0.3)); pill('TOP COMMENT GETS BUILT', 540, 1400, 'rgba(14,15,22,.88)', '#fff', 50, after(t, ev('word'), 0.3)); } }
