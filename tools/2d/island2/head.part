<!doctype html><html><head><meta charset="utf-8"><style>
@font-face{font-family:P;src:url(Poppins-Bold.ttf)}
html,body{margin:0;background:#000;overflow:hidden}
</style></head><body><canvas id=c width=1080 height=1920></canvas>
<script>
// Island Part 1: shipwrecked, build water/shelter/fire/SOS. In the morning the SOS is gone.
const C = document.getElementById('c'), X = C.getContext('2d'), W = 1080, H = 1920;
let T = null; window.setTiming = t => { T = t; };
const cl = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x)), sm = x => { x = cl(x); return x * x * (3 - 2 * x); };
const back = x => { x = cl(x); const c = 1.8; return 1 + (c + 1) * Math.pow(x - 1, 3) + c * Math.pow(x - 1, 2); };
const lerp = (a, b, u) => a + (b - a) * u;
function txt(s, x, y, size, col, align = 'center', a = 1) { X.globalAlpha = a; X.font = `${size}px P`; X.textAlign = align; X.fillStyle = 'rgba(0,0,0,.6)'; X.fillText(s, x + 3, y + 4); X.fillStyle = col; X.fillText(s, x, y); X.globalAlpha = 1; }
function label(s, x, y, tx, ty, a, col = '#ffd23f') { if (a <= 0) return; X.globalAlpha = a; X.strokeStyle = col; X.lineWidth = 4; X.beginPath(); X.moveTo(x, y); X.lineTo(tx, ty); X.stroke(); X.fillStyle = col; X.beginPath(); X.arc(x, y, 8, 0, 7); X.fill(); X.globalAlpha = 1; txt(s, tx, ty - 12, 40, col, tx < x ? 'right' : 'left', a); }
let seed = 11; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
function person(x, y, s, pose, t, a = 1, shirt = '#3d7bd9') { if (a <= 0) return; X.save(); X.globalAlpha = a; X.translate(x, y); X.scale(s, s); X.lineCap = 'round';
  X.strokeStyle = '#2b2f3a'; X.lineWidth = 16;
  let leg = [[-8, 0, -18, 30, -20, 64], [8, 0, 18, 30, 20, 64]];
  if (pose === 'bike') { const p = t * 7; leg = [[-6, 0, 10 + Math.cos(p) * 10, 30, 24 + Math.cos(p) * 22, 50 + Math.sin(p) * 22], [6, 0, 10 - Math.cos(p) * 10, 30, 24 - Math.cos(p) * 22, 50 - Math.sin(p) * 22]]; }
  for (const l of leg) { X.beginPath(); X.moveTo(l[0], l[1]); X.quadraticCurveTo(l[2], l[3], l[4], l[5]); X.stroke(); }
  X.fillStyle = shirt; X.beginPath(); X.roundRect(-24, -70, 48, 74, 18); X.fill();
  X.strokeStyle = shirt; X.lineWidth = 14; const sw = pose === 'dig' ? Math.sin(t * 9) : 0, sh = pose === 'can' ? Math.sin(t * 14) * 6 : 0;
  if (pose === 'can') { X.beginPath(); X.moveTo(-18, -58); X.lineTo(-30, -18); X.stroke(); X.beginPath(); X.moveTo(18, -58); X.lineTo(34 + sh, -78); X.stroke();
    X.save(); X.translate(40 + sh, -92); X.rotate(-0.5 + Math.sin(t * 14) * 0.12); X.fillStyle = '#c9d0d6'; X.fillRect(-14, -22, 28, 40); X.fillStyle = '#d8473a'; X.fillRect(-14, -10, 28, 14); X.restore(); }
  else if (pose === 'bike') { X.beginPath(); X.moveTo(18, -58); X.lineTo(52, -50); X.stroke(); X.beginPath(); X.moveTo(-18, -58); X.lineTo(40, -46); X.stroke(); }
  else if (pose === 'saw') { const q = Math.sin(t * 10) * 16; X.beginPath(); X.moveTo(-18, -58); X.lineTo(10 + q, -30); X.stroke(); X.beginPath(); X.moveTo(18, -58); X.lineTo(30, -24); X.stroke(); X.strokeStyle = '#8a5a30'; X.lineWidth = 6; X.beginPath(); X.moveTo(-40 + q, -30); X.lineTo(60 + q, -30); X.stroke(); }
  else if (pose === 'hands') { X.beginPath(); X.moveTo(-18, -58); X.lineTo(-36, -96); X.stroke(); X.beginPath(); X.moveTo(18, -58); X.lineTo(36, -96); X.stroke(); X.fillStyle = '#f1c7a4'; X.beginPath(); X.arc(-36, -100, 8, 0, 7); X.arc(36, -100, 8, 0, 7); X.fill(); }
  else if (pose === 'breath') { X.beginPath(); X.moveTo(-18, -58); X.lineTo(-30, -18); X.stroke(); X.beginPath(); X.moveTo(18, -58); X.lineTo(30, -18); X.stroke(); }
  else { X.beginPath(); X.moveTo(-18, -58); X.lineTo(-30 + sw * 10, -18 + sw * 12); X.stroke(); X.beginPath(); X.moveTo(18, -58); X.lineTo(34 + sw * 18, -20 + sw * 20); X.stroke(); }
  if (pose === 'dig') { X.strokeStyle = '#8a5a30'; X.lineWidth = 8; X.beginPath(); X.moveTo(34 + sw * 18, -20 + sw * 20); X.lineTo(70 + sw * 30, 50 + sw * 20); X.stroke(); X.fillStyle = '#9aa4ad'; X.beginPath(); X.ellipse(74 + sw * 30, 60 + sw * 20, 16, 22, 0.3, 0, 7); X.fill(); }
  X.fillStyle = '#f1c7a4'; X.beginPath(); X.arc(0, -96, 26, 0, 7); X.fill();
  if (shirt === '#3d7bd9' && window.OLD > 0) { X.globalAlpha = a * window.OLD; X.fillStyle = '#b9b4ad'; X.beginPath(); X.arc(0, -90, 24, 0.15 * Math.PI, 0.85 * Math.PI); X.fill(); X.fillStyle = '#e8e4de'; X.beginPath(); X.ellipse(-25, -100, 5, 9, 0, 0, 7); X.ellipse(25, -100, 5, 9, 0, 0, 7); X.fill(); X.strokeStyle = 'rgba(120,80,60,.6)'; X.lineWidth = 1.5; X.beginPath(); X.moveTo(-12, -112); X.lineTo(12, -112); X.moveTo(-10, -117); X.lineTo(10, -117); X.stroke(); X.globalAlpha = a; }
  X.fillStyle = '#2b2f3a'; const look = pose === 'breath' ? -1 : 1; X.beginPath(); X.arc(8 * look, -100, 3.5, 0, 7); X.arc(-6 * look + 2 * look, -100, 3.5, 0, 7); X.fill();
  X.restore(); }
function shotAt(t) { const S = T.segs; let i = 0; while (i < S.length - 1 && t >= S[i + 1].start) i++; const s = S[i]; return { name: s.shot, u: cl((t - s.start) / s.dur), i, t0: s.start, d: s.dur }; }
