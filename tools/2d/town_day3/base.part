// ---------- the island world ----------
const IX = 540, IY = 1135;
function pill(s, x, y, bg, fg, size = 58, a = 1) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.font = `${size}px P`; X.textAlign = 'center'; const w = X.measureText(s).width; rr(x - w / 2 - 34, y - size * 0.95, w + 68, size * 1.4, size * 0.5, bg); X.fillStyle = fg; X.fillText(s, x, y); X.restore(); }
function NK(t) { if (!T || !seg('d_sun')) return 0; const a = seg('d_sun'), b = seg('d_night'); if (t < a.start) return 0; if (t < b.start) return 0.5 * sm((t - a.start) / a.dur); return 0.5 + 0.35 * sm(cl((t - b.start) / b.dur)); }
function tri(a, b, c, k) { return k < 0.5 ? mixc(a, b, k * 2) : mixc(b, c, (k - 0.5) * 2); }
function sky(t, flash = 0) { const k = NK(t); const g = X.createLinearGradient(0, -1200, 0, 760); g.addColorStop(0, tri('#4fb4f0', '#f0845c', '#1b2150', k)); g.addColorStop(1, tri('#d4f1ff', '#ffd08a', '#4a4478', k)); X.fillStyle = g; X.fillRect(-6000, -6000, 13000, 6760);
  if (k > 0.55) for (let q = 0; q < 60; q++) { const sx = ((q * 397) % 2400) - 700, sy = -300 + ((q * 211) % 1000); el(sx, sy, 3, 3, `rgba(255,255,255,${cl((k - 0.55) * 4) * (0.5 + 0.5 * Math.sin(t * 3 + q))})`); }
  if (k > 0.6) { X.save(); X.globalAlpha = cl((k - 0.6) * 5); X.shadowColor = '#fff'; X.shadowBlur = 60; el(200, 300, 52, 52, '#f4f1de'); X.restore(); el(186, 290, 10, 10, 'rgba(0,0,0,.08)'); el(214, 316, 7, 7, 'rgba(0,0,0,.08)'); }
  const sy = lerp(300, 790, cl(k / 0.55)); X.save(); X.beginPath(); X.rect(-6000, -6000, 13000, 6760); X.clip(); X.globalAlpha = 1 - cl((k - 0.5) * 8); X.shadowColor = '#fff3a0'; X.shadowBlur = 80; el(900, sy, 70, 70, mixc('#fff3a0', '#ff7a3a', cl(k * 2))); X.restore();
  for (let q = 0; q < 5; q++) { const cx = ((((q * 430 + t * 18 - (typeof SCX === 'number' ? SCX : 0) * 0.25) % 2600) + 2600) % 2600) - 900, cy = 420 + (q % 3) * 90; for (const [dx, dy, r] of [[0, 0, 60], [55, -20, 70], [115, 0, 55], [60, 20, 60]]) el(cx + dx, cy + dy, r, r * 0.7, tri('#ffffff', '#ffd7c0', '#5a5a88', k)); }
  const o = X.createLinearGradient(0, 760, 0, 2400); o.addColorStop(0, tri('#3aa9e8', '#e08a6a', '#203a6a', k)); o.addColorStop(1, tri('#155fa8', '#2a4a8a', '#0c1838', k)); X.fillStyle = o; X.fillRect(-6000, 760, 13000, 9000);
  if (k > 0.2 && k < 0.6) { X.fillStyle = `rgba(255,190,120,${0.35 * Math.sin((k - 0.2) / 0.4 * Math.PI)})`; for (let q = 0; q < 8; q++) rr(860 - q * 6, 790 + q * 30, 80 + q * 12, 8, 4, X.fillStyle); }
  X.strokeStyle = `rgba(255,255,255,${0.35 - k * 0.2})`; X.lineWidth = 5; X.lineCap = 'round'; for (let r = 0; r < 14; r++) for (let c = 0; c < 10; c++) { const y = 800 + r * r * 9 + r * 30, x = -900 + c * 420 + (r % 2) * 200 + Math.sin(t * 0.8 + r + c) * 30 - (((typeof SCX === 'number' ? SCX : 0) * (0.4 + r * 0.06)) % 420), w = 40 + r * 6; X.beginPath(); X.moveTo(x - w, y); X.quadraticCurveTo(x, y - 10 - r, x + w, y); X.stroke(); } if (flash > 0) { X.fillStyle = `rgba(255,60,30,${flash * 0.25})`; X.fillRect(-6000, -6000, 13000, 16000); } }
function tint(t) { const k = NK(t); if (k <= 0) return; X.save(); X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = `rgba(255,120,60,${0.12 * Math.sin(Math.min(1, k * 2) * Math.PI)})`; X.fillRect(0, 0, W, H); X.fillStyle = `rgba(18,22,70,${0.2 * cl((k - 0.35) / 0.5)})`; X.fillRect(0, 0, W, H); X.restore(); }
function mixc(a, b, p) { const A = [1, 3, 5].map(i => parseInt(a.slice(i, i + 2), 16)), B = [1, 3, 5].map(i => parseInt(b.slice(i, i + 2), 16)); return `rgb(${A.map((v, i) => Math.round(lerp(v, B[i], cl(p)))).join(',')})`; }
function island(t) { const sw = Math.sin(t * 1.6) * 4; el(IX, IY + 40 + sw * 0.3, 380, 60, 'rgba(255,255,255,.35)'); el(IX, IY + 30, 350, 80, '#e0c27a'); el(IX, IY, 340, 70, '#f2d896'); el(IX - 40, IY - 14, 240, 36, '#8ccf6a'); el(IX - 40, IY - 18, 220, 28, '#9bdc78'); el(250, IY + 30, 34, 16, '#9aa0a8'); el(262, IY + 24, 20, 9, '#b4bac2'); X.save(); X.translate(330, IY + 44); X.scale(1, 0.55); X.fillStyle = '#ff8a5a'; X.beginPath(); for (let q = 0; q < 10; q++) { const r = q % 2 ? 9 : 22, a = q / 10 * Math.PI * 2 - Math.PI / 2; X.lineTo(Math.cos(a) * r, Math.sin(a) * r); } X.fill(); X.restore(); el(740, IY + 46, 13, 8, '#fde7e0'); el(770, IY + 40, 10, 6, '#f8d5ea'); el(830, IY + 4, 52, 22, '#8a8f99'); el(818, IY - 4, 30, 10, '#a4aab2'); }
function palm(x, y, s, t, coco = true) { X.save(); X.translate(x, y); X.scale(s, s); X.strokeStyle = '#9a6a3a'; X.lineWidth = 34; X.lineCap = 'round'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(30, -150, 10, -290); X.stroke(); X.strokeStyle = 'rgba(0,0,0,.14)'; X.lineWidth = 4; for (let q = 0; q < 6; q++) { const yy = -40 - q * 45, xx = 30 * (1 - (1 + yy / 290) ** 2) * 0 + (yy > -150 ? 15 * (-yy / 150) : 30 - (-yy - 150) / 7); X.beginPath(); X.moveTo(xx - 14, yy); X.lineTo(xx + 14, yy - 4); X.stroke(); }
  for (let q = 0; q < 6; q++) { const a = -Math.PI / 2 + (q - 2.5) * 0.55 + Math.sin(t * 1.5 + q) * 0.05; X.save(); X.translate(10, -290); X.rotate(a); X.fillStyle = q % 2 ? '#3f9a4c' : '#55b062'; X.beginPath(); X.moveTo(0, 0); X.quadraticCurveTo(70, -40, 140, 10); X.quadraticCurveTo(70, 0, 0, 12); X.fill(); X.restore(); } if (coco) { el(0, -282, 16, 16, '#7a4a26'); el(24, -276, 16, 16, '#6b3f22'); el(-14, -270, 15, 15, '#7a4a26'); } X.restore(); }
function gullBird(x, y, s, t, o = {}) { X.save(); X.translate(x, y); X.scale(s, s); const hb = o.laugh ? Math.abs(Math.sin(t * 22)) * -8 : Math.sin(t * 2) * 2; rr(-14, -6, 5, 18, 2, '#e8a03a'); rr(6, -6, 5, 18, 2, '#e8a03a'); el(0, -36, 40, 30, '#fff'); el(-12, -38, 30, 16, '#c8ccd4', -0.2); el(-38, -46, 16, 8, '#8a8f99', -0.4); X.save(); X.translate(22, -64 + hb); el(0, 0, 22, 20, '#fff'); if (o.sleep) { X.strokeStyle = INK; X.lineWidth = 3; X.beginPath(); X.arc(6, -2, 5, 0.2, Math.PI - 0.2); X.stroke(); } else { el(7, -4, 4.5, 4.5, INK); } const op = o.laugh ? Math.abs(Math.sin(t * 22)) * 0.5 : 0; X.fillStyle = '#ffb02a'; X.save(); X.translate(18, 2); X.rotate(-op * 0.5); X.beginPath(); X.moveTo(0, -5); X.lineTo(26, 0); X.lineTo(0, 3); X.fill(); X.restore(); X.save(); X.translate(18, 4); X.rotate(op * 0.6); X.beginPath(); X.moveTo(0, -1); X.lineTo(22, 2); X.lineTo(0, 6); X.fill(); X.restore(); X.restore(); X.restore(); }
function gullSpot(t) { const L = ['ha1', 'ha2', 'ha3'].some(k => t > ev(k) && t < ev(k) + 0.6), sl = NK(t) > 0.6; gullBird(838, IY - 10, 1.0, t, { laugh: L, sleep: sl }); if (L) txt('HA HA', 880, IY - 120, 40, '#fff', 'center'); if (sl) txt('z', 880 + Math.sin(t * 2) * 6, IY - 110 - ((t * 30) % 40), 34, '#fff', 'center', 0.8); }
// things people can build (ghost = see-through preview)
const gc = (g, c) => g ? 'rgba(255,255,255,.55)' : c;
function ghostLine(g) { if (!g) return; X.setLineDash([16, 12]); X.strokeStyle = 'rgba(255,255,255,.95)'; X.lineWidth = 5; X.stroke(); X.setLineDash([]); }
function house(x, y, s, g) { X.save(); X.translate(x, y); X.scale(s, s); X.beginPath(); X.rect(-90, -120, 180, 120); X.fillStyle = gc(g, '#f4e3c3'); X.fill(); ghostLine(g); X.beginPath(); X.moveTo(-110, -112); X.lineTo(0, -210); X.lineTo(110, -112); X.closePath(); X.fillStyle = gc(g, '#d8473a'); X.fill(); ghostLine(g); if (!g) { rr(-24, -70, 48, 70, 6, '#8a5a30'); rr(36, -90, 40, 36, 4, '#9fd8ff'); rr(-76, -90, 40, 36, 4, '#9fd8ff'); } X.restore(); }
function pup(x, y, s, g, t) { X.save(); X.translate(x, y); X.scale(s, s); const c = gc(g, '#c98a4b'); X.save(); X.translate(-58, -60); X.rotate(-0.6 + Math.sin(t * 12) * 0.4); rr(-7, -46, 14, 46, 7, c); X.restore(); for (const lx of [-40, -20, 24, 44]) rr(lx - 8, -40, 16, 40, 7, c); X.beginPath(); X.ellipse(0, -60, 62, 34, 0, 0, 7); X.fillStyle = c; X.fill(); ghostLine(g); X.beginPath(); X.ellipse(56, -96, 34, 30, 0, 0, 7); X.fillStyle = c; X.fill(); ghostLine(g); el(80, -88, 18, 13, gc(g, '#f3dcb5')); el(95, -94, 7, 6, g ? 'rgba(255,255,255,.9)' : INK); el(50, -86, 12, 22, gc(g, '#7a4a26'), 0.3); if (!g) el(62, -104, 5, 5, INK); X.restore(); }
function volcano(x, y, s, g, t) { X.save(); X.translate(x, y); X.scale(s, s); X.beginPath(); X.moveTo(-150, 0); X.lineTo(-44, -230); X.lineTo(44, -230); X.lineTo(150, 0); X.closePath(); X.fillStyle = gc(g, '#7a5a48'); X.fill(); ghostLine(g); X.beginPath(); X.moveTo(-44, -230); X.quadraticCurveTo(-30, -180, -10, -200); X.quadraticCurveTo(10, -150, 24, -205); X.lineTo(44, -230); X.closePath(); X.fillStyle = gc(g, '#ff6a2a'); X.fill(); for (let q = 0; q < 3; q++) { const ph = (t * 0.5 + q / 3) % 1; el(Math.sin(ph * 6 + q) * 20, -250 - ph * 160, 26 + ph * 30, 20 + ph * 24, g ? `rgba(255,255,255,${0.35 * (1 - ph)})` : `rgba(90,90,100,${0.5 * (1 - ph)})`); } X.restore(); }
function postSign(x, y, s, label, a) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(s * a, s * a); rr(-8, -150, 16, 150, 4, '#8a5a30'); rr(-90, -200, 180, 70, 10, '#c98d4f'); rr(-82, -192, 164, 54, 8, '#dba66a'); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = '#4a2f1a'; X.fillText(label, 0, -151); X.restore(); }
function bubble(x, y, s, a, t) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); X.translate(x, y); X.scale(s, s); rr(-300, -90, 600, 180, 40, '#fff'); X.fillStyle = '#fff'; X.beginPath(); X.moveTo(-180, 80); X.lineTo(-230, 140); X.lineTo(-120, 84); X.fill(); el(-220, -10, 50, 50, '#ffd23f'); X.font = '44px P'; X.textAlign = 'left'; X.fillStyle = '#8a8f99'; X.fillText('@you', -150, -24); X.fillStyle = INK; X.font = '50px P'; X.fillText('give him a house', -150, 40); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.fillText('♥ 2,481', 120, -24); X.restore(); }
function nameTag(x, y, s, a, t) { if (a <= 0) return; X.save(); X.translate(x, y); X.scale(s * a, s * a); X.rotate(-0.06); rr(-210, -130, 420, 260, 24, '#e02424'); rr(-196, -20, 392, 136, 14, '#fff'); X.font = '54px P'; X.textAlign = 'center'; X.fillStyle = '#fff'; X.fillText('HELLO', 0, -66); X.font = '30px P'; X.fillText('MY NAME IS', 0, -30); X.font = '84px P'; X.fillStyle = INK; X.fillText(Math.floor(t * 2) % 2 ? '?' : '_ _ _', 0, 80); X.restore(); }
function stars(x, y, t, t0) { const e = t - t0; if (e < 0 || e > 1.6) return; for (let q = 0; q < 4; q++) { const a = e * 5 + q * Math.PI / 2; txt('✦', x + Math.cos(a) * 60, y + Math.sin(a) * 18, 34, '#ffd23f', 'center', 1 - e / 1.6); } }
function sparkles(t, t0, n, cx, cy, rx, ry) { const e = t - t0; if (e < 0) return; for (let q = 0; q < n; q++) { const ph = (e * 0.8 + q / n) % 1; txt('✦', cx + Math.cos(q * 2.4) * rx * (0.4 + ph * 0.6), cy + Math.sin(q * 3.1) * ry - ph * 80, 30 + (q % 3) * 10, '#fff7c2', 'center', Math.sin(ph * Math.PI) * Math.min(1, e * 3)); } }
// base scene: everything that exists on Day 1 (palm + guy), plus optional extras
function scene(t, o = {}) { sky(t, o.dark || 0); if (o.volc) volcano(865, 1105, 0.9, o.volc === 'g', t); island(t); if (o.house) house(285, IY + 4, 0.85, o.house === 'g'); palm(650, IY - 8, 1.0, t); if (o.dog) pup(560, IY + 10, 0.7, o.dog === 'g', t); }
const HX = 430, HY = IY + 8;
// ---------------- new props for the story ----------------
const WL = 1192;   // water line in front of the island
function clipAbove(y) { X.save(); X.beginPath(); X.rect(-4000, -4000, 9000, y + 4000); X.clip(); }
function whale(x, y, s, open, t) { clipAbove(y); X.save(); X.translate(x, y); X.scale(s, s); el(0, 40, 230, 150, '#3f6fb0'); el(-30, 90, 170, 80, '#a9c8e8'); X.save(); X.translate(-200, 10); X.rotate(-open * 0.6); el(60, -30, 120, 60, '#3f6fb0'); X.restore(); el(-200, 70, 90, 40 + open * 30, '#2a3550'); el(-60, -40, 14, 14, '#fff'); el(-64, -40, 7, 7, INK); for (let q = 0; q < 3; q++) { const ph = (t * 1.2 + q / 3) % 1; el(30 + Math.sin(q * 3) * 20, -110 - ph * 120, 14 + ph * 20, 18 + ph * 26, `rgba(255,255,255,${0.7 * (1 - ph)})`); } X.restore(); X.restore(); }
function fin(x, y, t) { X.fillStyle = '#5b6573'; X.beginPath(); X.moveTo(x - 40, y); X.quadraticCurveTo(x + 10, y - 70, x + 30, y - 110); X.quadraticCurveTo(x + 30, y - 40, x + 50, y); X.closePath(); X.fill(); X.strokeStyle = 'rgba(255,255,255,.7)'; X.lineWidth = 5; X.beginPath(); X.moveTo(x - 70, y + 6); X.quadraticCurveTo(x, y - 4, x + 80, y + 6); X.stroke(); }
function ripples(x, y, t) { X.strokeStyle = 'rgba(255,255,255,.75)'; X.lineWidth = 5; for (let q = 0; q < 3; q++) { const ph = (t * 1.5 + q / 3) % 1; X.globalAlpha = 1 - ph; X.beginPath(); X.ellipse(x, y, 60 + ph * 90, 12 + ph * 16, 0, 0, 7); X.stroke(); } X.globalAlpha = 1; }
function drops(t, t0, x, y, n = 10) { const e = t - t0; if (e < 0 || e > 0.8) return; for (let q = 0; q < n; q++) { const a = -Math.PI / 2 + (q / n - 0.5) * 2.4, sp = 160 + (q * 37) % 120; el(x + Math.cos(a) * sp * e, y + Math.sin(a) * sp * e + e * e * 500, 9, 12, 'rgba(200,235,255,.9)'); } }
function dust(t, t0, x, y) { const e = t - t0; if (e < 0 || e > 0.6) return; for (let q = 0; q < 8; q++) { const a = Math.PI + q / 7 * Math.PI; el(x + Math.cos(a) * e * 240, y + Math.sin(a) * e * 60, 24 * (1 - e / 0.6), 16 * (1 - e / 0.6), 'rgba(242,216,150,.9)'); } }
function helpText(t, n, wipeX) { X.save(); X.beginPath(); X.rect(wipeX, 1100, 2000, 200); X.clip(); X.translate(540, 1178); X.scale(1, 0.5); X.font = '120px P'; X.textAlign = 'center'; X.fillStyle = 'rgba(150,110,50,.75)'; X.fillText('HELP'.slice(0, n), 0, 0); X.restore(); }
function bigWave(x) { if (x < -400 || x > 1600) return; const g = X.createLinearGradient(0, 960, 0, 1260); g.addColorStop(0, '#5cc4f5'); g.addColorStop(1, '#2a8fd8'); X.fillStyle = g; X.beginPath(); X.moveTo(x - 800, 1270); X.lineTo(x - 800, 1150); X.quadraticCurveTo(x - 250, 1120, x - 60, 980); X.quadraticCurveTo(x + 60, 930, x + 110, 1010); X.quadraticCurveTo(x + 40, 990, x + 20, 1060); X.quadraticCurveTo(x + 10, 1170, x + 70, 1270); X.closePath(); X.fill(); for (let q = 0; q < 9; q++) { const a = q / 8; el(x - 60 + a * 170 - a * a * 60, 975 + Math.sin(a * 3) * 10 - a * 0, 28 - q * 1.5, 20, '#fff'); } for (let q = 0; q < 6; q++) el(x - 700 + q * 110, 1150 + Math.sin(q) * 6, 40, 12, 'rgba(255,255,255,.7)'); }
