// ================= DAY 3: the T-Rex that eats all his food every 7 days =================
const TX = 400, TY = IY - 6, GX = YP - 200;             // T-Rex spot on the island, guy spot on the yacht
const G = '#62b04f', GD = '#4a8c3c', GL = '#c3e39a';
const HEAD0 = [230, -600];
// ---------- the T-Rex ----------
function trex(x, y, s, t, o = {}) { const b = Math.sin(t * 2) * 4 + (o.bob || 0); X.save(); X.translate(x, y); X.scale(s * (1 + (o.squash || 0) * 0.12), s * (1 - (o.squash || 0) * 0.12)); X.lineCap = 'round'; X.lineJoin = 'round';
  el(20, 4, 220, 26, 'rgba(0,0,0,.22)');
  const tw = Math.sin(t * 1.6) * (o.wag || 1); X.fillStyle = GD; X.beginPath(); X.moveTo(-50, -340 + b); X.quadraticCurveTo(-270, -300 + tw * 20, -470, -210 + tw * 40); X.quadraticCurveTo(-260, -235 + tw * 10, -40, -250 + b); X.closePath(); X.fill();
  el(-20, -270, 80, 112, GD, -0.2); X.strokeStyle = GD; X.lineWidth = 56; X.beginPath(); X.moveTo(-14, -210); X.lineTo(6, -40); X.stroke(); el(40, -16, 72, 20, GD);
  X.save(); X.translate(30, -385 + b); X.rotate(-0.35); el(0, 0, 192, 126, G); X.fillStyle = GD; for (let q = 0; q < 6; q++) { X.beginPath(); X.moveTo(-140 + q * 52, -116 + Math.abs(q - 2.5) * 6); X.lineTo(-120 + q * 52, -150 + Math.abs(q - 2.5) * 6); X.lineTo(-100 + q * 52, -114 + Math.abs(q - 2.5) * 6); X.fill(); } X.restore(); X.save(); X.translate(84, -334 + b); X.rotate(-0.45); el(0, 0, 118, 60, GL); X.restore();
  el(44, -262, 92, 122, G, -0.2); X.strokeStyle = G; X.lineWidth = 62; X.beginPath(); X.moveTo(52, -190); X.lineTo(76, -40); X.stroke(); el(108, -16, 80, 22, G); X.fillStyle = '#fff'; for (let q = 0; q < 3; q++) { X.beginPath(); X.moveTo(150 + q * 4, -26 + q * 9); X.lineTo(176 + q * 4, -20 + q * 9); X.lineTo(150 + q * 4, -14 + q * 9); X.fill(); }
  const H = o.head || HEAD0; X.strokeStyle = G; X.lineWidth = 128; X.beginPath(); X.moveTo(140, -430 + b); X.quadraticCurveTo((140 + H[0]) / 2 + 30, Math.min(-430, H[1]) - 40 + b, H[0], H[1] + b); X.stroke();
  const aw = Math.sin(t * (o.armSpeed || 3)) * (o.armWave || 0.2); for (const k of [0, 1]) { X.save(); X.translate(196 + k * 16, -418 + b + k * 10); X.rotate(0.7 + aw + k * 0.3); X.strokeStyle = k ? GD : G; X.lineWidth = 22; X.beginPath(); X.moveTo(0, 0); X.lineTo(40, 6); X.stroke(); X.fillStyle = '#fff'; X.beginPath(); X.moveTo(48, 0); X.lineTo(60, 6); X.lineTo(48, 12); X.fill(); X.restore(); }
  X.save(); X.translate(H[0], H[1] + b); X.rotate(o.headRot || 0); const jaw = o.jaw || 0;
  if (jaw > 0.02) { X.fillStyle = '#7a2a2a'; X.beginPath(); X.moveTo(-40, 30); X.lineTo(200, 30); X.lineTo(-40 + Math.cos(jaw * 0.55) * 240, 30 + Math.sin(jaw * 0.55) * 240); X.closePath(); X.fill(); }
  X.save(); X.translate(-40, 30); X.rotate(jaw * 0.55); rr(0, -6, 236, 52, 26, G); X.fillStyle = '#fff'; for (let q = 0; q < 6; q++) { X.beginPath(); X.moveTo(30 + q * 32, -4); X.lineTo(42 + q * 32, -22); X.lineTo(54 + q * 32, -4); X.fill(); } if (o.tongue > 0) { X.strokeStyle = '#ff7a9a'; X.lineWidth = 34; X.beginPath(); X.moveTo(60, -10); X.quadraticCurveTo(160 + o.tongue * 80, -30 - o.tongue * 40, 150 + o.tongue * 230, -10 - o.tongue * 140 + Math.sin(t * 18) * 14 * o.tongue); X.stroke(); } X.restore();
  rr(-70, -84, 284, 126, 58, G); X.fillStyle = GD; X.beginPath(); X.ellipse(40, -76, 120, 18, 0, Math.PI, 0); X.fill(); el(190, -54, 9, 6, GD); X.fillStyle = '#fff'; for (let q = 0; q < 6; q++) { X.beginPath(); X.moveTo(20 + q * 30, 36); X.lineTo(32 + q * 30, 56); X.lineTo(44 + q * 30, 36); X.fill(); }
  const blink = ((t + 0.7) % 3.3) < 0.12; if (o.hungry) { el(40, -36, 26, 24, '#ffd23f'); el(40, -36, 6, 20, '#1c1d24'); X.strokeStyle = GD; X.lineWidth = 14; X.beginPath(); X.moveTo(4, -70); X.lineTo(76, -52); X.stroke(); X.save(); X.shadowColor = '#ff3a2a'; X.shadowBlur = 30; el(40, -36, 8, 8, 'rgba(255,60,40,.6)'); X.restore(); }
  else { el(40, -36, 28, blink ? 4 : 28, '#fff'); if (!blink) { el(46, -32, 18, 18, '#1c1d24'); el(52, -40, 7, 7, '#fff'); } if (o.happy) { X.strokeStyle = '#1c1d24'; X.lineWidth = 7; X.beginPath(); X.arc(40, -26, 22, Math.PI * 1.15, Math.PI * 1.85); X.stroke(); } el(100, 8, 22, 12, 'rgba(255,120,140,.45)'); }
  X.restore(); X.restore(); return [x + H[0] * s, y + (H[1] + b) * s]; }
const headTo = (wx, wy) => [(wx - TX), (wy - TY)];
// ---------- food ----------
function coconut(x, y, s) { el(x, y, 22 * s, 21 * s, '#7a4a26'); el(x - 6 * s, y - 6 * s, 7 * s, 6 * s, 'rgba(255,255,255,.18)'); }
const PILE = [[-330, -112, 'f'], [-290, -116, 'c'], [-250, -112, 'f'], [-310, -146, 'c'], [-270, -150, 'f'], [-350, -150, 'c'], [-230, -146, 'c'], [-300, -182, 'f'], [-260, -186, 'c'], [-280, -216, 'f']];
function pile(n, t) { return () => { for (let q = 0; q < Math.min(n, PILE.length); q++) { const [px, py, k] = PILE[q]; if (k === 'f') { X.save(); X.translate(px, py); X.rotate(q * 0.7); fishShape(0, 0, 0.45, 0, true); X.restore(); } else coconut(px, py, 1); } }; }
// ---------- UI ----------
function calendar(day, t, t0, red, a = 1) { if (a <= 0 || t < t0) return; const f = cl((t - t0) / 0.25); X.save(); X.translate(540, 330); X.scale(1, Math.max(0.05, f)); X.globalAlpha = Math.min(1, a); X.shadowColor = 'rgba(0,0,0,.35)'; X.shadowBlur = 20; rr(-110, -120, 220, 230, 24, '#fff'); X.shadowColor = 'transparent'; rr(-110, -120, 220, 66, 24, red ? '#e02424' : '#2b4a7a'); rr(-110, -80, 220, 26, 0, red ? '#e02424' : '#2b4a7a'); X.font = '40px P'; X.textAlign = 'center'; X.fillStyle = '#fff'; X.fillText('DAY', 0, -70); X.font = '120px P'; X.fillStyle = red ? '#e02424' : '#1c1d24'; X.fillText(String(day), 0, 80); X.restore(); }
function card3(t, a, hl) { if (a <= 0) return; X.save(); X.globalAlpha = Math.min(1, a); const k = 0.82 + 0.06 * Math.min(1, a); X.translate(540, 1250); X.scale(k, k); rr(-470, -170, 940, 340, 40, '#ffffff'); el(-380, -90, 54, 54, '#f2c94c'); for (let q = 0; q < 6; q++) el(-380 + Math.cos(q) * 40, -120 + Math.sin(q * 2) * 10, 12, 10, ['#ff5a7a', '#5ac8ff', '#7fe08a', '#ffd23f', '#b18cff', '#ff8a2a'][q]); X.textAlign = 'left'; X.font = '40px P'; X.fillStyle = '#8a8f99'; X.fillText('@bob.the.seal8', -306, -96); X.font = '48px P'; X.fillStyle = INK; X.fillText('give him a t-Rex that eats any', -306, -28); X.fillStyle = hl ? '#e02424' : INK; X.fillText('and all food he has every', -306, 36); X.fillText('time 7 days', -306, 100); X.fillStyle = '#ff3b5c'; X.font = '40px P'; X.textAlign = 'right'; X.fillText('♥ 6', 440, -96); X.restore(); }
function hearts(t, t0, x, y) { const e = t - t0; if (e < 0 || e > 1.6) return; for (let q = 0; q < 5; q++) { const ph = cl(e / 1.6 - q * 0.08); txt('♥', x + Math.sin(q * 2 + e * 3) * 60 + (q - 2) * 40, y - ph * 220, 50 + q * 6, '#ff5a7a', 'center', Math.sin(ph * Math.PI)); } }
function windLines(t, t0, x0, y0, x1) { const e = t - t0; if (e < 0 || e > 1.0) return; X.strokeStyle = `rgba(200,240,190,${0.8 * (1 - e)})`; X.lineWidth = 8; for (let q = 0; q < 5; q++) { const xx = lerp(x0, x1, cl(e * 1.6 - q * 0.05)); X.beginPath(); X.moveTo(xx - 80, y0 - 60 + q * 30); X.lineTo(xx + 60, y0 - 60 + q * 30 + Math.sin(e * 20 + q) * 6); X.stroke(); } }
function redSky(a) { if (a <= 0) return; X.save(); X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = `rgba(150,20,20,${0.22 * a})`; X.fillRect(0, 0, W, H); X.restore(); }
// ---------- scene helpers ----------
function world(t, o = {}) { sky(t); island(t); palm(650, IY - 8, 1.0, t, o.coco !== false); }
function boat(t, o = {}) { const y = WL + Math.sin(t * 2) * 3 + (o.rock || 0), st = sternOf(YP, y), an = ANCHOR(); chain(an[0], an[1], st[0], st[1], 24, t); yacht(YP, y, 1, t, { name: 'STUPIDER8', rot: o.rot || 0, deck: () => { homeDeco(t, -9)(); pile(o.pile || 0, t)(); } }); if (!o.noGull) gullBird(YP + 250, y - 150, 1.0, t, { laugh: o.laugh }); if (o.laugh && !o.noGull) txt('HA HA', YP + 290, y - 270, 44, '#fff', 'center'); return y; }
function guyY(y) { return y + DECK; }
const L1 = t => t > ev('ha1') && t < ev('ha1') + 0.6, L2 = t => t > ev('ha2') && t < ev('ha2') + 0.6;
// ---------------- scenes ----------------
const SC = {
  d3_drop(t, u) { const td = ev('drop'), f = cl(t / td), e = t - td; const shake = e > 0 && e < 0.8 ? Math.sin(t * 60) * 14 * (1 - e / 0.8) : 0; X.translate(shake, shake * 0.6); cam(935, 960, 0.66); world(t); const yy = t < td ? lerp(-620, 0, f * f) : 0;
    if (t < td) { X.strokeStyle = 'rgba(255,255,255,.7)'; X.lineWidth = 10; for (let q = 0; q < 6; q++) { X.beginPath(); X.moveTo(TX - 250 + q * 100, TY - 760 + yy - (q % 2) * 50); X.lineTo(TX - 250 + q * 100, TY - 1000 + yy - (q % 2) * 50); X.stroke(); } }
    trex(TX, TY + yy, 1, t, { squash: pulse(t, td, 0.35), jaw: e > 0.45 && e < 1.7 ? Math.min(1, (e - 0.45) * 5) : 0, hungry: false, headRot: e > 0.45 && e < 1.7 ? -0.2 : 0, armWave: 0.6 }); if (e > 0) { drops(t, td, TX - 300, WL, 16); drops(t, td + 0.05, TX + 300, WL, 16); el(IX, WL + 10, 420 * Math.min(1, e * 4), 50 * Math.max(0, 1 - e), `rgba(255,255,255,${Math.max(0, 0.8 - e)})`); }
    const y = boat(t, { rock: e > 0 && e < 1.5 ? Math.sin(e * 12) * 14 * (1 - e / 1.5) : 0, rot: e > 0 && e < 1.5 ? Math.sin(e * 10) * 0.04 * (1 - e / 1.5) : 0 }); guy(GX, guyY(y) - (e > 0 && e < 0.4 ? Math.sin(e / 0.4 * Math.PI) * 60 : 0), GS, { hair: 'slick', eyes: 'wide', mouth: 'shock', look: -1, hl: [-110, -330], hr: [110, -330], sweat: e > 0 }, t); },
  d3_recap(t, u) { const t0 = seg('d3_recap').start, tc = ev('chained'), e = t - t0; X.save(); X.filter = 'sepia(0.85) brightness(1.05)';
    if (t < tc - 0.2) { const f = cl(e / 1.4); cam(600, 1010, 0.95); sky(t); whale(900, 1100 + cl((e - 1.2) / 1) * 260, 0.85, e < 0.3 ? 1 : cl(1 - (e - 0.3) / 0.3), t); island(t); palm(650, IY - 8, 1.0, t); if (f < 1) { const x = lerp(760, HX, f), y = lerp(990, HY, f) - Math.sin(Math.PI * f) * 560; X.save(); X.translate(x, y - 130); X.rotate(-f * 7); guy(0, 130, 0.62, { hair: 'slick', eyes: 'wide', mouth: 'shock', hl: [-110, -330], hr: [110, -330] }, t); X.restore(); } else guy(HX, HY, 0.62, { hair: 'slick', eyes: 'closed', mouth: 'o', hl: [-90, -120], hr: [90, -120] }, t); }
    else { cam(935, 1000, 0.66); world(t); const y = boat(t, {}); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'open', mouth: 'frown', look: -1, hl: [-60, -110], hr: [60, -110] }, t); }
    X.restore(); X.filter = 'none'; X.setTransform(1, 0, 0, 1, 0, 0); pill('◀◀ SO FAR', 200, 150, 'rgba(14,15,22,.85)', '#fff', 44); if (t > tc) stamp('FOREVER', 540, 380, -0.06, (t - tc) / 0.15, '#e02424', 100); },
  d3_card(t, u) { cam(935, 1150, 0.66); world(t); trex(TX, TY, 1, t, { head: [330, -430], armWave: 0.3 }); const y = boat(t, {}); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'wide', mouth: 'flat', look: -1, sweat: true, hl: [-60, -120], hr: [60, -120] }, t); X.setTransform(1, 0, 0, 1, 0, 0); card3(t, after(t, ev('card'), 0.3), false); },
  d3_read(t, u) { cam(935, 1150, 0.66); world(t); trex(TX, TY, 1, t, { head: [330, -430], armWave: 0.3 }); const y = boat(t, {}); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'wide', mouth: 'flat', look: -1, sweat: true, hl: [-60, -120], hr: [60, -120] }, t); X.setTransform(1, 0, 0, 1, 0, 0); card3(t, 1, t > ev('anyall')); },
  d3_scared(t, u) { const t0 = seg('d3_scared').start, e = t - t0; cam(lerp(880, 940, u), 880, lerp(0.85, 0.95, sm(u))); world(t); const hp = [lerp(330, 560, sm(cl(e / 1.2))), lerp(-430, -330, sm(cl(e / 1.2)))]; trex(TX, TY, 1, t, { head: hp, jaw: e < 0.6 ? Math.sin(e / 0.6 * Math.PI) * 0.7 : 0, armWave: 0.2 }); const y = boat(t, {}); guy(GX + 30, guyY(y), GS, { hair: 'slick', eyes: 'wide', mouth: 'shock', look: -1, sweat: true, hl: [-100, -330], hr: [100, -330], tilt: 0.12, bob: Math.sin(t * 40) * 2 }, t); },
  d3_lick(t, u) { const tl = ev('lick'), e = t - tl; cam(lerp(940, 980, u), 880, 0.95); world(t); const hp = [560 + Math.max(0, Math.sin(cl(e / 0.7) * Math.PI)) * 40, -330]; trex(TX, TY, 1, t, { head: hp, jaw: e > -0.1 && e < 0.8 ? Math.min(0.5, (e + 0.1) * 3) : 0, tongue: e > 0 && e < 0.8 ? Math.sin(e / 0.8 * Math.PI) : 0, happy: e > 0.8 }); const y = boat(t, { laugh: L1(t) }); guy(GX + 30, guyY(y), GS, { hair: 'slick', eyes: e > 0.4 ? 'closed' : 'wide', mouth: e > 0.4 ? 'frown' : 'shock', look: -1, sweat: false, hl: [-100, -330], hr: [100, -330], tilt: e > 0.3 ? 0.1 : 0.12 }, t); if (e > 0.4) for (let q = 0; q < 4; q++) { const ph = ((t * 0.8 + q / 4) % 1); el(GX + 30 - 40 + q * 26, guyY(y) - 330 * GS + 20 + ph * 70, 7, 11, `rgba(140,220,120,${0.9 * (1 - ph)})`); } },
  d3_friends(t, u) { const tf = ev('friends'); cam(900, 900, 0.9); world(t); trex(TX, TY, 1, t, { head: [450, -470], happy: true, armWave: 0.9, armSpeed: 9, wag: 2.5 }); const y = boat(t, {}); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'happy', mouth: 'grin', look: -1, hl: [-110, -330 + Math.sin(t * 9) * 30], hr: [100, -150] }, t); hearts(t, tf - 0.2, 960, 700); },
  d3_day1(t, u) { const c = ev('c1'), ts = ev('shark'), e = t - ts; cam(935, 980, 0.7); world(t); const fx = e < 0 ? lerp(1900, 1650, cl((t - c) / 1.0)) : 1650 + e * e * 900; fin(fx, WL + 120, t); trex(TX, TY, 1, t, { head: e > -0.1 && e < 0.9 ? [520, -470] : [450, -470], jaw: e > 0 && e < 0.8 ? Math.min(1, e * 5) : 0, headRot: e > 0 && e < 0.8 ? -0.15 : 0, happy: e > 1.0 }); const y = boat(t, {}); guy(GX, guyY(y), GS, { hair: 'slick', eyes: e > 0.5 ? 'happy' : 'wide', mouth: e > 0.5 ? 'grin' : 'shock', look: 1, hl: [-90, -130], hr: e > 0.5 ? [110, -330] : [90, -130] }, t); X.setTransform(1, 0, 0, 1, 0, 0); calendar(1, t, c, false); },
  d3_day4(t, u) { const c = ev('c4'), tc = ev('catch'), e = t - tc; cam(935, 980, 0.7); world(t); const dunk = e > -0.3 && e < 0.45, up = e >= 0.45, hp = dunk ? [700, 120] : up ? [lerp(700, 520, cl((e - 0.45) / 0.5)), lerp(120, -330, cl((e - 0.45) / 0.5))] : [450, -470]; const hd = trex(TX, TY, 1, t, { head: hp, happy: up, jaw: up ? 0.25 : 0 }); if (dunk) drops(t, tc - 0.25, 1100, WL, 10); if (up) fishInMouth(hd, t); const y = boat(t, { pile: 3 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: up ? 'happy' : 'open', mouth: up ? 'grin' : 'flat', look: -1, hl: [-90, -130], hr: [100, -200] }, t); X.setTransform(1, 0, 0, 1, 0, 0); calendar(4, t, c, false); },
  d3_arms(t, u) { const ta = ev('arms'); cam(lerp(860, 840, sm(u)), lerp(860, 820, sm(u)), lerp(0.95, 1.1, sm(u))); world(t); const hd = trex(TX, TY, 1, t, { head: [400, -400], happy: true, jaw: 0.25, armWave: 1.1, armSpeed: 16 }); fishInMouth(hd, t); const y = boat(t, { pile: 3 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'open', mouth: 'smile', look: -1, hl: [-150, -230], hr: [60, -130] }, t); if (t > ta) { X.save(); X.strokeStyle = '#e02424'; X.lineWidth = 6; X.setLineDash([18, 12]); X.beginPath(); X.moveTo(TX + 270, TY - 410); X.lineTo(GX - 150 * GS, guyY(y) - 230 * GS); X.stroke(); X.setLineDash([]); X.restore(); X.save(); X.setTransform(1, 0, 0, 1, 0, 0); stamp('TOO SHORT', 540, 330, -0.06, (t - ta) / 0.15, '#e02424', 84); X.restore(); } },
  d3_spit(t, u) { const ts = ev('spit'), tp = ev('splat'), e = t - ts; cam(940, 900, 0.95); world(t); const hd = trex(TX, TY, 1, t, { head: [540, -340], happy: e > 0.5, jaw: e > -0.1 && e < 0.3 ? 0.7 : 0.15, headRot: e > -0.1 && e < 0.3 ? -0.1 : 0 }); if (t < ts) fishInMouth(hd, t); const y = boat(t, { pile: t > tp + 0.4 ? 4 : 3, laugh: t > ev('ha1b') && t < ev('ha1b') + 0.7 }); const gy = guyY(y), face = [GX + 10, gy - 330 * GS];
    if (t >= ts && t < tp) { const f = (t - ts) / (tp - ts); X.save(); X.translate(lerp(hd[0] + 210, face[0], f), lerp(hd[1] + 30, face[1], f) - Math.sin(f * Math.PI) * 120); X.rotate(f * 9); fishShape(0, 0, 0.7, t, false); X.restore(); }
    const hit = t >= tp; guy(GX + (hit && t < tp + 0.3 ? 12 : 0), gy, GS, { hair: 'slick', eyes: hit ? 'closed' : 'wide', mouth: hit ? 'frown' : 'shock', look: -1, hl: [-60, -130], hr: [60, -130], tilt: hit && t < tp + 0.5 ? 0.15 : 0 }, t); if (hit && t < tp + 0.4) { X.save(); X.translate(face[0] - 10, face[1] + 10); X.rotate(0.3); fishShape(0, 0, 0.7, t, true); X.restore(); } if (hit && t >= tp + 0.4) for (let q = 0; q < 4; q++) { const ph = ((t * 0.9 + q / 4) % 1); el(face[0] - 30 + q * 20, face[1] + 10 + ph * 60, 6, 9, `rgba(180,210,230,${0.9 * (1 - ph)})`); }
    X.setTransform(1, 0, 0, 1, 0, 0); stamp('SPLAT', 540, 330, 0.08, (t - tp) / 0.12, '#2a8a3e', 96); },
  d3_day6(t, u) { const c = ev('c6'); cam(lerp(1000, 1060, u), 960, lerp(0.95, 1.05, sm(u))); world(t); trex(TX, TY, 1, t, { head: [450, -470], happy: true }); const n = Math.min(10, 4 + Math.floor(Math.max(0, t - c) / 0.25)); const y = boat(t, { pile: n }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'happy', mouth: 'grin', look: -1, hl: [-60, -160], hr: [60, -160], tilt: -0.05 }, t); X.setTransform(1, 0, 0, 1, 0, 0); calendar(6, t, c, false); },
  d3_day7(t, u) { const c = ev('c7'), ts = ev('seven'), e = t - ts; cam(lerp(980, 900, sm(u)), 920, lerp(1.0, 0.9, sm(u))); world(t); const turn = cl(e / 0.8); trex(TX, TY, 1, t, { head: [lerp(450, 520, turn), lerp(-470, -400, turn)], hungry: e > 0, armWave: 0.05, wag: 0.2, bob: e > 0 ? -turn * 10 : 0 }); const y = boat(t, { pile: 10 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: e > 0.5 ? 'wide' : 'happy', mouth: e > 0.5 ? 'flat' : 'grin', look: -1, sweat: e > 0.5, hl: [-60, -160], hr: [60, -160] }, t); redSky(cl(e / 0.6)); X.setTransform(1, 0, 0, 1, 0, 0); calendar(7, t, c, true); },
  d3_eat(t, u) { const te = ev('eat'), e = t - te; cam(960, 940, 1.0); world(t); const ch = Math.abs(Math.sin(t * 18)); trex(TX, TY, 1, t, { head: e > -0.2 ? [600, -170] : [520, -400], hungry: true, jaw: e > -0.1 ? ch * 0.8 : 0.3 }); const n = Math.max(3, 10 - Math.floor(Math.max(0, e) / 0.15)); const y = boat(t, { pile: n, rock: Math.sin(t * 30) * 3 }); guy(GX + 20, guyY(y), GS, { hair: 'slick', eyes: 'wide', mouth: 'shock', look: -1, sweat: true, hl: [-100, -330], hr: [100, -330], tilt: 0.1 }, t); scrapsFood(t, te, 1000, 1000); redSky(1); },
  d3_all(t, u) { const tf = wordT('d3_all', 'fish'), tc = wordT('d3_all', 'coconuts'), th = wordT('d3_all', 'hand'); cam(900, 900, 0.9); const ch = Math.abs(Math.sin(t * 18)); let hp, n = 3, coco = true, inHand = true; if (t < tc) { hp = [600, -170]; n = Math.max(0, 3 - Math.floor(Math.max(0, t - tf) / 0.2)); } else if (t < th) { hp = [300, -260]; n = 0; coco = t < tc + 0.4; } else { hp = [lerp(300, 760, cl((t - th) / 0.25)), lerp(-260, -230, cl((t - th) / 0.25))]; n = 0; coco = false; inHand = t < th + 0.3; }
    world(t, { coco }); trex(TX, TY, 1, t, { head: hp, hungry: true, jaw: ch * 0.75 }); const y = boat(t, { pile: n }); const gy = guyY(y); guy(GX, gy, GS, { hair: 'slick', eyes: 'wide', mouth: inHand ? 'flat' : 'shock', look: -1, sweat: true, hl: inHand ? [-110, -230] : [-110, -330], hr: [100, -330] }, t); if (inHand) { X.save(); X.translate(GX - 110 * GS - 10, gy - 230 * GS - 20); X.rotate(-0.6); fishShape(0, 0, 0.45, t, true); X.restore(); } redSky(1); },
  d3_gull(t, u) { const tg = ev('gull'), e = t - tg; cam(1080, 860, 0.85); world(t, { coco: false }); const reach = cl((e + 0.4) / 0.4); trex(TX, TY, 1, t, { head: [lerp(500, 1160, reach) - (e > 0.25 ? (e - 0.25) * 300 : 0), lerp(-330, -320, reach)], hungry: true, jaw: e > -0.1 && e < 0.3 ? 0.8 : 0.1 }); const y = boat(t, { pile: 0, noGull: e > 0.05 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'wide', mouth: 'shock', look: 1, hl: [-100, -330], hr: [100, -330] }, t);
    if (e > 0.05) { const fx = YP + 250 - (e - 0.05) * 320, fy = y - 150 - (e - 0.05) * 330 + Math.sin(e * 3) * 20; gullFly(fx, fy, t); if (t > ev('ha2') && t < ev('ha2') + 0.7) txt('HA HA', fx + 30, fy - 90, 44, '#fff', 'center'); for (let q = 0; q < 6; q++) { const ph = e * 0.8 + q * 0.1; if (ph < 1.2) el(YP + 250 + Math.sin(q * 3) * 50, y - 160 + ph * 140, 10, 5, '#fff', q); } } redSky(cl(1 - e / 1.5)); },
  d3_burp(t, u) { const tb = ev('burp'), e = t - tb; cam(940, 920, 0.95); world(t, { coco: false }); trex(TX, TY, 1, t, { head: [560, -380], jaw: e > 0 && e < 0.9 ? 0.9 : 0, headRot: e > 0 && e < 0.9 ? -0.1 : 0 }); windLines(t, tb, 900, 940, 1350); const y = boat(t, { pile: 0, noGull: true }); guy(GX + (e > 0 && e < 0.9 ? 14 : 0), guyY(y), GS, { hair: 'slick', eyes: e > 0 && e < 0.9 ? 'closed' : 'open', mouth: e > 0 && e < 0.9 ? 'frown' : 'flat', look: -1, hl: [-60, -120], hr: [60, -120], tilt: e > 0 && e < 0.9 ? 0.18 : 0 }, t); },
  d3_look(t, u) { const tl = ev('look'), e = t - tl; cam(lerp(1000, 1070, sm(u)), lerp(850, 820, sm(u)), lerp(1.2, 1.6, sm(u))); world(t, { coco: false }); trex(TX, TY, 1, t, { head: [lerp(520, 600, sm(cl(e / 0.8))), -310], hungry: true, tongue: t > ev('smack') && t < ev('smack') + 0.4 ? 0.25 : 0, jaw: t > ev('smack') && t < ev('smack') + 0.4 ? 0.3 : 0 }); const y = boat(t, { pile: 0 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'wide', mouth: 'flat', look: -1, sweat: true, hl: [-60, -120], hr: [60, -120], bob: Math.sin(t * 40) * 1.5 }, t); redSky(0.5 * cl(e / 0.5)); },
  d3_hug(t, u) { const th = ev('hug'), e = t - th; cam(lerp(1040, 980, sm(u)), 850, lerp(1.4, 1.2, sm(u))); world(t, { coco: false }); const hd = trex(TX, TY, 1, t, { head: [lerp(600, 640, sm(cl(e / 0.5))), lerp(-310, -260, sm(cl(e / 0.5)))], happy: e > -0.2, armWave: 1.2, armSpeed: 14, wag: 3 }); const y = boat(t, { pile: 0 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: e > 0.4 ? 'happy' : 'wide', mouth: e > 0.4 ? 'grin' : 'flat', look: -1, hl: [-120, -260], hr: [100, -200] }, t); hearts(t, th + 0.1, GX - 120, guyY(y) - 300); if (e > 0.4) { X.save(); X.strokeStyle = '#e02424'; X.lineWidth = 6; X.setLineDash([18, 12]); X.beginPath(); X.moveTo(TX + 270, TY - 410); X.lineTo(GX - 120 * GS, guyY(y) - 260 * GS); X.stroke(); X.setLineDash([]); X.restore(); } },
  d3_ask(t, u) { cam(935, 960, 0.7); world(t, { coco: false }); trex(TX, TY, 1, t, { head: [450, -470], happy: true, armWave: 0.6 }); const y = boat(t, { pile: 0 }); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'happy', mouth: 'grin', look: 0, hl: [-110, -330 + Math.sin(t * 9) * 30], hr: [100, -150] }, t); X.setTransform(1, 0, 0, 1, 0, 0); pill('DAY 4 IS UP TO YOU', 540, 1290, '#ffd23f', INK, 64, after(t, seg('d3_ask').start + 0.1, 0.3)); },
  d3_ideas(t, u) { ideasScene(t, 1); },
  d3_end(t, u) { ideasScene(t, 2); },
};
function fishInMouth(hd, t) { X.save(); X.translate(hd[0] + 210, hd[1] + 40); X.rotate(Math.sin(t * 16) * 0.25); fishShape(0, 0, 0.7, t, false); X.restore(); }
function gullFly(x, y, t) { const w = Math.sin(t * 16) * 0.8; X.save(); X.translate(x, y); el(0, 0, 40, 22, '#fff'); el(34, -10, 18, 16, '#fff'); X.fillStyle = '#ffb02a'; X.beginPath(); X.moveTo(48, -10); X.lineTo(70, -6); X.lineTo(48, -2); X.fill(); el(38, -14, 4, 4, INK); for (const sd of [-1, 1]) { X.save(); X.rotate(-0.2); X.scale(1, sd); X.rotate(w * sd * -1); X.fillStyle = '#c8ccd4'; X.beginPath(); X.moveTo(-10, -6); X.quadraticCurveTo(-30, -60, -70, -50); X.quadraticCurveTo(-30, -20, -10, -6); X.fill(); X.restore(); } X.restore(); }
function ghost(a, fn) { if (a <= 0) return; X.save(); X.globalAlpha = 0.6 * Math.min(1, a); fn(); X.restore(); }
function jetpack(x, y, t) { rr(x - 70, y - 190, 40, 120, 18, '#9aa4ad'); rr(x - 26, y - 190, 40, 120, 18, '#9aa4ad'); for (const dx of [-50, -6]) { X.fillStyle = '#ff8a2a'; X.beginPath(); X.moveTo(x + dx - 14, y - 70); X.lineTo(x + dx + 14, y - 70); X.lineTo(x + dx, y - 70 + 50 + Math.sin(t * 30 + dx) * 12); X.fill(); } }
function ideasScene(t, mode) { const tj = ev('jet'), tg = ev('gran'), tr = ev('rex2'), t0 = seg('d3_ideas').start; cam(860, 900, 0.82); world(t, { coco: false }); ghost(after(t, tr, 0.3), () => trex(190, TY + 20, 0.6, t, { happy: true, armWave: 1, armSpeed: 10 })); trex(TX, TY, 1, t, { head: [450, -470], happy: true, armWave: 0.6 }); ghost(after(t, tg, 0.3), () => { const old = HAIRC.bun; HAIRC.bun = '#d9d9d9'; guy(800, IY + 6, 0.7, { hair: 'bun', glasses: true, shirt: '#c06aa8', eyes: 'happy', mouth: 'smile', hl: [-60, -140], hr: [80, -300 + Math.sin(t * 8) * 20] }, t); HAIRC.bun = old; }); const y = boat(t, { pile: 0 }); ghost(after(t, tj, 0.3), () => jetpack(GX, guyY(y) - 20, t)); guy(GX, guyY(y), GS, { hair: 'slick', eyes: 'happy', mouth: 'grin', look: 0, hl: [-110, -330], hr: [110, -330] }, t);
  for (const [tt, x, yy] of [[tj, GX + 60, guyY(y) - 300], [tg, 800, IY - 400], [tr, 190, TY - 470]]) if (t > tt) txt('?', x, yy - ((t - tt) * 20) % 30, 70, '#fff', 'center', Math.min(1, (t - tt) * 4));
  X.setTransform(1, 0, 0, 1, 0, 0); if (mode === 2) { const e0 = seg('d3_end').start; pill('COMMENT ANYTHING', 540, 1270, '#ffd23f', INK, 70, after(t, e0, 0.3)); pill('TOP COMMENT GETS BUILT', 540, 1400, 'rgba(14,15,22,.88)', '#fff', 50, after(t, ev('word'), 0.3)); } }
function scrapsFood(t, t0, x, y) { const e = t - t0; if (e < 0) return; for (let q = 0; q < 12; q++) { const ph = (e * 1.3 + q / 12) % 1; el(x + Math.cos(q * 2.4) * ph * 160, y - ph * 120 + ph * ph * 260, 8, 6, q % 2 ? '#c9783a' : '#7a4a26'); } }
