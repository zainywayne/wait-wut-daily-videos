function hookArt(t, chew) { home(t); const s = 1.55, dx = 560, dy = FLOOR + 40, m = dogMouth(dx, dy, s); dog(dx, dy, s, { mouth: 'chomp', eyes: 'happy', wag: 16, bob: Math.sin(t * 15) * 4 }, t); homework(m[0] + 10, m[1] + 18 + Math.sin(t * 15) * 6, 300, 380, 0.16 + Math.sin(t * 15) * 0.04, chew, t); scraps(t, -0.5 + Math.floor(t / 0.6) * 0.6, m[0] + 40, m[1] + 30, 10, 0.9); }
