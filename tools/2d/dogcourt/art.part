// captions: 2-3 word chunks, bold, lower third
function chunks(words) { const out = []; let cur = []; for (const w of words) { cur.push(w); const len = cur.reduce((a, c) => a + c[0].length + 1, 0); if (cur.length >= 3 || len > 13 || /[.,?!]$/.test(w[0])) { out.push(cur); cur = []; } } if (cur.length) out.push(cur); return out; }
let CH = null;
window.frame = (t) => {
  if (!T) return; if (!CH) CH = T.segs.map(s => chunks(s.words || [])); const sh = shotAt(t), n = sh.name === 'end' ? 'd_loop' : sh.name, u = sh.name === 'end' ? 1 : sh.u;
  let s = 0; for (const [k, d, m] of [['slam', 0.3, 16], ['dism', 0.3, 14], ['ng1', 0.25, 12], ['ng2', 0.25, 12], ['sue', 0.4, 18], ['bark1', 0.3, 16], ['bark2', 0.3, 18], ['stack', 0.45, 22], ['gulp', 0.2, 8]]) { const e = t - ev(k); if (e >= 0 && e < d) s = Math.max(s, (1 - e / d) * m); } if (n === 'd_hook') s = Math.max(s, 4); if (n === 'd_q') s = Math.max(s, 1.5 * sh.u);
  X.setTransform(1, 0, 0, 1, 0, 0); X.fillStyle = '#000'; X.fillRect(0, 0, W, H); X.save(); X.translate(Math.sin(t * 91) * s, Math.cos(t * 77) * s); SC[n](t, u); X.restore(); X.setTransform(1, 0, 0, 1, 0, 0);
  const vg = X.createRadialGradient(540, 960, 560, 540, 960, 1250); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.42)'); X.fillStyle = vg; X.fillRect(0, 0, W, H);
  const tEnd = seg('d_prove').start + seg('d_prove').dur; if (t < tEnd) { const a = cl((tEnd - t) / 0.3); X.save(); X.globalAlpha = a; X.font = '76px P'; X.textAlign = 'center'; const tw = X.measureText('THIS ENDS IN COURT').width; rr(540 - tw / 2 - 34, 168, tw + 68, 112, 24, 'rgba(14,15,22,.88)'); X.fillStyle = '#ffd23f'; X.fillText('THIS ENDS IN COURT', 540, 250); X.restore(); }
  const i = Math.min(sh.i, T.segs.length - 2), list = CH[i]; let cur = null; for (const c of list) if (t >= c[0][1]) cur = c; if (sh.name === 'end') cur = list[list.length - 1]; else if (!cur) cur = list[0]; if (cur) { const pop = 1 + 0.16 * Math.exp(-Math.max(0, t - cur[0][1]) * 14); X.save(); X.translate(540, 1560); X.scale(pop, pop); X.font = '92px P'; X.textAlign = 'left'; const ws = cur.map(c => c[0].replace(/[.,?]/g, '').toUpperCase()), wd = ws.map(w => X.measureText(w + ' ').width), tot = wd.reduce((a, b) => a + b, 0) - X.measureText(' ').width; let x = -tot / 2; X.lineJoin = 'round';
    ws.forEach((w, k) => { const on = t >= cur[k][1] && (k === cur.length - 1 || t < cur[k + 1][1]); X.lineWidth = 20; X.strokeStyle = '#14151c'; X.strokeText(w, x, 0); X.fillStyle = on ? '#ffffff' : '#ffd23f'; X.fillText(w, x, 0); x += wd[k]; }); X.restore(); }
};
