  for (const sd of [-1, 1]) { X.save(); X.translate(sd * 84, -34); X.rotate(sd * (0.22 + Math.sin(t * 3 + sd) * 0.05) - sd * (o.earUp || 0) * 0.9); el(0, 52, 30, 64, EAR); X.restore(); }
